@inherits LayoutComponentBase
@inject PlantService PlantService
@inject NavigationManager Nav

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex align-items-center">

            <a href="/plantinformation" class="ms-3">
                <i class="bi bi-journal-bookmark-fill me-1"></i> Plant Information
            </a>

            <a href="/journalentries/create" class="ms-3">
                <i class="bi bi-plus-square-fill me-1"></i> Add Journal Entry
            </a>

            <!-- SEARCH BAR WITH SMART SUGGESTIONS -->
            <div class="ms-auto position-relative" style="width: 260px;">
                <input class="form-control"
                       placeholder="Search plants..."
                       value="@searchText"
                       @oninput="OnInputChanged"
                       @onfocus="ShowSuggestions"
                       @onblur="HideSuggestionsDelayed" />

                @if (showSuggestions && filteredPlants?.Any() == true)
                {
                    <div class="list-group position-absolute w-100 shadow-sm" style="z-index: 1000;">
                        @foreach (var p in filteredPlants)
                        {
                            <button class="list-group-item list-group-item-action"
                                    @onclick="() => SelectPlant(p.PlantId)">
                                @p.CommonName (@p.ScientificName)
                            </button>
                        }
                    </div>
                }
            </div>

        </div>

        <article class="content px-4">
            @Body
        </article>

    </main>
</div>

@code {
    private string? searchText;
    private bool showSuggestions = false;

    private List<PlantWithInfoDto>? allPlants;
    private List<PlantWithInfoDto>? filteredPlants;

    protected override async Task OnInitializedAsync()
    {
        allPlants = await PlantService.GetAllPlants();

        // Sort alphabetically by CommonName or fallback to Name
        allPlants = allPlants
            .OrderBy(p => p.CommonName ?? p.Name)
            .ToList();
    }

    private void ShowSuggestions() => showSuggestions = true;

    private async Task UpdateSuggestions()
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredPlants = allPlants!.Take(10).ToList();
            showSuggestions = true;
            return;
        }

        string q = searchText.Trim().ToLower();

        filteredPlants = allPlants!
            .Select(p => new
            {
                Plant = p,
                Score =
                    (p.CommonName?.ToLower().StartsWith(q) == true ? 100 : 0) +
                    (p.CommonName?.ToLower().Contains(q) == true ? 60 : 0) +
                    (p.ScientificName?.ToLower().StartsWith(q) == true ? 80 : 0) +
                    (p.ScientificName?.ToLower().Contains(q) == true ? 40 : 0) +
                    (p.Name?.ToLower().Contains(q) == true ? 20 : 0) +
                    FuzzyScore(p.CommonName?.ToLower() ?? "", q)
            })
            .OrderByDescending(x => x.Score)
            .ThenBy(x => x.Plant.CommonName ?? x.Plant.Name)
            .Take(10)
            .Select(x => x.Plant)
            .ToList();

        showSuggestions = true;
    }

    private async Task HideSuggestionsDelayed()
    {
        await Task.Delay(200);
        showSuggestions = false;
    }

    private void SelectPlant(int plantId)
    {
        showSuggestions = false;
        searchText = "";
        Nav.NavigateTo($"/plants?plantId={plantId}");
    }

    private int FuzzyScore(string text, string query)
    {
        if (string.IsNullOrWhiteSpace(text) || string.IsNullOrWhiteSpace(query))
            return 0;

        int score = 0;

        if (text.Contains(query[0]))
            score += 10;

        if (query.Length > 1 && text.Contains(query.Substring(0, 2)))
            score += 20;

        return score;
    }

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString();
        await UpdateSuggestions();
    }
}
