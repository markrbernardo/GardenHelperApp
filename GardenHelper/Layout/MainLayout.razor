@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">

            <a href="/dashboard">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>

            <a href="/plantinformation" class="ms-3">
                <i class="bi bi-journal-bookmark-fill me-1"></i> Plant Information
            </a>

            <a href="/observations/create" class="ms-3">
