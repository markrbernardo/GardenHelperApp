@inject UserSessionService Session
@inject GardenService GardenService
@inject LocationService LocationService
@inject NavigationManager Nav

<div class="top-row navbar navbar-dark">
    <div class="container-fluid" id="logo">
        <a class="navbar-brand" href="/home">
            <i class="bi bi-flower1 me-2"></i>Garden Helper
        </a>

        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

@if (Session.CurrentUserId != null)
{
    <!-- NOTE: 'collapse' is always present; 'show' is toggled via @NavMenuCssClass -->
    <div class="collapse nav-scrollable nav-container @NavMenuCssClass">
        <nav class="nav d-flex flex-column">

            <span class="nav-header px-3 mt-3 text-white">Gardener:</span>
            <span class="text-white px-3">@Session.CurrentUserName</span>

            <!-- PLANT INFORMATION HEADER -->
            <div class="nav-section px-3 mt-3" @onclick="TogglePlantInfo" style="cursor:pointer;">
                <span class="nav-header">Plant Information</span>
                <span class="float-end">@((PlantInfoOpen ? "▼" : "►"))</span>
            </div>

            @if (PlantInfoOpen)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/plantinformation">
                        <span class="bi bi-list-nested-nav-menu"></span>
                        Plant Information
                    </NavLink>
                </div>
            }



            <!-- GARDEN HEADER -->
            <div class="nav-section px-3 mt-3" @onclick="ToggleGarden" style="cursor:pointer;">
                <span class="nav-header">Garden</span>
                <span class="float-end">@((GardenOpen ? "▼" : "►"))</span>
            </div>

            @if (GardenOpen)
            {
                @if (gardens == null)
                {
                    <div class="nav-item px-3">Loading...</div>
                }
                else if (gardens.Count == 0)
                {
                    <div class="nav-item px-3">No gardens</div>
                }
                else
                {
                    <!-- GARDEN LINKS -->
                    @foreach (var g in gardens.OrderBy(g => g.Name))
                    {
                        <div class="nav-item px-3">
                            <NavLink class="@($"nav-link {(SelectedGardenId == g.GardenId ? "active" : "")}")"
                                     href="@($"/garden-profile/{g.GardenId}")"
                                     @onclick="() => SelectGarden(g.GardenId)">
                                <span class="bi bi-list-nested-nav-menu"></span>
                                @g.Name
                            </NavLink>
                        </div>
                    }
                }
            }


            <!-- LOCATIONS HEADER -->
            @if (SelectedGardenId > 0)
            {
                <div class="nav-section px-3 mt-3" @onclick="ToggleLocations" style="cursor:pointer;">
                    <span class="nav-header">Locations</span>
                    <span class="float-end">@((LocationsOpen ? "▼" : "►"))</span>
                </div>

                <!-- LOCATIONS LIST -->
                @if (LocationsOpen)
                {
                    @if (locations == null)
                    {
                        <div class="nav-item px-3">Loading...</div>
                    }
                    else if (!locations.Any(l => l.GardenId == SelectedGardenId))
                    {
                        <div class="nav-item px-3">No locations</div>
                    }
                    else
                    {
                        @foreach (var loc in locations
                                .Where(l => l.GardenId == SelectedGardenId)
                                .OrderBy(l => l.Name))
                        {
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="@($"/location-profile/{loc.LocationId}")">
                                    <span class="bi bi-list-nested-nav-menu"></span>
                                    @loc.Name
                                </NavLink>
                            </div>
                        }


                        <!-- PLANTS HEADER -->
                        <div class="nav-section px-3 mt-3" @onclick="TogglePlants" style="cursor:pointer;">
                            <span class="nav-header">Plants</span>
                            <span class="float-end">@((PlantsOpen ? "▼" : "►"))</span>
                        </div>

                        @if (PlantsOpen)
                        {
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="/plants">
                                    <span class="bi bi-list-nested-nav-menu"></span>
                                    Plant Inventory
                                </NavLink>
                            </div>
                        }
                    }
                }
            }

            <!-- OBSERVATIONS HEADER -->
            <div class="nav-section px-3 mt-3" @onclick="ToggleObservations" style="cursor:pointer;">
                <span class="nav-header">Observations</span>
                <span class="float-end">@((ObservationsOpen ? "▼" : "►"))</span>
            </div>

            @if (ObservationsOpen)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/observations">
                        <span class="bi bi-list-nested-nav-menu"></span>
                        Observations
                    </NavLink>
                </div>

            }

            <!-- JOURNAL HEADER -->
            <div class="nav-section px-3 mt-3" @onclick="ToggleJournal" style="cursor:pointer;">
                <span class="nav-header">Journal</span>
                <span class="float-end">@((JournalOpen ? "▼" : "►"))</span>
            </div>

            @if (JournalOpen)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/journalentries">
                        <span class="bi bi-list-nested-nav-menu"></span>
                        Journal Entries
                    </NavLink>
                </div>

            }

                <hr class="nav-divider" />

                <!-- ACCOUNT SETTINGS -->
                <div class="nav-item mt-2">
                    <NavLink class="nav-link" href="/user-profile">
                        <span class="bi bi-gear-fill mb-4"></span>
                        Account Settings
                    </NavLink>
                </div>

                <!-- SIGN OUT -->
                <div class="nav-item mt-2">
                    <button class="nav-link text-white-50" @onclick="SignOut">
                        <span class="bi bi-box-arrow-right"></span>
                        Sign Out
                    </button>
                </div>

        </nav>
    </div>
}

@code {
    List<LocationModel>? locations;
    List<GardenModel>? gardens;

    bool PlantInfoOpen = true;
    bool GardenOpen = true;
    bool LocationsOpen = true;
    bool PlantsOpen = true;
    bool ObservationsOpen = true;
    bool JournalOpen = true;

    void ToggleGarden() => GardenOpen = !GardenOpen;
    void TogglePlantInfo() => PlantInfoOpen = !PlantInfoOpen;
    void ToggleLocations() => LocationsOpen = !LocationsOpen;
    void TogglePlants() => PlantsOpen = !PlantsOpen;
    void ToggleObservations() => ObservationsOpen = !ObservationsOpen;
    void ToggleJournal() => JournalOpen = !JournalOpen;

    private int SelectedGardenId
    {
        get => Session.CurrentGardenId ?? 0;
        set => Session.SetGarden(value);
    }

    protected override void OnInitialized()
    {
        Session.OnChange += async () =>
        {
            await LoadGardens();
            await LoadLocations();
            StateHasChanged();
        };
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadGardens();
        await LoadLocations();
    }

    private async Task LoadGardens()
    {
        if (Session.CurrentUserId != null)
        {
            gardens = (await GardenService.GetGardensByUser(Session.CurrentUserId.Value))
                .OrderBy(g => g.Name)
                .ToList();

            if ((Session.CurrentGardenId == null || Session.CurrentGardenId == 0) && gardens.Any())
            {
                var defaultGardenId = await GardenService.GetDefaultGardenId(Session.CurrentUserId.Value);

                if (defaultGardenId != null && gardens.Any(g => g.GardenId == defaultGardenId))
                    await Session.SetGarden(defaultGardenId.Value);
                else
                    await Session.SetGarden(gardens.First().GardenId);
            }
        }
        else
        {
            gardens = null;
        }
    }

    private async Task LoadLocations()
    {
        if (SelectedGardenId <= 0)
        {
            locations = new List<LocationModel>();
            return;
        }

        locations = await LocationService.GetLocationsByGarden(SelectedGardenId);
    }

    // Now using Bootstrap-style: 'collapse' always present, 'show' toggled
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "show" : null;

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private async Task SignOut()
    {
        await Session.Clear();
        gardens = new List<GardenModel>();
        locations = new List<LocationModel>();
        SelectedGardenId = 0;
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private void SelectGarden(int id)
    {
        SelectedGardenId = id;
        Nav.NavigateTo($"/garden-profile/{id}");
    }
}
