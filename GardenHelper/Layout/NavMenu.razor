@inject UserSessionService Session
@inject GardenService GardenService
@inject LocationService LocationService
@inject NavigationManager Nav

<!-- TOP BAR -->
<div class="top-row navbar navbar-dark">
    <div class="container-fluid" id="logo">
        <a class="navbar-brand d-flex align-items-center ps-2" href="/home">
            <i class="bi bi-flower1 mb-3"></i>
            Garden Helper
        </a>

        <button title="Navigation menu"
                class="navbar-toggler"
                @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

@if (Session.CurrentUserId != null)
{
    <div class="collapse nav-scrollable nav-container @NavMenuCssClass">
        <nav class="nav flex-column">

            <!-- USER -->
            <div class="d-flex align-items-center px-3 mt-3">
                <span class="nav-header text-white me-2">Gardener:</span>

                <div class="px-3 card text-black m-0 flex-grow-1 text-center">
                    @Session.CurrentUserName
                </div>
            </div>

            <hr class="nav-divider" />

            <!-- ----------------------------- -->
            <!-- GARDEN DROPDOWN (NO COLLAPSE) -->
            <!-- ----------------------------- -->
            @if (gardens == null)
            {
                @NavText("Loading...")
            }
            else if (gardens.Count == 0)
            {
                @NavText("No gardens")
            }
            else if (gardens.Count == 1)
            {
                <!-- Single garden: show as plain text -->
                <div class="nav-section px-3 mt-3">
                    <span class="nav-header">Garden</span>
                </div>

                <div class="nav-item px-3 active">
                    <a class="nav-link" href="/garden-profile/@gardens[0].GardenId">
                        @gardens[0].Name
                    </a>
                </div>
            }
            else
            {
                <!-- Multiple gardens: show dropdown -->
                <div class="nav-section px-3 mt-2 mb-3">
                    <span class="nav-header text-decoration-underline">Garden Related</span>
                </div>

                <div class="px-3">
                    <select class="form-select py-1"
                            @onchange="OnGardenDropdownChange"
                            style="background-color: #fff;">
                        @foreach (var g in gardens.OrderBy(g => g.Name))
                        {
                            <option class="text-center" value="@g.GardenId"
                                    selected="@(SelectedGardenId == g.GardenId)">
                                @g.Name
                            </option>
                        }
                    </select>
                </div>
            }


            <!-- ----------------------------- -->
            <!-- COLLAPSIBLE: LOCATIONS        -->
            <!-- ----------------------------- -->
            @if (SelectedGardenId > 0)
            {
                @SectionHeader("Locations", LocationsOpen, ToggleLocations)

                @if (LocationsOpen)
                {
                    if (locations == null)
                    {
                        @NavText("Loading...")
                    }
                    else if (!locations.Any(l => l.GardenId == SelectedGardenId))
                    {
                        @NavText("No locations")
                    }
                    else
                    {
                        @foreach (var loc in locations
                            .Where(l => l.GardenId == SelectedGardenId)
                            .OrderBy(l => l.Name))
                        {
                            <div class="nav-item m-auto">
                                <a class="nav-link" href="/location-profile/@loc.LocationId">@loc.Name</a>
                            </div>
                        }
                    }
                }
            }

            <!-- ----------------------------- -->
            <!-- STATIC: JOURNAL               -->
            <!-- ----------------------------- -->
            <div class="nav-item px-3">
                <a class="nav-link" href="/journalentries">
                    <i class="bi bi-journal-text mb-4 me-2"></i>
                    Journal Entries
                </a>
            </div>

            <hr class="nav-divider" />
            
            <div class="nav-section px-3 mt-2 mb-1">
                <span class="nav-header text-decoration-underline">Plant Related</span>
            </div>
            <!-- ----------------------------- -->
            <!-- STATIC: PLANTS                -->
            <!-- ----------------------------- -->
            <div class="nav-item px-3">
                <a class="nav-link" href="/plants">
                    <i class="bi bi-list-ul mb-4 me-2"></i>
                    Plant Inventory
                </a>
            </div>

            <!-- ----------------------------- -->
            <!-- STATIC: OBSERVATIONS          -->
            <!-- ----------------------------- -->
            <div class="nav-item px-3">
                <a class="nav-link" href="/observations">
                    <i class="bi bi-eye mb-4 me-2"></i>
                    Observations
                </a>
            </div>

            <!-- ----------------------------- -->
            <!-- STATIC: PLANT INFORMATION     -->
            <!-- ----------------------------- -->
            <div class="nav-item px-3 pb-0 pt-3">
                <a class="nav-link" href="/plantinformation">
                    <i class="bi bi-info-circle mb-4 me-2"></i>
                    Plant Information
                </a>
            </div>

            <hr class="nav-divider" />

            <!-- ACCOUNT SETTINGS -->
            <div class="nav-item pt-3 px-3">
                <a class="nav-link" href="/user-profile">
                    <i class="bi bi-gear-fill mb-4 me-2"></i> Account Settings
                </a>
            </div>

            <!-- SIGN OUT -->
            <div class="nav-item mt-2 px-3">
                <button class="nav-link text-white-50" @onclick="SignOut">
                    <span class="bi bi-box-arrow-right"></span>
                    Sign Out
                </button>
            </div>

        </nav>
    </div>
}

@code {
    List<LocationModel>? locations;
    List<GardenModel>? gardens;

    bool GardenOpen = true;
    bool LocationsOpen = true;

    void ToggleGarden() => GardenOpen = !GardenOpen;
    void ToggleLocations() => LocationsOpen = !LocationsOpen;

    private void OnGardenDropdownChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            SelectedGardenId = id;
            Nav.NavigateTo($"/garden-profile/{id}");
        }
    }


    private int SelectedGardenId
    {
        get => Session.CurrentGardenId ?? 0;
        set => Session.SetGardenAsync(value);
    }

    protected override void OnInitialized()
    {
        _sessionHandler = async () =>
        {
            await LoadGardens();
            await LoadLocations();
            StateHasChanged();
        };

        Session.OnChange += _sessionHandler;
    }


    protected override async Task OnParametersSetAsync()
    {
        await LoadGardens();
        await LoadLocations();
    }

    private async Task LoadGardens()
    {
        if (Session.CurrentUserId != null)
        {
            gardens = (await GardenService.GetByUserAsync(Session.CurrentUserId.Value))
                .OrderBy(g => g.Name)
                .ToList();

            if ((Session.CurrentGardenId == null || Session.CurrentGardenId == 0) && gardens.Any())
            {
                var defaultGardenId = await GardenService.GetDefaultGardenAsync(Session.CurrentUserId.Value);

                if (defaultGardenId != null && gardens.Any(g => g.GardenId == defaultGardenId))
                    await Session.SetGardenAsync(defaultGardenId.Value);
                else
                    await Session.SetGardenAsync(gardens.First().GardenId);
            }
        }
        else
        {
            gardens = null;
        }
    }

    private async Task LoadLocations()
    {
        if (SelectedGardenId <= 0)
        {
            locations = new();
            return;
        }

        locations = await LocationService.GetByGardenAsync(SelectedGardenId);
    }

    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "show" : null;
    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private Func<Task>? _sessionHandler;


    private async Task SignOut()
    {
        if (_sessionHandler != null)
            Session.OnChange -= _sessionHandler;

        await Session.ClearAsync();
        gardens = new();
        locations = new();
        SelectedGardenId = 0;

        Nav.NavigateTo("/login", forceLoad: true);
    }



    private void SelectGarden(int id)
    {
        SelectedGardenId = id;
        Nav.NavigateTo($"/garden-profile/{id}");
    }

    // ---------- REUSABLE RENDER HELPERS ----------

    RenderFragment SectionHeader(string title, bool open, Action toggle) => __builder =>
    {
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "class", "nav-section px-3 mt-3");
        __builder.AddAttribute(2, "style", "cursor:pointer;");
        __builder.AddAttribute(3, "onclick", EventCallback.Factory.Create(this, toggle));
        __builder.AddContent(4, (MarkupString)$"<span class='nav-header'>{title}</span>");
        __builder.AddContent(5, (MarkupString)$"<span class='float-end'>{(open ? "▼" : "►")}</span>");
        __builder.CloseElement();
    };

    RenderFragment NavText(string text) => __builder =>
    {
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "class", "nav-item px-3");
        __builder.AddContent(2, text);
        __builder.CloseElement();
    };
}
