@inject UserSessionService Session
@inject GardenService GardenService
@inject LocationService LocationService
@inject NavigationManager Nav

<div class="top-row navbar navbar-dark">
    <div class="container-fluid" id="logo">
        <a class="navbar-brand" href="">Garden Helper</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

@if (Session.CurrentUserId != null)
{
    <div class="@NavMenuCssClass nav-scrollable nav-container">
        <nav class="nav flex-column">

            <!-- HOME -->
            <div class="nav-item px-3 mt-2">
                <NavLink class="nav-link" href="/home">
                    <span class="bi bi-house-door-fill-nav-menu"></span>
                    Home (@Session.CurrentUserName)
                </NavLink>
            </div>

            <!-- GARDENS -->
            <div class="nav-section px-3 mt-3">
                <span class="nav-header">Gardens</span>
            </div>

            @if (gardens == null)
            {
                <div class="nav-item px-3">Loading...</div>
            }
            else if (gardens.Count == 0)
            {
                <div class="nav-item px-3">No gardens</div>
            }
            else
            {
                @foreach (var g in gardens)
                {
                    <!-- Garden Link -->
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="@($"/plants?gardenId={g.GardenId}")"
                                 @onclick="() => SelectGarden(g.GardenId)">
                            <span class="bi bi-list-nested-nav-menu"></span>
                            @g.Name
                        </NavLink>
                    </div>
                    }
                }
            }

            <!-- LOCATIONS -->
            @if (SelectedGardenId != null)
            {
                <div class="nav-section px-3 mt-3">
                    <span class="nav-header">Locations</span>
                </div>

                @if (locations == null)
                {
                    <div class="nav-item px-3">Loading...</div>
                }
                else if (!locations.Any(l => l.GardenId == SelectedGardenId))
                {
                    <div class="nav-item px-3">No locations</div>
                }
                else
                {
                    @foreach (var loc in locations.Where(l => l.GardenId == SelectedGardenId))
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@($"/plants?locationId={loc.LocationId}")">
                                <span class="bi bi-list-nested-nav-menu"></span>
                                @loc.Name
                            </NavLink>
                        </div>
                    }
                }

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@($"/locations/create?gardenId={SelectedGardenId}")">
                        <span class="bi bi-plus-square-fill-nav-menu"></span>
                        Add Location
                    </NavLink>
                </div>
            }



            <!-- OBSERVATIONS -->
            <div class="nav-section px-3 mt-3">
                <span class="nav-header">Observations</span>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/observations">
                    <span class="bi bi-list-nested-nav-menu"></span>
                    Observations
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/observations/create">
                    <span class="bi bi-plus-square-fill-nav-menu"></span>
                    Add Observation
                </NavLink>
            </div>

            <!-- JOURNAL -->
            <div class="nav-section px-3 mt-3">
                <span class="nav-header">Journal</span>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/journalentries">
                    <span class="bi bi-list-nested-nav-menu"></span>
                    Journal Entries
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/journalentries/create">
                    <span class="bi bi-plus-square-fill-nav-menu"></span>
                    Add Journal Entry
                </NavLink>
            </div>

            <!-- SIGN OUT (BOTTOM) -->
            <div class="nav-bottom px-3 mt-auto mb-3">
                <a class="nav-link signout" @onclick="SignOut">
                    <span class="bi bi-box-arrow-right"></span>
                    Sign Out
                </a>
            </div>

        </nav>
    </div>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int? gardenId { get; set; }

    public int? SelectedGardenId => Session.CurrentGardenId;


    List<LocationModel>? locations;

    private async Task LoadLocations()
    {
        locations = await LocationService.GetAll();
    }

    void SelectGarden(int id)
    {
        Session.SetGarden(id);
    }

    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    List<GardenModel>? gardens;

    protected override void OnInitialized()
    {
        Session.OnChange += async () =>
        {
            await LoadGardens();
            await LoadLocations();
            StateHasChanged();
        };
    }


    protected override async Task OnParametersSetAsync()
    {
        await LoadGardens();
        await LoadLocations();
    }



    private async Task LoadGardens()
    {
        if (Session.CurrentUserId != null)
        {
            gardens = await GardenService.GetGardensByUser(Session.CurrentUserId.Value);
        }
        else
        {
            gardens = null;
        }
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void SignOut()
    {
        Session.Clear();
        Nav.NavigateTo("/login", true);
    }
}
