<div class="@BuildContainerClasses()">

    @if (Loading)
    {
        <LoadingSpinner Message="Loading journal entries..." />
    }
    else if (SelectedDate == null)
    {
        <EmptyState Icon="bi bi-calendar" Title="No date selected">
            Select a date to view journal entries.
        </EmptyState>
    }
    else if (EntriesForDate.Count == 0)
    {
        <EmptyState Icon="bi bi-journal-x" Title="No journal entries">
            There are no entries for this date.
        </EmptyState>
    }
    else
    {
        @foreach (var j in EntriesForDate)
        {
            <div class="@BuildCardClasses()" title="@Tooltip">

                <!-- HEADER -->
                <div class="journal-header d-flex justify-content-between align-items-start">

                    <div class="journal-meta">

                        @if (!string.IsNullOrWhiteSpace(j.Title))
                        {
                            <div class="journal-title mt-1">@j.Title</div>
                        }

                        <PillTag Text="@GetGardenName(j.GardenId)" Color="default" CssClass="me-auto" />
                        <div class="journal-date ms-1">@FormatDate(j.CreatedAt)</div>

                    </div>

                    @if (!Disabled)
                    {
                        <IconButton Icon="bi bi-pencil-square"
                                    Label="Edit"
                                    Size="sm"
                                    OnClick="() => OnEdit.InvokeAsync(j.JournalEntryId)" />
                    }
                </div>

                <!-- ENTRY TEXT -->
                <div class="journal-body mt-2">
                    @if (ChildContent != null)
                    {
                        @ChildContent(j)
                    }
                    else
                    {
                        <p class="ms-1">@j.Entry</p>
                        <div class="d-flex justify-content-end">
                            <span class="">@j.CreatedAt.ToLocalTime().ToString("hh:mm tt")</span>
                        </div>
                    }
                </div>

                <!-- SAME-DAY OBSERVATIONS -->
                @{
                    var sameDay = ObservationsForDate(j.CreatedAt);
                }

                @if (sameDay.Count > 0)
                {
                    <div class="mt-3 p-2 border-top">

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="m-0">Observations From Today...</h4>
                        </div>

                        @foreach (var o in sameDay)
                        {
                            <div class="observation-mini-tile mb-2 p-2 tile-hover tile-rounded card"
                                 @onclick="() => OpenObservation(o.ObservationId)">



                                <!-- PLANT NAME + COMMON + SCIENTIFIC -->
                                <div class="mt-2 d-flex justify-content-between">
                                    <div class="d-flex gap-1">
                                        <h5 class="fw-bold">@GetPlantName(o.PlantId)</h5>
                                        <div class="text-muted small">| @GetCommonName(o.PlantId) |</div>
                                        <div class="fst-italic text-muted small">@GetScientificName(o.PlantId)</div>
                                    </div>
                                    <div class="">
                                        <span class="badge @(o.ActiveObservation ? "bg-success" : "bg-secondary")">
                                            @(o.ActiveObservation ? "Active" : "Inactive")
                                        </span>
                                    </div>
                                </div>

                                <!-- OBSERVATION TEXT -->
                                <p class="ms-1 mt-1 fw-light">@o.Observation</p>

                                <div class="d-flex justify-content-end mt-4">
                                    <span class="text-muted small">
                                        @o.CreatedAt.ToLocalTime().ToString("hh:mm tt")
                                    </span>
                                </div>

                            </div>
                        }

                    </div>
                }

            </div>
        }
    }

</div>

@code {
    [Parameter] public DateTime? SelectedDate { get; set; }
    [Parameter] public List<JournalEntryModel> Entries { get; set; } = new();
    [Parameter] public List<ObservationModel> Observations { get; set; } = new();
    [Parameter] public List<GardenModel> Gardens { get; set; } = new();

    // FIXED: Use PlantWithInfoDto instead of PlantModel
    [Parameter] public List<PlantWithInfoDto> Plants { get; set; } = new();

    [Parameter] public EventCallback<int> OnEdit { get; set; }

    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool Loading { get; set; } = false;

    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string CardClass { get; set; } = "journal-card";
    [Parameter] public string Size { get; set; } = "md";
    [Parameter] public bool Rounded { get; set; } = true;
    [Parameter] public bool Padding { get; set; } = true;

    [Parameter] public string? Tooltip { get; set; }

    [Parameter] public RenderFragment<JournalEntryModel>? ChildContent { get; set; }

    [Inject] NavigationManager Nav { get; set; }

    void OpenObservation(int id)
    {
        Nav.NavigateTo($"/observations?obsId={id}");
    }

    string GetGardenName(int gardenId) =>
        Gardens?.FirstOrDefault(g => g.GardenId == gardenId)?.Name ?? "Unknown Garden";

    string FormatDate(DateTime dt) =>
        dt.ToString("dddd, MMM dd");

    string FormatTime(DateTime dt) =>
        dt.ToString("hh:mm tt");

    private string BuildContainerClasses()
    {
        var sizeClass = Size switch
        {
            "sm" => "tile-sm",
            "lg" => "tile-lg",
            _ => "tile-md"
        };

        return $"journal-details-tile {sizeClass} {CssClass}".Trim();
    }

    private string BuildCardClasses()
    {
        var roundedClass = Rounded ? "tile-rounded" : "";
        var paddingClass = Padding ? "p-3" : "p-0";
        var disabledClass = Disabled ? "tile-disabled" : "";

        return $"{CardClass} {roundedClass} {paddingClass} {disabledClass}".Trim();
    }

    // FIXED: Use PlantWithInfoDto fields directly
    string GetPlantName(int plantId) =>
        Plants?.FirstOrDefault(p => p.PlantId == plantId)?.Name ?? "Unknown Plant";

    string GetCommonName(int plantId) =>
        Plants?.FirstOrDefault(p => p.PlantId == plantId)?.CommonName ?? "Unknown";

    string GetScientificName(int plantId) =>
        Plants?.FirstOrDefault(p => p.PlantId == plantId)?.ScientificName ?? "Unknown";

    List<JournalEntryModel> EntriesForDate =>
        Entries
            .Where(j => SelectedDate.HasValue &&
                        DateOnly.FromDateTime(j.CreatedAt) ==
                        DateOnly.FromDateTime(SelectedDate.Value))
            .OrderByDescending(j => j.CreatedAt)
            .ToList();

    List<ObservationModel> ObservationsForDate(DateTime date) =>
        Observations
            .Where(o => DateOnly.FromDateTime(o.CreatedAt) ==
                        DateOnly.FromDateTime(date))
            .OrderByDescending(o => o.CreatedAt)
            .ToList();
}
