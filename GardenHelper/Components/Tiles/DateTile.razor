<div class="@BuildClasses()"
     @onclick="HandleClick"
     @onclick:preventDefault="PreventDefault"
     title="@Tooltip">

    <!-- DATE -->
    <div class="date-main d-flex align-items-center">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <i class="@Icon me-2"></i>
        }

        @Date.ToString(Format)
    </div>

    <!-- COUNTS WITH ICONS -->
    <div class="date-sub text-muted d-flex align-items-center mt-2">

        @if (ChildContent != null)
        {
            @ChildContent
        }
        else
        {
            <!-- PRIMARY COUNT (entries) -->
            <span class="d-flex align-items-center">
                <i class="bi bi-journal-text me-1"></i>
                @Count @PluralizedLabel
            </span>

            <!-- SECONDARY COUNT (observations) -->
            @if (SecondaryCount > 0)
            {
                <span class="d-flex align-items-center ms-3">
                    <i class="bi bi-eye me-1"></i>
                    @SecondaryCount @SecondaryPluralizedLabel
                </span>
            }
        }
    </div>
</div>

@code {
    [Parameter] public DateTime Date { get; set; }

    // PRIMARY COUNT (entries)
    [Parameter] public int Count { get; set; }
    [Parameter] public string Label { get; set; } = "entry";

    // SECONDARY COUNT (observations)
    [Parameter] public int SecondaryCount { get; set; } = 0;
    [Parameter] public string SecondaryLabel { get; set; } = "observation";

    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool Disabled { get; set; } = false;

    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string SelectedClass { get; set; } = "selected";
    [Parameter] public string HoverClass { get; set; } = "tile-hover";

    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Format { get; set; } = "MMM dd, yyyy";
    [Parameter] public string Size { get; set; } = "md"; // sm, md, lg
    [Parameter] public bool Rounded { get; set; } = true;
    [Parameter] public bool Padding { get; set; } = true;

    [Parameter] public string? Tooltip { get; set; }
    [Parameter] public bool PreventDefault { get; set; } = false;

    [Parameter] public EventCallback<DateTime> OnSelect { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string PluralizedLabel =>
        Count == 1 ? Label : $"{Label}s";

    private string SecondaryPluralizedLabel =>
        SecondaryCount == 1 ? SecondaryLabel : $"{SecondaryLabel}s";

    private async Task HandleClick()
    {
        if (!Disabled)
            await OnSelect.InvokeAsync(Date);
    }

    private string BuildClasses()
    {
        var sizeClass = Size switch
        {
            "sm" => "tile-sm",
            "lg" => "tile-lg",
            _ => "tile-md"
        };

        var roundedClass = Rounded ? "tile-rounded" : "";
        var paddingClass = Padding ? "p-2" : "p-0";
        var selectedClass = Selected ? SelectedClass : "";
        var disabledClass = Disabled ? "tile-disabled" : "";

        return $"date-tile {sizeClass} {roundedClass} {paddingClass} {HoverClass} {selectedClass} {disabledClass} {CssClass}".Trim();
    }
}
