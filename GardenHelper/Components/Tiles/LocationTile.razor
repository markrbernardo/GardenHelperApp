<div class="location-tile" @onclick="HandleClick">
    <div class="location-header">
        <div class="location-name">@Location.Name</div>

        @if (Location.IsOutside == true)
        {
            <div class="location-tag outside">Outside</div>
        }
        else
        {
            <div class="location-tag inside">Inside</div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Location.Photo))
    {
        <img class="location-photo"
             src="@($"data:image/jpeg;base64,{Location.Photo}")" />
    }

    <div class="location-details">
        <div class="location-lighting">@Location.Lighting</div>
        <div class="location-count">@PlantCount plant(s)</div>
    </div>
</div>

@code {
    [Parameter] public LocationModel Location { get; set; }
    [Parameter] public int PlantCount { get; set; }
    [Parameter] public EventCallback<int> OnSelect { get; set; }

    Task HandleClick() => OnSelect.InvokeAsync(Location.LocationId);
}
