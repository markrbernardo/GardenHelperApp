@using GardenHelperApp.Shared.Models

<div class="@BuildContainerClasses()">

    @if (Plant == null)
    {
        <EmptyState Icon="bi bi-flower1" Title="No plant selected">
            Select a plant to view its profile.
        </EmptyState>
    }
    else
    {
        <div class="@BuildCardClasses()">

            <!-- HEADER -->
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h2 class="m-0">@Plant.CommonName</h2>

                    @if (!string.IsNullOrWhiteSpace(Plant.ScientificName))
                    {
                        <div class="text-muted">
                            <em>@Plant.ScientificName</em>
                        </div>
                    }
                </div>

                <IconButton Icon="bi bi-pencil-square"
                            Label="Edit"
                            Size="sm"
                            Disabled="@Disabled"
                            OnClick="() => OnEditInfo.InvokeAsync(Plant.PlantInformationId)" />
            </div>

            <!-- PHOTO -->
            @if (!string.IsNullOrWhiteSpace(Plant.Photo))
            {
                <img src="@($"data:{Plant.PhotoMimeType ?? "image/jpeg"};base64,{Plant.Photo}")"
                     class="plant-photo mb-3"
                     alt="Plant photo" />
            }

            <!-- DESCRIPTION -->
            @Detail("Description", Plant.Description)

            <!-- BASIC INFO -->
            <SectionHeader Title="Basic Information" Size="h5" CssClass="mt-3" />
            <div class="info-section">
                @Detail("Growing Season", Plant.GrowingSeason)
                @Detail("Seeds", Plant.Seeds)
            </div>

            <!-- CARE INFO -->
            <SectionHeader Title="Care Information" Size="h5" CssClass="mt-4" />
            <div class="info-section">
                @Detail("Light", Plant.Light)
                @Detail("Water", Plant.Water)
                @Detail("Air", Plant.Air)
                @Detail("Soil", Plant.Soil)
                @Detail("Container", Plant.Container)
                @Detail("Fertilization", Plant.Fertilization)
                @Detail("Pruning", Plant.Pruning)
                @Detail("Propagation", Plant.Propagation)
                @Detail("Health", Plant.Health)
            </div>

        </div>
    }
</div>

@code {
    [Parameter] public PlantInformationModel? Plant { get; set; }

    // Editing callback (renamed to match info cards)
    [Parameter] public EventCallback<int> OnEditInfo { get; set; }

    // Standardized component features
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string CardClass { get; set; } = "plantinfo-details-tile";
    [Parameter] public string HoverClass { get; set; } = "tile-hover";
    [Parameter] public string Size { get; set; } = "md";
    [Parameter] public bool Rounded { get; set; } = true;
    [Parameter] public bool Padding { get; set; } = true;

    RenderFragment Detail(string title, object? value) => builder =>
    {
        if (value is null)
            return;

        var text = value.ToString();
        if (string.IsNullOrWhiteSpace(text))
            return;

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "detail-block");

        builder.OpenElement(2, "h5");
        builder.AddContent(3, title);
        builder.CloseElement();

        builder.OpenElement(4, "p");
        builder.AddContent(5, text);
        builder.CloseElement();

        builder.CloseElement();
    };

    private string BuildContainerClasses()
    {
        var sizeClass = Size switch
        {
            "sm" => "tile-sm",
            "lg" => "tile-lg",
            _ => "tile-md"
        };

        return $"plantdetails-container {sizeClass} {CssClass}".Trim();
    }

    private string BuildCardClasses()
    {
        var roundedClass = Rounded ? "tile-rounded" : "";
        var paddingClass = Padding ? "p-3" : "p-0";

        return $"{CardClass} {roundedClass} {paddingClass} {HoverClass}".Trim();
    }
}
