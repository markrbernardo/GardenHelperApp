@inject NavigationManager Nav

<div class="plantinfo-details-tile">

    <!-- HEADER -->
    <div class="header-row">
        <div>
            <h2 class="common-name">@Info.CommonName</h2>
            <div class="scientific-name"><em>@Info.ScientificName</em></div>
        </div>

        <button class="btn btn-sm btn-outline-primary edit-btn"
                @onclick="Edit">
            <i class="bi bi-pencil"></i> Edit
        </button>
    </div>

    <!-- PHOTO -->
    @if (!string.IsNullOrEmpty(Info.Photo))
    {
        <img src="@($"data:{Info.PhotoMimeType ?? "image/jpeg"};base64,{Info.Photo}")"
             class="info-photo" />
    }

    <!-- DETAILS -->
    <div class="info-section">
        @DetailBlock("Description", Info.Description)
        @DetailBlock("Growing Season", Info.GrowingSeason)
        @DetailBlock("Seeds", Info.Seeds)
        @DetailBlock("Light", Info.Light)
        @DetailBlock("Water", Info.Water)
        @DetailBlock("Air", Info.Air)
        @DetailBlock("Soil", Info.Soil)
        @DetailBlock("Container", Info.Container)
        @DetailBlock("Fertilization", Info.Fertilization)
        @DetailBlock("Pruning", Info.Pruning)
        @DetailBlock("Propagation", Info.Propagation)
        @DetailBlock("Health", Info.Health)
    </div>

</div>

@code {
    [Parameter] public PlantInformationModel Info { get; set; } = new();

    void Edit()
    {
        Nav.NavigateTo($"/plantinformation/edit/{Info.PlantInformationId}");
    }

    RenderFragment DetailBlock(string title, string? value) => builder =>
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "detail-block");

            builder.OpenElement(2, "h5");
            builder.AddContent(3, title);
            builder.CloseElement();

            builder.OpenElement(4, "p");
            builder.AddContent(5, value);
            builder.CloseElement();

            builder.CloseElement();
        }
    };
}
