<div class="@BuildClasses()"
     @onclick="HandleClick"
     @onclick:preventDefault="PreventDefault"
     title="@Tooltip">

    <!-- THUMB -->
    <div class="info-thumb">
        @if (!string.IsNullOrWhiteSpace(Info.Photo))
        {
            <img src="@($"data:{Info.PhotoMimeType ?? "image/jpeg"};base64,{Info.Photo}")"
                 alt="Plant info photo" />
        }
        else
        {
            <div class="info-thumb-placeholder">🌿</div>
        }
    </div>

    <!-- TEXT -->
    <div class="info-text">
        <div class="info-name">@Info.CommonName</div>
        <div class="info-scientific text-muted fst-italic">@Info.ScientificName</div>

        @if (ChildContent != null)
        {
            <div class="info-extra mt-1">
                @ChildContent
            </div>
        }
    </div>

</div>

@code {
    [Parameter] public PlantInformationModel Info { get; set; } = default!;
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool PreventDefault { get; set; } = false;

    [Parameter] public EventCallback<PlantInformationModel> OnSelect { get; set; }

    // Standardized component features
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string SelectedClass { get; set; } = "selected";
    [Parameter] public string HoverClass { get; set; } = "tile-hover";

    [Parameter] public string Size { get; set; } = "md"; // sm, md, lg
    [Parameter] public bool Rounded { get; set; } = true;
    [Parameter] public bool Padding { get; set; } = true;

    [Parameter] public string? Tooltip { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task HandleClick()
    {
        if (!Disabled)
            await OnSelect.InvokeAsync(Info);
    }

    private string BuildClasses()
    {
        var sizeClass = Size switch
        {
            "sm" => "tile-sm",
            "lg" => "tile-lg",
            _ => "tile-md"
        };

        var roundedClass = Rounded ? "tile-rounded" : "";
        var paddingClass = Padding ? "p-2" : "p-0";
        var selectedClass = Selected ? SelectedClass : "";
        var disabledClass = Disabled ? "tile-disabled" : "";

        return $"plantinfo-nametag-tile {sizeClass} {roundedClass} {paddingClass} {HoverClass} {selectedClass} {disabledClass} {CssClass}".Trim();
    }
}
