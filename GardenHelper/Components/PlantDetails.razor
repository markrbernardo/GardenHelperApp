@using GardenHelperApp.Shared.Models
@inject ObservationService ObservationService
@inject NavigationManager Nav

@if (Plant == null)
{
    <p class="placeholder">Select a plant to view its profile.</p>
}
else
{
    <div class="card p-3">
        <div class="d-flex justify-content-between">
            <div>
                <h2>@Plant.CommonName</h2>
                <div class="text-muted"><em>@Plant.ScientificName</em></div>
            </div>

            <!-- EDIT PLANT BUTTON -->
            <button class="btn btn-outline-primary btn-sm mb-3"
                    @onclick="() => OnEditPlant.InvokeAsync(Plant.PlantId)">
                <i class="bi bi-pencil-square"></i> Edit Profile
            </button>
        </div>

        <details class="plant-info mt-2">
            <summary>Plant Information</summary>

            <p><strong>Common Name:</strong> @Plant.CommonName</p>
            <p><strong>Scientific Name:</strong> @Plant.ScientificName</p>
        </details>

        @if (!string.IsNullOrWhiteSpace(Plant.Description))
        {
            <p><strong>Description:</strong> @Plant.Description</p>
        }

        @if (!string.IsNullOrWhiteSpace(Plant.Notes))
        {
            <p><strong>Notes:</strong> @Plant.Notes</p>
        }

        <hr />

        <h3 class="mt-3 d-flex justify-content-between align-items-center">
            <span>Observations</span>

            <button class="btn btn-sm btn-outline-success"
                    @onclick="() => OnAddObservation.InvokeAsync(Plant.PlantId)">
                <i class="bi bi-plus-lg"></i> Add Observation
            </button>
        </h3>

        @if (observations == null)
        {
            <p>Loading observations...</p>
        }
        else if (observations.Count == 0)
        {
            <p>No observations yet.</p>
        }
        else
        {
            @foreach (var o in observations
                .OrderByDescending(o => o.ActiveObservation)
                .ThenByDescending(o => o.CreatedAt))
            {
                <div class="card mb-3 p-3 observation-card clickable"
                     @onclick="() => OpenObservation(o.ObservationId)">

                    <div class="d-flex justify-content-between align-items-center">

                        <div class="text-muted" style="width: 120px;">
                            @o.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                        </div>

                        <div class="flex-grow-1 px-3">
                            <strong>@o.Observation</strong>
                        </div>

                        <div class="text-end" style="width: 140px;">
                            @if (o.ActiveObservation)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </div>

                    </div>

                </div>
            }
        }
    </div>
}

@code {
    [Parameter] public PlantWithInfoDto? Plant { get; set; }
    [Parameter] public EventCallback<int> OnAddObservation { get; set; }
    [Parameter] public EventCallback<int> OnEditObservation { get; set; }
    [Parameter] public EventCallback<int> OnEditPlant { get; set; }

    List<ObservationModel>? observations;

    protected override async Task OnParametersSetAsync()
    {
        if (Plant == null)
        {
            observations = null;
            return;
        }

        observations = await ObservationService.GetByPlant(Plant.PlantId);
    }

    void OpenObservation(int id)
    {
        Nav.NavigateTo($"/observations?obsId={id}&plantId={Plant!.PlantId}");
    }
}
