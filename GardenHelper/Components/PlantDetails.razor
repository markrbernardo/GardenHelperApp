@using GardenHelperApp.Shared.Models
@inject PlantInformationService PlantInfoService
@inject ObservationService ObservationService
@inject NavigationManager Nav

@if (Plant == null)
{
    <p class="placeholder">Select a plant to view its profile.</p>
}
else
{
    <h2>@Plant.Name</h2>

    @if (plantInfo != null)
    {
        <details class="plant-info">
            <summary>Plant Information</summary>

            <p><strong>Common Name:</strong> @plantInfo.CommonName</p>
            <p><strong>Scientific Name:</strong> @plantInfo.ScientificName</p>

            @* When you add more fields, add them here ONCE *@
        </details>
    }

    <h4 class="mt-4">Observations</h4>

    @if (observations == null)
    {
        <p>Loading observations...</p>
    }
    else if (observations.Count == 0)
    {
        <p>No observations yet.</p>
    }
    else
    {
        <ul>
            @foreach (var o in observations)
            {
                <tr>
                    <td>
                        <li>@o.Observation</li>
                    </td>
                    <td>
                        <button class="btn btn-primary btn-sm" @onclick="() => EditObservation(o.ObservationId)">Edit</button>
                    </td>
                </tr>

            }
        </ul>
    }

    <button class="btn btn-sm btn-outline-success"
            @onclick="() => OnAddObservation.InvokeAsync(Plant.PlantId)">
        <i class="bi bi-plus-lg"></i> Add Observation
    </button>

}

@code {
    [Parameter] public PlantModel? Plant { get; set; }
    [Parameter] public EventCallback<int> OnAddObservation { get; set; }


    PlantInformationModel? plantInfo;
    List<ObservationModel>? observations;

    protected override async Task OnParametersSetAsync()
    {
        if (Plant == null)
        {
            plantInfo = null;
            observations = null;
            return;   // <-- THIS prevents the crash
        }

        plantInfo = await PlantInfoService.Get(Plant.PlantInformationId);
        observations = await ObservationService.GetByPlant(Plant.PlantId);
    }

    void EditObservation(int id)
    {
        Nav.NavigateTo($"/observations/edit/{id}");
    }

    void AddObservation()
    {
        if (Plant != null)
            Nav.NavigateTo($"/observations/create?plantId={Plant.PlantId}&returnUrl=/plants?plantId={Plant.PlantId}");
        
    }
}
