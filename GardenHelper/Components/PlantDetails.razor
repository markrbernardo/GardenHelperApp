@using GardenHelperApp.Shared.Models
@inject ObservationService ObservationService
@inject NavigationManager Nav

@if (Plant == null)
{
    <p class="placeholder">Select a plant to view its profile.</p>
}
else
{
    <div class="card p-3">
        <div class="d-flex justify-content-between">
            <div>
                <h2 class="text-decoration-underline">@Plant.Name</h2>
            </div>

            <!-- EDIT PLANT BUTTON -->
            <button class="btn btn-outline-primary btn-sm mb-3"
                    @onclick="() => OnEditPlant.InvokeAsync(Plant.PlantId)">
                <i class="bi bi-pencil-square"></i> Edit Profile
            </button>
        </div>
        <div><strong>Common Name:</strong> @Plant.CommonName</div>
        <div><strong>Scientific Name:</strong> @Plant.ScientificName</div>
       

        <!-- BASIC INFO -->
        <details class="plant-info mt-4">
            <summary>Plant Information</summary>

            <h3 class="pt-2"><strong>@Plant.CommonName</strong></h3>

            @if (!string.IsNullOrWhiteSpace(Plant.Photo))
            {
                <img src="@($"data:{Plant.PhotoMimeType ?? "image/jpeg"};base64,{Plant.Photo}")"
                     class="generic-photo mb-3" />
            }

            @if (!string.IsNullOrWhiteSpace(Plant.GrowingSeason))
            {
                <p><strong>Growing Season:</strong> @Plant.GrowingSeason</p>
            }

            <!-- DESCRIPTION -->
            @if (!string.IsNullOrWhiteSpace(Plant.Description))
            {
                <h5>Description</h5>
                <p>@Plant.Description</p>
            }

            <!-- CARE INFORMATION -->
            <h4 class="mt-4">Care Information</h4>

            @if (!string.IsNullOrWhiteSpace(Plant.Seeds))
            {
                <h5>Seeds</h5>
                <p>@Plant.Seeds</p>
            }

            @if (!string.IsNullOrWhiteSpace(Plant.Light))
            {
                <h5>Light</h5>
                <p>@Plant.Light</p>
            }

            @if (!string.IsNullOrWhiteSpace(Plant.Water))
            {
                <h5>Water</h5>
                <p>@Plant.Water</p>
            }

            @if (!string.IsNullOrWhiteSpace(Plant.Air))
            {
                <h5>Air</h5>
                <p>@Plant.Air</p>
            }

            @if (!string.IsNullOrWhiteSpace(Plant.Soil))
            {
                <h5>Soil</h5>
                <p>@Plant.Soil</p>
            }

            @if (!string.IsNullOrWhiteSpace(Plant.Container))
            {
                <h5>Container</h5>
                <p>@Plant.Container</p>
            }

            @if (!string.IsNullOrWhiteSpace(Plant.Fertilization))
            {
                <h5>Fertilization</h5>
                <p>@Plant.Fertilization</p>
            }

            @if (!string.IsNullOrWhiteSpace(Plant.Pruning))
            {
                <h5>Pruning</h5>
                <p>@Plant.Pruning</p>
            }

            @if (!string.IsNullOrWhiteSpace(Plant.Propagation))
            {
                <h5>Propagation</h5>
                <p>@Plant.Propagation</p>
            }

            @if (!string.IsNullOrWhiteSpace(Plant.Health))
            {
                <h5>Health</h5>
                <p>@Plant.Health</p>
            }


        </details>


        <!-- NOTES -->
        @if (!string.IsNullOrWhiteSpace(Plant.Notes))
        {
            <h5>Notes</h5>
            <p>@Plant.Notes</p>
        }




        

        <hr />

        <!-- OBSERVATIONS -->
        <h3 class="mt-3 d-flex justify-content-between align-items-center">
            <span>Observations</span>

            <button class="btn btn-sm btn-outline-success"
                    @onclick="() => OnAddObservation.InvokeAsync(Plant.PlantId)">
                <i class="bi bi-plus-lg"></i> Add Observation
            </button>
        </h3>

        @if (observations == null)
        {
            <p>Loading observations...</p>
        }
        else if (observations.Count == 0)
        {
            <p>No observations yet.</p>
        }
        else
        {
            @foreach (var o in observations
                .OrderByDescending(o => o.ActiveObservation)
                .ThenByDescending(o => o.CreatedAt))
            {
                <div class="card mb-3 p-3 observation-card clickable"
                     @onclick="() => OpenObservation(o.ObservationId)">

                    <div class="d-flex justify-content-between align-items-center">

                        <div class="text-muted" style="width: 120px;">
                            @o.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                        </div>

                        <div class="flex-grow-1 px-3">
                            <strong>@o.Observation</strong>
                        </div>

                        <div class="text-end" style="width: 140px;">
                            @if (o.ActiveObservation)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </div>

                    </div>

                </div>
            }
        }
    </div>
}

@code {
    [Parameter] public PlantWithInfoDto? Plant { get; set; }
    [Parameter] public EventCallback<int> OnAddObservation { get; set; }
    [Parameter] public EventCallback<int> OnEditObservation { get; set; }
    [Parameter] public EventCallback<int> OnEditPlant { get; set; }

    List<ObservationModel>? observations;

    protected override async Task OnParametersSetAsync()
    {
        if (Plant == null)
        {
            observations = null;
            return;
        }

        observations = await ObservationService.GetByPlant(Plant.PlantId);
    }

    void OpenObservation(int id)
    {
        Nav.NavigateTo($"/observations?obsId={id}&plantId={Plant!.PlantId}");
    }
}
