@inject NavigationManager Nav

<div class="plantinfo-details card p-3">

    <div class="d-flex justify-content-between align-items-center">
        <h2 class="mb-0">@Info.CommonName</h2>

        <button class="btn btn-sm btn-outline-primary"
                @onclick="Edit">
            <i class="bi bi-pencil"></i> Edit
        </button>
    </div>

    <h4 class="text-muted"><em>@Info.ScientificName</em></h4>

    @if (!string.IsNullOrEmpty(Info.Photo))
    {
        <img src="@($"data:{Info.PhotoMimeType ?? "image/jpeg"};base64,{Info.Photo}")"
             class="generic-photo" />
    }

    @if (!string.IsNullOrWhiteSpace(Info.Description))
    {
        <h5>Description</h5>
        <p>@Info.Description</p>
    }

    @if (!string.IsNullOrWhiteSpace(Info.GrowingSeason))
    {
        <h5>Growing Season</h5>
        <p>@Info.GrowingSeason</p>
    }

    @if (!string.IsNullOrWhiteSpace(Info.Seeds))
    {
        <h5>Seeds</h5>
        <p>@Info.Seeds</p>
    }

    @if (!string.IsNullOrWhiteSpace(Info.Light))
    {
        <h5>Light</h5>
        <p>@Info.Light</p>
    }

    @if (!string.IsNullOrWhiteSpace(Info.Water))
    {
        <h5>Water</h5>
        <p>@Info.Water</p>
    }

    @if (!string.IsNullOrWhiteSpace(Info.Air))
    {
        <h5>Air</h5>
        <p>@Info.Air</p>
    }

    @if (!string.IsNullOrWhiteSpace(Info.Soil))
    {
        <h5>Soil</h5>
        <p>@Info.Soil</p>
    }

    @if (!string.IsNullOrWhiteSpace(Info.Container))
    {
        <h5>Container</h5>
        <p>@Info.Container</p>
    }

    @if (!string.IsNullOrWhiteSpace(Info.Fertilization))
    {
        <h5>Fertilization</h5>
        <p>@Info.Fertilization</p>
    }

    @if (!string.IsNullOrWhiteSpace(Info.Pruning))
    {
        <h5>Pruning</h5>
        <p>@Info.Pruning</p>
    }

    @if (!string.IsNullOrWhiteSpace(Info.Propagation))
    {
        <h5>Propagation</h5>
        <p>@Info.Propagation</p>
    }

    @if (!string.IsNullOrWhiteSpace(Info.Health))
    {
        <h5>Health</h5>
        <p>@Info.Health</p>
    }

</div>

@code {
    [Parameter] public PlantInformationModel Info { get; set; } = new();

    void Edit()
    {
        Nav.NavigateTo($"/plantinformation/edit/{Info.PlantInformationId}");
    }
}
