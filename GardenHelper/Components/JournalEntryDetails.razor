@using GardenHelperApp.Shared.Models

<div class="plant-details">

    @if (SelectedDate == null)
    {
        <p>Select a date to view journal entries.</p>
    }
    else if (EntriesForDate.Count == 0)
    {
        <p>No journal entries for this date.</p>
    }
    else
    {
        @foreach (var j in EntriesForDate)
        {
            <div class="obs-card pb-3">

                <!-- HEADER: DATE + GARDEN + EDIT BUTTON -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <p class="mb-0 text-muted">
                        @FormatDate(j.CreatedAt)
                        <br />
                        <span class="text-muted">@GetGardenName(j.GardenId)</span>
                    </p>

                    <button class="btn btn-primary btn-sm"
                            @onclick="() => OnEdit.InvokeAsync(j.JournalEntryId)">
                        Edit
                    </button>
                </div>

                <!-- ENTRY TEXT -->
                <p>@j.Entry</p>


            </div>
        }
    }

</div>

@code {
    [Parameter] public DateTime? SelectedDate { get; set; }
    [Parameter] public List<JournalEntryModel> Entries { get; set; }
    [Parameter] public List<GardenModel> Gardens { get; set; }
    [Parameter] public EventCallback<int> OnEdit { get; set; }

    List<JournalEntryModel> EntriesForDate =>
        Entries
            .Where(j => j.CreatedAt.Date == SelectedDate)
            .OrderByDescending(j => j.CreatedAt)
            .ToList();

    string GetGardenName(int gardenId) =>
        Gardens?.FirstOrDefault(g => g.GardenId == gardenId)?.Name ?? "Unknown Garden";

    string FormatDate(DateTime dt) =>
        dt.ToString("dddd, MMM dd • hh:mm tt");
}
