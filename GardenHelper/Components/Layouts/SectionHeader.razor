<div class="section-header d-flex justify-content-between align-items-center @CssClass">

    <div class="header-left">

        <div class="d-flex align-items-center">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <i class="@Icon me-2"></i>
            }

            @if (Size == "h4")
            {
                <h4 class="m-0">@Title</h4>
            }
            else if (Size == "h5")
            {
                <h5 class="m-0">@Title</h5>
            }
            else
            {
                <h3 class="m-0">@Title</h3>
            }
        </div>

        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <div class="text-muted small mt-1">@Subtitle</div>
        }

        @if (ChildContent != null)
        {
            <div class="mt-2">
                @ChildContent
            </div>
        }
    </div>

    @if (Actions != null)
    {
        <div class="header-actions">
            @Actions
        </div>
    }
</div>

@if (Divider)
{
    <hr class="mt-3 mb-4" />
}

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string Size { get; set; } = "h3"; // h3, h4, h5
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool Divider { get; set; } = false;

    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string CssClass { get; set; } = "";
}
