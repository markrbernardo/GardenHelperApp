<span class="pill-tag @ColorClass">
    @Text
</span>

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string Color { get; set; } = "default";

    private string ColorClass =>
        Color switch
        {
            "green" => "pill-green",
            "yellow" => "pill-yellow",
            "red" => "pill-red",
            "blue" => "pill-blue",
            _ => "pill-default"
        };
}
