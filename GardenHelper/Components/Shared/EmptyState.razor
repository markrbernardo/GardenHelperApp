<div class="empty-state text-center py-5">

    <!-- TITLE -->
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <h4 class="empty-title mb-3">@Title</h4>
    }

    <!-- ICON -->
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <i class="@Icon text-muted" style="font-size: 2rem;"></i>
    }

    <!-- MESSAGE -->
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <h5 class="mt-3">@Message</h5>
    }

    <!-- ACTION BUTTON -->
    @if (!string.IsNullOrWhiteSpace(ActionText))
    {
        @if (ActionCallback.HasDelegate)
        {
            <button class="btn btn-success mt-3"
                    @onclick="ActionCallback"
                    disabled="@Disabled">
                @ActionText
            </button>
        }
        else if (!string.IsNullOrWhiteSpace(ActionUrl))
        {
            <a class="btn btn-success mt-3"
                   href="@ActionUrl"
                   disabled="@Disabled">
                @ActionText
            </a>
        }
    }

    <!-- EXTRA CONTENT -->
    @if (ChildContent is not null)
    {
        <div class="mt-3">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Message { get; set; } = "Nothing here yet.";
    [Parameter] public string? Icon { get; set; } = "bi bi-emoji-smile";

    [Parameter] public string? ActionText { get; set; }
    [Parameter] public string? ActionUrl { get; set; }
    [Parameter] public EventCallback ActionCallback { get; set; }

    [Parameter] public bool Disabled { get; set; } = false;

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
