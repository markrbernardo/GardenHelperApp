<div class="empty-state text-center py-5">
    <i class="bi bi-emoji-smile text-muted" style="font-size: 2rem;"></i>

    <h5 class="mt-3">@Message</h5>

    @if (!string.IsNullOrEmpty(ActionText) && !string.IsNullOrEmpty(ActionUrl))
    {
        <a class="btn btn-success mt-3" href="@ActionUrl">
            @ActionText
        </a>
    }
</div>

@code {
    [Parameter] public string Message { get; set; } = "Nothing here yet.";
    [Parameter] public string? ActionText { get; set; }
    [Parameter] public string? ActionUrl { get; set; }
}
