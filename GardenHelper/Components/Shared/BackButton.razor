<button class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center"
        @onclick="HandleClick"
        @onclick:preventDefault="true"
        disabled="@Disabled">

    <i class="@Icon me-1"></i>

    @if (ChildContent != null)
    {
        @ChildContent
    }
    else if (!string.IsNullOrEmpty(Label))
    {
        @Label
    }
</button>

@code {
    [Parameter] public string? Label { get; set; } = "Back";
    [Parameter] public string Icon { get; set; } = "bi bi-arrow-left";
    [Parameter] public string? Url { get; set; }
    [Parameter] public bool Disabled { get; set; } = false;

    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Inject] IJSRuntime JS { get; set; } = default!;
    [Inject] NavigationManager Nav { get; set; } = default!;

    private async Task HandleClick()
    {
        if (Disabled)
            return;

        // Optional user callback
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync();

        // If a specific URL is provided, use it
        if (!string.IsNullOrEmpty(Url))
        {
            Nav.NavigateTo(Url);
            return;
        }

        // Otherwise, go back in browser history
        await JS.InvokeVoidAsync("history.back");
    }
}
