<button class="@BuildClasses() @CssClass"
        type="@ButtonType"
        @onclick="HandleClick"
        @onclick:preventDefault="PreventDefault"
        disabled="@Disabled"
        title="@Tooltip">

    @if (IconPosition == "left")
    {
        <i class="@Icon me-1"></i>
    }

    @if (ChildContent != null)
    {
        @ChildContent
    }
    else if (!string.IsNullOrEmpty(Label))
    {
        @Label
    }

    @if (IconPosition == "right")
    {
        <i class="@Icon ms-1"></i>
    }
</button>

@code {
    [Parameter] public string Icon { get; set; } = "bi bi-question-circle";
    [Parameter] public string? Label { get; set; }
    [Parameter] public string Color { get; set; } = "primary";
    [Parameter] public string Size { get; set; } = "sm";
    [Parameter] public bool Outline { get; set; } = false;
    [Parameter] public bool Disabled { get; set; } = false;

    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string ButtonType { get; set; } = "button";
    [Parameter] public string IconPosition { get; set; } = "left"; // left or right
    [Parameter] public string? Tooltip { get; set; }
    [Parameter] public bool PreventDefault { get; set; } = false;

    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task HandleClick()
    {
        if (!Disabled && OnClick.HasDelegate)
            await OnClick.InvokeAsync();
    }

    private string BuildClasses()
    {
        var btnType = Outline ? $"btn btn-outline-{Color}" : $"btn btn-{Color}";
        var sizeClass = Size == "sm" ? "btn-sm" :
                        Size == "lg" ? "btn-lg" : "";

        return $"{btnType} {sizeClass}";
    }
}
