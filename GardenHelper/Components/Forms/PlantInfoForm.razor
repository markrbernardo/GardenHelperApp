@using GardenHelperApp.Shared.Models
@using GardenHelperApp.Shared.Enums

<EditForm Model="@PlantInfo" OnValidSubmit="OnSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <!-- BASIC INFO -->
    <div class="mb-3">
        <label class="form-label">Common Name</label>
        <InputText class="form-control"
                   @bind-Value="PlantInfo.CommonName"
                   disabled="@IsDisabled" />
    </div>

    <div class="mb-3">
        <label class="form-label">Scientific Name</label>
        <InputText class="form-control"
                   @bind-Value="PlantInfo.ScientificName"
                   disabled="@IsDisabled" />
    </div>

    <!-- PHOTO UPLOAD -->
    <div class="mb-3">
        <label class="form-label">Upload Photo</label>
        <InputFile OnChange="HandleFileSelected"
                   accept="image/*"
                   disabled="@IsDisabled" />
        <small class="text-muted">Choose an image to upload.</small>
    </div>

    @if (!string.IsNullOrEmpty(PlantInfo.Photo))
    {
        <div class="mt-2">
            <img src="@($"data:{PlantInfo.PhotoMimeType};base64,{PlantInfo.Photo}")"
                 style="max-width:200px; border-radius:8px;" />

            <button class="btn btn-danger btn-sm mt-2"
                    @onclick="RemovePhoto"
                    disabled="@IsDisabled">
                Remove Photo
            </button>
        </div>
    }

    <!-- DESCRIPTION -->
    <div class="mb-3">
        <label class="form-label">Description</label>
        <InputTextArea class="form-control"
                       rows="3"
                       @bind-Value="PlantInfo.Description"
                       disabled="@IsDisabled" />
    </div>

    <!-- ENUM: GROWING SEASON -->
    <div class="mb-3">
        <label class="form-label">Growing Season</label>
        <select class="form-select"
                @bind="PlantInfo.GrowingSeason"
                disabled="@IsDisabled">
            @foreach (var value in Enum.GetValues<Season>())
            {
                <option value="@value">@value</option>
            }
        </select>
    </div>

    <!-- CARE SECTIONS -->
    <h5 class="mt-4">Care Information</h5>

    <!-- ENUM: LIGHT -->
    <div class="mb-3">
        <label class="form-label">Light Requirement</label>
        <select class="form-select"
                @bind="PlantInfo.Light"
                disabled="@IsDisabled">
            @foreach (var value in Enum.GetValues<LightRequirement>())
            {
                <option value="@value">@value</option>
            }
        </select>
    </div>

    <!-- ENUM: WATER -->
    <div class="mb-3">
        <label class="form-label">Water Requirement</label>
        <select class="form-select"
                @bind="PlantInfo.Water"
                disabled="@IsDisabled">
            @foreach (var value in Enum.GetValues<WaterRequirement>())
            {
                <option value="@value">@value</option>
            }
        </select>
    </div>

    <!-- AIR (string) -->
    <div class="mb-3">
        <label class="form-label">Air</label>
        <InputTextArea class="form-control"
                       rows="2"
                       @bind-Value="PlantInfo.Air"
                       disabled="@IsDisabled" />
    </div>

    <!-- ENUM: SOIL -->
    <div class="mb-3">
        <label class="form-label">Soil Type</label>
        <select class="form-select"
                @bind="PlantInfo.Soil"
                disabled="@IsDisabled">
            @foreach (var value in Enum.GetValues<SoilType>())
            {
                <option value="@value">@value</option>
            }
        </select>
    </div>

    <!-- ENUM: CONTAINER -->
    <div class="mb-3">
        <label class="form-label">Container Type</label>
        <select class="form-select"
                @bind="PlantInfo.Container"
                disabled="@IsDisabled">
            @foreach (var value in Enum.GetValues<ContainerType>())
            {
                <option value="@value">@value</option>
            }
        </select>
    </div>

    <!-- ENUM: FERTILIZATION -->
    <div class="mb-3">
        <label class="form-label">Fertilization</label>
        <select class="form-select"
                @bind="PlantInfo.Fertilization"
                disabled="@IsDisabled">
            @foreach (var value in Enum.GetValues<FertilizerType>())
            {
                <option value="@value">@value</option>
            }
        </select>
    </div>

    <!-- PRUNING (string) -->
    <div class="mb-3">
        <label class="form-label">Pruning</label>
        <InputTextArea class="form-control"
                       rows="2"
                       @bind-Value="PlantInfo.Pruning"
                       disabled="@IsDisabled" />
    </div>

    <!-- ENUM: PROPAGATION -->
    <div class="mb-3">
        <label class="form-label">Propagation Method</label>
        <select class="form-select"
                @bind="PlantInfo.Propagation"
                disabled="@IsDisabled">
            @foreach (var value in Enum.GetValues<PropagationMethod>())
            {
                <option value="@value">@value</option>
            }
        </select>
    </div>

    <!-- ENUM: HEALTH -->
    <div class="mb-3">
        <label class="form-label">Health Status</label>
        <select class="form-select"
                @bind="PlantInfo.Health"
                disabled="@IsDisabled">
            @foreach (var value in Enum.GetValues<PlantHealthStatus>())
            {
                <option value="@value">@value</option>
            }
        </select>
    </div>

    <!-- BUTTONS -->
    <div class="d-flex gap-2 mt-4">
        <button class="btn btn-success" disabled="@IsDisabled">@SubmitLabel</button>
        <button class="btn btn-secondary" @onclick="Cancel" disabled="@IsDisabled">Cancel</button>

        @if (ShowDelete)
        {
            <button class="btn btn-danger ms-auto"
                    @onclick="Delete"
                    disabled="@IsDisabled">
                Delete
            </button>
        }
    </div>
</EditForm>

@code {
    [Parameter] public PlantInformationModel PlantInfo { get; set; } = default!;
    [Parameter] public string SubmitLabel { get; set; } = "Save";

    [Parameter] public EventCallback OnSubmitCallback { get; set; }
    [Parameter] public EventCallback OnCancelCallback { get; set; }
    [Parameter] public EventCallback OnDeleteCallback { get; set; }

    [Parameter] public bool ShowDelete { get; set; } = false;
    [Parameter] public bool IsDisabled { get; set; } = false;

    [Inject] public IJSRuntime JS { get; set; } = default!;

    private Task OnSubmit() => !IsDisabled ? OnSubmitCallback.InvokeAsync() : Task.CompletedTask;
    private Task Cancel() => !IsDisabled ? OnCancelCallback.InvokeAsync() : Task.CompletedTask;
    private Task Delete() => !IsDisabled ? OnDeleteCallback.InvokeAsync() : Task.CompletedTask;

    async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null)
            return;

        using var stream = file.OpenReadStream(maxAllowedSize: 10_000_000);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var bytes = ms.ToArray();

        var base64 = Convert.ToBase64String(bytes);
        var dataUrl = $"data:{file.ContentType};base64,{base64}";

        var resizedDataUrl = await JS.InvokeAsync<string>(
            "resizeImageFromBase64",
            dataUrl,
            800,
            800
        );

        var parts = resizedDataUrl.Split(',');
        PlantInfo.PhotoMimeType = parts[0].Split(':')[1].Split(';')[0];
        PlantInfo.Photo = parts[1];
    }

    void RemovePhoto()
    {
        PlantInfo.Photo = null;
        PlantInfo.PhotoMimeType = null;
    }
}
