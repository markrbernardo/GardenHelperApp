@using GardenHelperApp.Shared.Models

<EditForm Model="@Plant" OnValidSubmit="OnSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <!-- NAME -->
    <div class="mb-3">
        <label class="form-label">Plant Name</label>
        <InputText class="form-control"
                   @bind-Value="Plant.Name"
                   disabled="@IsDisabled" />
    </div>

    <!-- PLANT INFORMATION -->
    <div class="mb-3">
        <label class="form-label">Plant Information</label>
        <select class="form-select"
                @bind="Plant.PlantInformationId"
                disabled="@IsDisabled">
            @foreach (var info in PlantInfoList)
            {
                <option value="@info.PlantInformationId">
                    @info.CommonName (@info.ScientificName)
                </option>
            }
        </select>
    </div>

    <!-- LOCATION -->
    <div class="mb-3">
        <label class="form-label">Location</label>
        <select class="form-select"
                @bind="Plant.LocationId"
                disabled="@IsDisabled">
            @foreach (var loc in Locations)
            {
                <option value="@loc.LocationId">@loc.Name</option>
            }
        </select>
    </div>

    <!-- DESCRIPTION -->
    <div class="mb-3">
        <label class="form-label">Description</label>
        <InputTextArea class="form-control"
                       rows="3"
                       @bind-Value="Plant.Description"
                       disabled="@IsDisabled" />
    </div>

    <!-- NOTES -->
    <div class="mb-3">
        <label class="form-label">Notes</label>
        <InputTextArea class="form-control"
                       rows="3"
                       @bind-Value="Plant.Notes"
                       disabled="@IsDisabled" />
    </div>

    <!-- BUTTONS -->
    <button class="btn btn-success" disabled="@IsDisabled">@SubmitLabel</button>

    <button class="btn btn-secondary ms-2"
            @onclick="Cancel"
            disabled="@IsDisabled">
        Cancel
    </button>

    @if (ShowDelete)
    {
        <button class="btn btn-danger ms-2"
                @onclick="Delete"
                disabled="@IsDisabled">
            Delete
        </button>
    }
</EditForm>

@code {
    [Parameter] public PlantModel Plant { get; set; } = default!;
    [Parameter] public List<LocationModel> Locations { get; set; } = new();
    [Parameter] public List<PlantInformationModel> PlantInfoList { get; set; } = new();

    [Parameter] public string SubmitLabel { get; set; } = "Save";

    [Parameter] public EventCallback OnSubmitCallback { get; set; }
    [Parameter] public EventCallback OnCancelCallback { get; set; }
    [Parameter] public EventCallback OnDeleteCallback { get; set; }

    [Parameter] public bool ShowDelete { get; set; } = false;
    [Parameter] public bool IsDisabled { get; set; } = false;

    private Task OnSubmit() => !IsDisabled ? OnSubmitCallback.InvokeAsync() : Task.CompletedTask;
    private Task Cancel() => !IsDisabled ? OnCancelCallback.InvokeAsync() : Task.CompletedTask;
    private Task Delete() => !IsDisabled ? OnDeleteCallback.InvokeAsync() : Task.CompletedTask;
}
