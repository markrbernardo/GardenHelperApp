@page "/locations/create"

@inject LocationService LocationService
@inject GardenService GardenService
@inject UserSessionService UserSession
@inject NavigationManager Nav

<PageHeader Title="Create Location" />

<div class="page-section">

    @if (Gardens == null)
    {
        <LoadingSpinner Message="Loading gardens..." />
    }
    else
    {
        <LocationForm Location="Location"
                      Gardens="Gardens"
                      SubmitLabel="Create"
                      OnSubmitCallback="HandleSubmitAsync"
                      OnCancelCallback="GoBack"
                      ShowDelete="false" />
    }

</div>

@code {
    private LocationModel Location { get; set; } = new();
    private List<GardenModel>? Gardens;

    protected override async Task OnInitializedAsync()
    {
        // Require login
        if (UserSession.CurrentUserId == null)
        {
            Nav.NavigateTo("/login");
            return;
        }

        // Load gardens for this user
        Gardens = await GardenService.GetByUserAsync(UserSession.CurrentUserId.Value);

        // Default to current garden if available
        if (UserSession.CurrentGardenId != null)
        {
            Location.GardenId = UserSession.CurrentGardenId.Value;
        }
        else if (Gardens.Count > 0)
        {
            Location.GardenId = Gardens.First().GardenId;
        }
    }

    private async Task HandleSubmitAsync()
    {
        var newId = await LocationService.CreateAsync(Location);

        // Notify session listeners (NavMenu, etc.)
        await UserSession.InitializeAsync();

        Nav.NavigateTo($"/location-profile/{newId}");
    }

    private void GoBack()
    {
        Nav.NavigateTo($"/garden-profile/{Location.GardenId}");
    }
}
