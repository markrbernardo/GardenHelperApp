@page "/plantinformation/create"

@inject PlantInformationService PlantInfoService
@inject NavigationManager Nav

<PageHeader Title="Create Plant Information" />

<div class="page-section">

    @if (IsSubmitting)
    {
        <LoadingSpinner Message="Saving..." />
    }
    else
    {
        <PlantInfoForm PlantInfo="PlantInfo"
                       SubmitLabel="Create"
                       OnSubmitCallback="HandleSubmitAsync"
                       OnCancelCallback="GoBack"
                       ShowDelete="false" />
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger mt-3">@ErrorMessage</div>
    }

</div>

@code {
    private PlantInformationModel PlantInfo { get; set; } = new();
    private bool IsSubmitting = false;
    private string? ErrorMessage;

    private async Task HandleSubmitAsync()
    {
        try
        {
            IsSubmitting = true;
            ErrorMessage = null;

            await PlantInfoService.CreateAsync(PlantInfo);
            Nav.NavigateTo("/plantinformation");
        }
        catch (Exception ex)
        {
            ErrorMessage = "Failed to create plant information.";
            Console.WriteLine("ERROR in CreatePlantInformation: " + ex);
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void GoBack()
    {
        Nav.NavigateTo("/plantinformation");
    }
}
