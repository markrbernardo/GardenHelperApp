@using Microsoft.AspNetCore.WebUtilities

@page "/gardens"
@inject UserService UserService
@inject GardenService GardenService
@inject NavigationManager Nav
@inject IJSRuntime JS




<h3>Gardens</h3>


@if (users == null)
{
    <p>Loading users...</p>
}
else
{
    <div class="mb-3">
        <label>Select User</label>
        <select class="form-select" @onchange="LoadGardens" value="@selectedUserId">
            @foreach (var u in users)
            {
                <option value="@u.UserId">@u.Name</option>
            }
        </select>
    </div>

    <button class="btn btn-primary mb-3" @onclick="CreateGarden">
        Create New Garden
    </button>

    @if (gardens == null)
    {
        <p>Loading gardens...</p>
    }
    else if (gardens.Count == 0)
    {
        <p>No gardens found for this user.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Garden ID</th>
                    <th>Name</th>
                    <th>Zip Code</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in gardens)
                {
                    <tr>
                        <td>@g.GardenId</td>
                        <td>@g.Name</td>
                        <td>@g.ZipCode</td>
                        <td>
                            <button class="btn btn-primary btn-sm" @onclick="() => EditGarden(g.GardenId)">Edit</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => DeleteGarden(g.GardenId)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    List<UserModel>? users;
    List<GardenModel>? gardens;

    int selectedUserId;

    protected override async Task OnInitializedAsync()
    {
        users = await UserService.GetUsers();

        // Read ?userId=### from URL
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("userId", out var userIdFromQuery))
        {
            selectedUserId = int.Parse(userIdFromQuery!);
        }
        else
        {
            selectedUserId = users.First().UserId;
        }

        gardens = await GardenService.GetGardensByUser(selectedUserId);
    }


    async Task LoadGardens(ChangeEventArgs e)
    {
        selectedUserId = int.Parse(e.Value!.ToString()!);
        gardens = await GardenService.GetGardensByUser(selectedUserId);
    }

    void CreateGarden()
    {
        Nav.NavigateTo($"/gardens/create/{selectedUserId}");
    }

    void EditGarden(int id)
    {
        Nav.NavigateTo($"/gardens/edit/{id}");
    }

    async Task DeleteGarden(int id)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this garden?");
        if (!confirm) return;

        await GardenService.DeleteGarden(id);
        gardens = await GardenService.GetGardensByUser(selectedUserId);
    }

}