@page "/journalentries/edit/{id:int}"
@inject JournalEntryService JournalEntryService
@inject GardenService GardenService
@inject UserSessionService Session
@inject NavigationManager Nav

<h3>Edit Journal Entry</h3>

@if (entry == null || gardens == null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="@entry" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Garden</label>
            <select class="form-select" @bind="entry.GardenId">
                @foreach (var g in gardens)
                {
                    <option value="@g.GardenId">@g.Name</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label>Entry</label>
            <InputTextArea class="form-control" @bind-Value="entry.Entry" rows="5" />
        </div>

        <button class="btn btn-success">Save</button>
        <button class="btn btn-secondary" @onclick="GoBack">Cancel</button>
        <button type="button" class="btn btn-danger ms-2" @onclick="ShowDeleteConfirm">
            Delete
        </button>

        @if (showDeleteConfirm)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
                <div class="modal-dialog">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title">Delete Journal Entry</h5>
                        </div>

                        <div class="modal-body">
                            <p>Are you sure you want to delete this journal entry?</p>
                        </div>

                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="HideDeleteConfirm">Cancel</button>
                            <button class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
                        </div>

                    </div>
                </div>
            </div>
        }


    </EditForm>
}

@code {
    [Parameter] public int id { get; set; }

    JournalEntryModel? entry;
    List<GardenModel>? gardens;
    string? returnUrl;


    bool showDeleteConfirm = false;

    void ShowDeleteConfirm() => showDeleteConfirm = true;
    void HideDeleteConfirm() => showDeleteConfirm = false;

    async Task ConfirmDelete()
    {
        await JournalEntryService.Delete(entry!.JournalEntryId);

        if (!string.IsNullOrWhiteSpace(returnUrl))
            Nav.NavigateTo(returnUrl!);
        else
            Nav.NavigateTo("/journal");
    }



    protected override async Task OnInitializedAsync()
    {
        // Load the journal entry
        entry = await JournalEntryService.Get(id);

        if (entry == null)
            return;

        // ⭐ Force the entry to belong to the logged-in user
        entry.UserId = Session.CurrentUserId!.Value;

        // Load only this user's gardens
        gardens = await GardenService.GetGardensByUser(Session.CurrentUserId.Value);

        // Read returnUrl
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("returnUrl", out var url))
            returnUrl = url!;
    }

    async Task HandleSubmit()
    {
        // Safety: ensure UserId is always correct
        entry!.UserId = Session.CurrentUserId!.Value;

        await JournalEntryService.Update(entry);

        if (!string.IsNullOrWhiteSpace(returnUrl))
            Nav.NavigateTo(returnUrl!);
        else
            Nav.NavigateTo("/journalentries");
    }

    void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(returnUrl))
            Nav.NavigateTo(returnUrl!);
        else
            Nav.NavigateTo("/journalentries");
    }
}
