@page "/journalentries/edit/{Id:int}"

@inject JournalEntryService JournalEntryService
@inject GardenService GardenService
@inject UserSessionService Session
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageHeader Title="Edit Journal Entry" />

<div class="page-section">

    @if (Entry == null || Gardens == null)
    {
        <LoadingSpinner Message="Loading journal entry..." />
    }
    else
    {
        @if (IsDeleted)
        {
            <LoadingSpinner Message="Deleting..." />
        }
        else
        {
            <JournalEntryForm Entry="Entry"
                              Gardens="Gardens"
                              SubmitLabel="Save"
                              OnSubmitCallback="HandleSubmitAsync"
                              OnCancelCallback="GoBack"
                              OnDeleteCallback="DeleteEntryAsync"
                              ShowDelete="true"
                              IsDisabled="IsDeleted" />
        }
    }

</div>

@code {
    [Parameter] public int Id { get; set; }

    private JournalEntryModel? Entry;
    private List<GardenModel>? Gardens;
    private string? ReturnUrl;
    private bool IsDeleted = false;

    protected override async Task OnInitializedAsync()
    {
        // Load entry
        Entry = await JournalEntryService.GetAsync(Id);

        if (Entry == null)
            return;

        // Force ownership
        Entry.UserId = Session.CurrentUserId!.Value;

        // Load user's gardens
        Gardens = await GardenService.GetByUserAsync(Session.CurrentUserId.Value);

        // Parse returnUrl
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("returnUrl", out var url))
            ReturnUrl = url!;
    }

    private async Task HandleSubmitAsync()
    {
        Entry!.UserId = Session.CurrentUserId!.Value;

        await JournalEntryService.UpdateAsync(Entry);

        if (!string.IsNullOrWhiteSpace(ReturnUrl))
            Nav.NavigateTo(ReturnUrl);
        else
            Nav.NavigateTo("/journalentries");
    }

    private void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
            Nav.NavigateTo(ReturnUrl);
        else
            Nav.NavigateTo("/journalentries");
    }

    private async Task DeleteEntryAsync()
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to delete this journal entry?"
        );

        if (!confirmed)
            return;

        await JournalEntryService.DeleteAsync(Entry!.JournalEntryId);

        IsDeleted = true;

        if (!string.IsNullOrWhiteSpace(ReturnUrl))
            Nav.NavigateTo(ReturnUrl, forceLoad: true);
        else
            Nav.NavigateTo("/journalentries", forceLoad: true);
    }
}
