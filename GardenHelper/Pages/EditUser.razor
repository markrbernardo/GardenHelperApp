@page "/users/edit/{Id:int}"

@inject UserService UserService
@inject NavigationManager Nav

<PageHeader Title="Edit User" />

<div class="page-section">

    @if (User == null)
    {
        <LoadingSpinner Message="Loading user..." />
    }
    else
    {
        <EditForm Model="@User"
                  OnValidSubmit="HandleSubmitAsync"
                  class="form-tile">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Name</label>
                <InputText class="form-control" @bind-Value="User.Name" />
            </div>

            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-success" type="submit">Save</button>
                <button class="btn btn-secondary" type="button" @onclick="GoBack">Cancel</button>
            </div>

        </EditForm>
    }

</div>

@code {
    [Parameter] public int Id { get; set; }

    private UserModel? User;

    protected override async Task OnInitializedAsync()
    {
        User = await UserService.GetAsync(Id);
    }

    private async Task HandleSubmitAsync()
    {
        await UserService.UpdateAsync(User!);
        Nav.NavigateTo("/users");
    }

    private void GoBack()
    {
        Nav.NavigateTo("/users");
    }
}
