@page "/plantinformation"
@page "/plantinformation/{plantId:int}"

@using GardenHelper.Components.Tiles

@inject PlantInformationService PlantInfoService
@inject PlantPhotoService PhotoService
@inject NavigationManager Nav


<PageHeader Title="Plant Information">
    <Actions>
        <button class="btn btn-primary" @onclick="CreateInfo">
            <i class="bi bi-plus-lg"></i> Add Info Card
        </button>
    </Actions>
</PageHeader>

@if (allInfo == null || allInfo.Count == 0)
{
    <p>No plant information available.</p>
}
else
{
    <!-- MOBILE DROPDOWN -->
    <div class="d-md-none mb-3">
        <label class="form-label fw-bold">Select Plant</label>
        <select class="form-select" @onchange="OnMobileSelect">
            <option value="">-- Choose a plant --</option>

            @foreach (var pi in allInfo)
            {
                <option value="@pi.PlantInformationId"
                        selected="@(selectedId == pi.PlantInformationId)">
                    @pi.CommonName (@pi.ScientificName)
                </option>
            }
        </select>

        <button class="btn btn-primary mt-2" @onclick="CreateInfo">
            <i class="bi bi-plus-lg"></i> Add Info Card
        </button>
    </div>

    <!-- DESKTOP LAYOUT -->

        <TwoColumnLayout>
            <Left>
                <ScrollColumn>
                    @foreach (var pi in allInfo)
                    {
                    <PlantInfoNametagTile Info="pi"
                                          Selected="(selectedId == pi.PlantInformationId)"
                                          OnSelect="@(info => SelectPlant(info.PlantInformationId))" />

                    }
                </ScrollColumn>
            </Left>

            <Right>
                @if (selectedId == null)
                {
                    <p class="text-muted">Select a plant to view its information.</p>
                }
                else if (info != null)
                {
                    <ScrollColumn>
                        <PlantInfoDetailsTile Info="@info" />

                        <SectionHeader Title="Photo Gallery" />
                        <PlantPhotoGallery Photos="@photos" />
                    </ScrollColumn>
                }
            </Right>
        </TwoColumnLayout>
}


@code {
    [Parameter] public int? plantId { get; set; }

    int? selectedId = null;
    PlantInformationModel? info;
    List<PlantPhotoModel> photos = new();
    List<PlantInformationModel> allInfo = new();

    protected override async Task OnInitializedAsync()
    {
        allInfo = await PlantInfoService.GetAll();

        // Auto-select when returning from edit
        if (plantId != null)
        {
            await SelectPlant(plantId.Value);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Refresh when navigating back with a plantId
        if (plantId != null)
        {
            allInfo = await PlantInfoService.GetAll();
            await SelectPlant(plantId.Value);
        }
    }

    private async Task SelectPlant(int id)
    {
        selectedId = id;
        info = await PlantInfoService.GetById(id);
        photos = await PhotoService.GetPhotosForPlant(id);

        // Update URL without reloading page
        Nav.NavigateTo($"/plantinformation/{id}", replace: true);
    }

    private async Task OnMobileSelect(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            await SelectPlant(id);
        }
    }

    void CreateInfo()
    {
        Nav.NavigateTo("/plantinformation/create");
    }
}
