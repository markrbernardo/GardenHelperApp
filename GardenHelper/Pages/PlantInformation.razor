@page "/plantinformation"
@page "/plantinformation/{PlantId:int}"

@using GardenHelper.Components.Tiles

@inject PlantInformationService PlantInfoService
@inject PlantService PlantService
@inject PlantPhotoService PhotoService
@inject NavigationManager Nav

<PageHeader Title="Plant Information" Divider="false">
    <Actions>
        <button class="btn btn-primary" @onclick="CreateInfo">
            <i class="bi bi-plus-lg"></i> Create New Info Card
        </button>
    </Actions>
</PageHeader>

<div class="page-section">

    @if (InfoList == null)
    {
        <LoadingSpinner Message="Loading plant information..." />
    }
    else if (InfoList.Count == 0)
    {
        <EmptyState Message="No plant information available." />
    }
    else
    {
        <!-- MOBILE DROPDOWN -->
        <div class="d-md-none mb-3">
            <label class="form-label fw-bold">Select Plant</label>

            <select class="form-select" @onchange="OnMobileSelect">
                <option value="">-- Choose a plant --</option>

                @foreach (var pi in InfoList)
                {
                    <option value="@pi.PlantInformationId"
                            selected="@(SelectedId == pi.PlantInformationId)">
                        @pi.CommonName (@pi.ScientificName)
                    </option>
                }
            </select>
        </div>

        <!-- DESKTOP LAYOUT -->
        <TwoColumnLayout FullHeight="true">
            <Left>
                <ScrollColumn HideScrollbar="true" Height="100%">
                    @foreach (var pi in InfoList)
                    {
                        <PlantInfoNametagTile Info="pi"
                                              Selected="(SelectedId == pi.PlantInformationId)"
                                              OnSelect="@(info => SelectPlantAsync(info.PlantInformationId))" />
                    }
                </ScrollColumn>
            </Left>

            <Right>
                <ScrollColumn>
                    <!-- ALWAYS render the tile so it can show its empty state -->
                    <PlantInfoDetailsTile Plant="@SelectedInfo" />

                    @if (SelectedInfo != null)
                    {
                        <SectionHeader Title="Photo Gallery" />
                        <PlantPhotoGallery Photos="@PhotoList" />
                    }
                </ScrollColumn>
            </Right>
        </TwoColumnLayout>
    }

</div>

@code {
    [Parameter] public int? PlantId { get; set; }

    private int? SelectedId;
    private PlantInformationModel? SelectedInfo;

    private List<PlantPhotoModel> PhotoList = new();
    private List<PlantInformationModel>? InfoList;

    protected override async Task OnInitializedAsync()
    {
        InfoList = await PlantInfoService.GetAllAsync();

        if (PlantId != null)
            await SelectPlantAsync(PlantId.Value);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (PlantId != null)
        {
            InfoList = await PlantInfoService.GetAllAsync();
            await SelectPlantAsync(PlantId.Value);
        }
    }

    private async Task SelectPlantAsync(int id)
    {
        SelectedId = id;
        SelectedInfo = await PlantInfoService.GetAsync(id);
        PhotoList = await PhotoService.GetByPlantAsync(id);
    }

    private async Task OnMobileSelect(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
            await SelectPlantAsync(id);
    }

    private void CreateInfo()
    {
        Nav.NavigateTo("/plantinformation/create");
    }
}
