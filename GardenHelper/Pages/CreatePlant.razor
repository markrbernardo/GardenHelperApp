@page "/plants/create"
@inject PlantService PlantService
@inject LocationService LocationService
@inject PlantInformationService PlantInfoService
@inject UserSessionService UserSession
@inject NavigationManager Nav

<h3>Create Plant</h3>

@if (locations == null || plantInfoList == null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="@plant" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Plant Name</label>
            <InputText class="form-control" @bind-Value="plant.Name" />
        </div>

        <div class="mb-3">
            <label>Plant Information</label>
            <select class="form-select" @bind="plant.PlantInformationId">
                @foreach (var info in plantInfoList)
                {
                    <option value="@info.PlantInformationId">
                        @info.CommonName (@info.ScientificName)
                    </option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label>Location</label>
            <select class="form-select" @bind="plant.LocationId">
                @foreach (var loc in locations)
                {
                    <option value="@loc.LocationId">@loc.Name</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <InputTextArea class="form-control" rows="3" @bind-Value="plant.Description" />
        </div>

        <div class="mb-3">
            <label class="form-label">Notes</label>
            <InputTextArea class="form-control" rows="3" @bind-Value="plant.Notes" />
        </div>



        <button class="btn btn-success">Create</button>
        <button class="btn btn-secondary" @onclick="GoBack">Cancel</button>
    </EditForm>
}

@code {
    [Parameter] public int? locationId { get; set; }

    PlantModel plant = new();

    List<LocationModel>? locations;
    List<PlantInformationModel>? plantInfoList;

    string? returnUrl;


    protected override async Task OnInitializedAsync()
    {
        var gardenId = UserSession.CurrentGardenId;

        if (gardenId == null)
        {
            Nav.NavigateTo("/gardens");
            return;
        }

        // Load locations
        locations = await LocationService.GetByGarden(gardenId.Value);

        // Set garden
        plant.GardenId = gardenId.Value;

        // Load plant info
        plantInfoList = await PlantInfoService.GetAll();
        if (plantInfoList.Count > 0)
            plant.PlantInformationId = plantInfoList.First().PlantInformationId;

        // Read query params
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        // locationId
        if (query.TryGetValue("locationId", out var locIdString) &&
            int.TryParse(locIdString, out int parsedId) &&
            locations.Any(l => l.LocationId == parsedId))
        {
            plant.LocationId = parsedId;
        }
        else if (locations.Count > 0)
        {
            plant.LocationId = locations.First().LocationId;
        }

        // returnUrl
        if (query.TryGetValue("returnUrl", out var url))
            returnUrl = url!;
    }



    async Task HandleSubmit()
    {
        var response = await PlantService.CreateWithResponse(plant);

        if (!response.IsSuccessStatusCode)
        {
            Console.WriteLine("Error creating plant: " + response.StatusCode);
            return;
        }

        if (!string.IsNullOrWhiteSpace(returnUrl))
            Nav.NavigateTo(returnUrl!);
        else
            Nav.NavigateTo("/plants");
    }

    void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(returnUrl))
            Nav.NavigateTo(returnUrl!);
        else
            Nav.NavigateTo("/plants");
    }

}
