@page "/plants/create"

@inject PlantService PlantService
@inject LocationService LocationService
@inject PlantInformationService PlantInfoService
@inject UserSessionService UserSession
@inject NavigationManager Nav

<PageHeader Title="Create Plant" />

<div class="page-section">

    @if (Locations == null || PlantInfoList == null)
    {
        <LoadingSpinner Message="Loading plant data..." />
    }
    else
    {
        <PlantForm Plant="Plant"
                   Locations="Locations"
                   PlantInfoList="PlantInfoList"
                   SubmitLabel="Create"
                   OnSubmitCallback="HandleSubmitAsync"
                   OnCancelCallback="GoBack"
                   ShowDelete="false" />
    }

</div>

@code {
    [Parameter] public int? LocationId { get; set; }

    private PlantModel Plant { get; set; } = new();
    private List<LocationModel>? Locations;
    private List<PlantInformationModel>? PlantInfoList;

    private string? ReturnUrl;

    protected override async Task OnInitializedAsync()
    {
        var gardenId = UserSession.CurrentGardenId;

        if (gardenId == null)
        {
            Nav.NavigateTo("/gardens");
            return;
        }

        // Load locations for this garden
        Locations = await LocationService.GetByGardenAsync(gardenId.Value);

        // Assign garden
        Plant.GardenId = gardenId.Value;

        // Load plant information list
        PlantInfoList = await PlantInfoService.GetAllAsync();

        if (PlantInfoList.Count > 0)
            Plant.PlantInformationId = PlantInfoList.First().PlantInformationId;

        // Parse query parameters
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        // locationId override
        if (query.TryGetValue("locationId", out var locIdString) &&
            int.TryParse(locIdString, out int parsedId) &&
            Locations.Any(l => l.LocationId == parsedId))
        {
            Plant.LocationId = parsedId;
        }
        else if (Locations.Count > 0)
        {
            Plant.LocationId = Locations.First().LocationId;
        }

        // returnUrl
        if (query.TryGetValue("returnUrl", out var url))
            ReturnUrl = url!;
    }

    private async Task HandleSubmitAsync()
    {
        var created = await PlantService.CreateAsync(Plant);

        if (created == null)
        {
            Console.WriteLine("Error creating plant.");
            return;
        }

        if (!string.IsNullOrWhiteSpace(ReturnUrl))
            Nav.NavigateTo(ReturnUrl);
        else
            Nav.NavigateTo($"/plants?plantId={created.PlantId}");
    }

    private void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
            Nav.NavigateTo(ReturnUrl);
        else
            Nav.NavigateTo("/plants");
    }
}
