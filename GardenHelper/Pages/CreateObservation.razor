@page "/observations/create"

@inject ObservationService ObservationService
@inject PlantService PlantService
@inject UserSessionService Session
@inject NavigationManager Nav

<PageHeader Title="Create Observation" />

<div class="page-section">

    @if (Plants == null)
    {
        <LoadingSpinner Message="Loading plants..." />
    }
    else
    {
        <ObservationForm Observation="Observation"
                         Plants="Plants"
                         SubmitLabel="Create"
                         OnSubmitCallback="HandleSubmitAsync"
                         OnCancelCallback="GoBack"
                         ShowDelete="false" />
    }

</div>

@code {
    private ObservationModel Observation { get; set; } = new();
    private List<PlantWithInfoDto>? Plants;
    private string? ReturnUrl;

    protected override async Task OnInitializedAsync()
    {
        // Load all plants
        Plants = await PlantService.GetAllAsync();

        // Assign logged-in user
        Observation.UserId = Session.CurrentUserId!.Value;

        // Default to first plant
        if (Plants.Count > 0)
            Observation.PlantId = Plants.First().PlantId;

        // Parse query parameters
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        // plantId override
        if (query.TryGetValue("plantId", out var pid) &&
            int.TryParse(pid, out int parsedId) &&
            Plants.Any(p => p.PlantId == parsedId))
        {
            Observation.PlantId = parsedId;
        }

        // returnUrl
        if (query.TryGetValue("returnUrl", out var url))
            ReturnUrl = url!;
    }

    private async Task HandleSubmitAsync()
    {
        Observation.UserId = Session.CurrentUserId!.Value;
        Observation.CreatedAt = DateTime.SpecifyKind(DateTime.Now, DateTimeKind.Local);

        await ObservationService.CreateAsync(Observation);

        if (!string.IsNullOrWhiteSpace(ReturnUrl))
            Nav.NavigateTo(ReturnUrl);
        else
            Nav.NavigateTo("/observations");
    }

    private void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
            Nav.NavigateTo(ReturnUrl);
        else
            Nav.NavigateTo("/observations");
    }
}
