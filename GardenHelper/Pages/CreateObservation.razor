@page "/observations/create"
@inject ObservationService ObservationService
@inject PlantService PlantService
@inject UserSessionService Session
@inject NavigationManager Nav

<h3>Create Observation</h3>

@if (plants == null)
{
    <p>Loading...</p>
}
else
{
    <ObservationForm Observation="observation"
                     Plants="plants"
                     SubmitLabel="Create"
                     OnSubmitCallback="HandleSubmit"
                     OnCancelCallback="GoBack"
                     ShowDelete="false" />

}

@code {
    ObservationModel observation = new();

    List<PlantWithInfoDto>? plants;

    string? returnUrl;

    protected override async Task OnInitializedAsync()
    {
        plants = await PlantService.GetAllPlants();

        observation.UserId = Session.CurrentUserId!.Value;

        if (plants.Count > 0)
            observation.PlantId = plants.First().PlantId;

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("plantId", out var pid) &&
            int.TryParse(pid, out int parsedId) &&
            plants.Any(p => p.PlantId == parsedId))
        {
            observation.PlantId = parsedId;
        }

        if (query.TryGetValue("returnUrl", out var url))
            returnUrl = url!;
    }

    async Task HandleSubmit()
    {
        observation.UserId = Session.CurrentUserId!.Value;

        await ObservationService.Create(observation);

        if (!string.IsNullOrWhiteSpace(returnUrl))
            Nav.NavigateTo(returnUrl!);
        else
            Nav.NavigateTo("/observations");
    }

    void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(returnUrl))
            Nav.NavigateTo(returnUrl!);
        else
            Nav.NavigateTo("/observations");
    }
}
