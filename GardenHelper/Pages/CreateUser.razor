@page "/users/create"

@inject UserService UserService
@inject NavigationManager Nav

<PageHeader Title="Create User" />

<div class="page-section">

    <EditForm Model="@User"
              OnValidSubmit="HandleSubmitAsync"
              class="form-tile">

        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Name</label>
            <InputText class="form-control" @bind-Value="User.Name" />
        </div>

        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-success" type="submit">Create</button>
            <button class="btn btn-secondary" type="button" @onclick="GoBack">Cancel</button>
        </div>

    </EditForm>

</div>

@code {
    private UserModel User { get; set; } = new();

    private async Task HandleSubmitAsync()
    {
        var created = await UserService.CreateAsync(User);

        if (created != null)
            Nav.NavigateTo("/users");
    }

    private void GoBack()
    {
        Nav.NavigateTo("/users");
    }
}
