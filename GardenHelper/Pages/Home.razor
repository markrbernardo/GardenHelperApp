@page "/home"
@using GardenHelperApp.Shared.Models
@inject ObservationService ObservationService
@inject JournalEntryService JournalEntryService
@inject GardenService GardenService
@inject PlantService PlantService
@inject UserSessionService Session
@inject NavigationManager Nav

<h3>Welcome back, @Session.CurrentUserName</h3>

<div class="dashboard-grid">

    <!-- GARDENS TILE -->
    @if (Session.CurrentGardenId != null)
    {
        <div class="dash-tile">
            <h4>My Garden: @defaultGarden?.Name</h4>

            @if (defaultGarden == null)
            {
                <p>Loading garden info…</p>
            }
            else
            {
                <ul>
                    <li><strong>Locations:</strong> @locationCount</li>
                    <li><strong>Plants:</strong> @plantCount</li>
                </ul>

                <button class="btn btn-sm btn-primary"
                        @onclick="@(() => Nav.NavigateTo($"/gardenprofile?gardenId={defaultGarden.GardenId}"))">
                    View Garden
                </button>
            }
        </div>
    }
    else
    {
        <div class="dash-tile">
            <h4>Your Gardens</h4>

            @if (gardens == null)
            {
                <p>Loading…</p>
            }
            else if (gardens.Count == 0)
            {
                <p>No gardens yet.</p>
            }
            else
            {
                <ul>
                    @foreach (var g in gardens)
                    {
                        <li style="cursor:pointer;"
                            @onclick="@(() => Nav.NavigateTo($"/locations?gardenId={g.GardenId}"))">
                            @g.Name
                        </li>
                    }
                </ul>
            }
        </div>
    }

    <!-- WEATHER PLACEHOLDER -->
    <div class="dash-tile">
        <h4>Weather</h4>
        <p class="placeholder">Weather feature coming soon…</p>
    </div>

    <!-- RECENT OBSERVATIONS -->
    <div class="dash-tile">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h4 class="mb-0">Recent Observations</h4>

            <button class="btn btn-sm btn-primary"
                    @onclick="@(() => Nav.NavigateTo("/observations/create?returnUrl=/home"))">
                Add
            </button>
        </div>

        @if (recentObservations == null)
        {
            <p>Loading…</p>
        }
        else if (recentObservations.Count == 0)
        {
            <p>No recent observations.</p>
        }
        else
        {
            <ul>
                @foreach (var o in recentObservations)
                {
                    <li class="obs-item"
                        @onclick="@(() => GoToObservation(o))">

                        <div class="obs-left">
                            <span class="obs-date">@o.CreatedAt.ToString("MMM dd")</span>
                            <span class="obs-time">@o.CreatedAt.ToString("h:mm tt")</span>
                        </div>

                        <div class="obs-middle">

                            <div class="obs-plant d-flex justify-content-between">
                                @GetPlantName(o.PlantId)
                            </div>

                            <div class="obs-meta">
                                @GetGardenName(o.PlantId) • @GetLocationName(o.PlantId)
                            </div>

                            <div class="obs-snippet">
                                @o.Observation
                            </div>

                        </div>
                        <div class="obs-right">
                            <span class="status-dot @(o.ActiveObservation ? "active" : "inactive")"></span>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>

    <!-- RECENT JOURNAL ENTRIES -->
    <div class="dash-tile">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h4 class="mb-0">Recent Journal Entries</h4>

            <button class="btn btn-sm btn-secondary"
                    @onclick="@(() => Nav.NavigateTo("/journalentries/create?returnUrl=/home"))">
                Add
            </button>
        </div>

        @if (recentJournals == null)
        {
            <p>Loading…</p>
        }
        else if (recentJournals.Count == 0)
        {
            <p>No recent journal entries.</p>
        }
        else
        {
            <ul>
                @foreach (var j in recentJournals)
                {
                    <li class="obs-item"
                        @onclick="@(() => Nav.NavigateTo($"/journalentries?entryId={j.JournalEntryId}"))">

                        <div class="obs-left">
                            <span class="obs-date">@j.CreatedAt.ToString("MMM dd")</span>
                            <span class="obs-time">@j.CreatedAt.ToString("h:mm tt")</span>
                        </div>

                        <div class="obs-middle">

                            <div class="obs-meta">
                                @GetJournalGardenName(j.GardenId)
                            </div>

                            <div class="obs-snippet">@j.Entry</div>

                        </div>
                    </li>
                }
            </ul>
        }
    </div>

</div>

@code {
    List<ObservationModel>? recentObservations;
    List<JournalEntryModel>? recentJournals;
    List<GardenModel>? gardens;
    List<PlantWithInfoDto>? plants;
    List<LocationModel>? locations;

    GardenModel? defaultGarden;
    int locationCount = 0;
    int plantCount = 0;

    protected override async Task OnInitializedAsync()
    {
        if (Session.CurrentUserId == null)
            return;

        gardens = await GardenService.GetGardensByUser(Session.CurrentUserId.Value);

        if (Session.CurrentGardenId != null)
        {
            defaultGarden = await GardenService.GetGarden(Session.CurrentGardenId.Value);

            if (defaultGarden != null)
            {
                var locs = await GardenService.GetLocationsByGarden(defaultGarden.GardenId);
                locationCount = locs.Count;

                var pls = await PlantService.GetPlantsByGarden(defaultGarden.GardenId);
                plantCount = pls.Count;
            }
        }

        recentObservations = (await ObservationService.GetByUser(Session.CurrentUserId.Value))?
            .OrderByDescending(o => o.ActiveObservation)
            .ThenByDescending(o => o.CreatedAt)
            .Take(5)
            .ToList();

        recentJournals = (await JournalEntryService.GetByUser(Session.CurrentUserId.Value))?
            .OrderByDescending(j => j.CreatedAt)
            .Take(5)
            .ToList();

        plants = await PlantService.GetAllPlants();
        locations = await GardenService.GetAllLocations();
    }

    async Task GoToObservation(ObservationModel o)
    {
        var plant = plants?.FirstOrDefault(p => p.PlantId == o.PlantId);

        if (plant != null)
        {
            await Session.SetGarden(plant.GardenId);
        }

        Nav.NavigateTo($"/observations?obsId={o.ObservationId}");
    }

    string GetPlantName(int plantId) =>
        plants?.FirstOrDefault(p => p.PlantId == plantId)?.CommonName ?? "Unknown";

    string GetGardenName(int plantId)
    {
        var plant = plants?.FirstOrDefault(p => p.PlantId == plantId);
        return gardens?.FirstOrDefault(g => g.GardenId == plant?.GardenId)?.Name ?? "Unknown";
    }

    string GetLocationName(int plantId)
    {
        var plant = plants?.FirstOrDefault(p => p.PlantId == plantId);
        var location = locations?.FirstOrDefault(l => l.LocationId == plant?.LocationId);
        return location?.Name ?? "Unknown";
    }

    string GetJournalGardenName(int gardenId)
    {
        return gardens?.FirstOrDefault(g => g.GardenId == gardenId)?.Name ?? "Unknown Garden";
    }
}
