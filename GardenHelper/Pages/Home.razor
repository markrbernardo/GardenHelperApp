@page "/home"

@using GardenHelperApp.Shared.Models

@inject ObservationService ObservationService
@inject JournalEntryService JournalEntryService
@inject GardenService GardenService
@inject PlantService PlantService
@inject LocationService LocationService
@inject UserSessionService Session
@inject NavigationManager Nav

<PageHeader Title=@($"Welcome back, {Session.CurrentUserName}!") Divider="false"/>

<div class="page-section">

    <div class="dashboard-grid">

        <!-- DEFAULT GARDEN TILE -->
        @if (Session.CurrentGardenId != null && DefaultGarden != null)
        {
            <div class="dash-tile card garden-hero-tile">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-tree-fill fs-3 me-2 garden-accent"></i>
                        <h2 class="mb-0">@DefaultGarden.Name</h2>
                    </div>

                    <div class="detail-item">
                        <div class="detail-label">
                            <i class="bi bi-geo me-1"></i> Zip Code: @DefaultGarden.ZipCode
                        </div>
                    </div>

                    <button class="btn btn-sm btn-outline-primary"
                            @onclick="@(() => Nav.NavigateTo($"/garden-profile/{DefaultGarden.GardenId}"))">
                        View Garden
                    </button>
                </div>

                <div class="d-flex gap-3">

                    <div class="mini-stat-card"
                         @onclick="@(() => Nav.NavigateTo($"/garden-profile/{DefaultGarden.GardenId}"))">
                        <div class="stat-label">Locations</div>
                        <div class="stat-value">@LocationCount</div>
                        <i class="bi bi-geo-alt stat-icon"></i>
                    </div>

                    <div class="mini-stat-card"
                         @onclick="@(() => Nav.NavigateTo($"/plants?gardenId={DefaultGarden.GardenId}"))">
                        <div class="stat-label">Plants</div>
                        <div class="stat-value">@PlantCount</div>
                        <i class="bi bi-flower3 stat-icon"></i>
                    </div>

                </div>

            </div>
        }
        else
        {
            <!-- FALLBACK: LIST OF GARDENS -->
            <div class="dash-tile card">
                <h4>Your Gardens</h4>

                @if (GardenList == null)
                {
                    <LoadingSpinner Message="Loading gardens..." />
                }
                else if (GardenList.Count == 0)
                {
                    <p>No gardens yet.</p>
                }
                else
                {
                    <ul class="list-unstyled">
                        @foreach (var g in GardenList)
                        {
                            <li class="clickable"
                                @onclick="@(() => Nav.NavigateTo($"/garden-profile/{g.GardenId}"))">
                                @g.Name
                            </li>
                        }
                    </ul>
                }
            </div>
        }

        <!-- WEATHER PLACEHOLDER -->
        <div class="dash-tile card">
            <h4>Weather</h4>
            <p class="placeholder">Weather feature coming soon…</p>
        </div>

        <!-- RECENT OBSERVATIONS -->
        <div class="dash-tile modern-tile">
            <div class="tile-header">
                <h4>Recent Observations</h4>

                <button class="btn-add"
                        @onclick="@(() => Nav.NavigateTo("/observations/create?returnUrl=/home"))">
                    + Add
                </button>
            </div>

            @if (RecentObservations == null)
            {
                <LoadingSpinner Message="Loading observations..." />
            }
            else if (RecentObservations.Count == 0)
            {
                <p class="placeholder">No recent observations.</p>
            }
            else
            {
                <ul class="obs-list">
                    @foreach (var o in RecentObservations)
                    {
                        <li class="obs-row"
                            @onclick="@(() => GoToObservationAsync(o))">

                            <div class="obs-date-block">
                                <span class="date">@o.CreatedAt.ToString("MMM dd")</span>
                                <span class="time">@o.CreatedAt.ToString("h:mm tt")</span>
                            </div>

                            <div class="obs-content">
                                <div class="plant">@GetPlantName(o.PlantId)</div>
                                <div class="meta">@GetGardenName(o.PlantId) • @GetLocationName(o.PlantId)</div>
                                <div class="snippet">@o.Observation</div>
                            </div>

                            <span class="status-dot @(o.ActiveObservation ? "active" : "inactive")"></span>
                        </li>
                    }
                </ul>
            }
        </div>

        <!-- RECENT JOURNAL ENTRIES -->
        <div class="dash-tile modern-tile">
            <div class="tile-header">
                <h4>Recent Journal Entries</h4>

                <button class="btn-add secondary"
                        @onclick="@(() => Nav.NavigateTo("/journalentries/create?returnUrl=/home"))">
                    + Add
                </button>
            </div>

            @if (RecentJournals == null)
            {
                <LoadingSpinner Message="Loading journal entries..." />
            }
            else if (RecentJournals.Count == 0)
            {
                <p class="placeholder">No recent journal entries.</p>
            }
            else
            {
                <ul class="obs-list">
                    @foreach (var j in RecentJournals)
                    {
                        <li class="obs-row"
                            @onclick="@(() => Nav.NavigateTo($"/journalentries?entryId={j.JournalEntryId}"))">

                            <div class="obs-date-block">
                                <span class="date">@j.CreatedAt.ToString("MMM dd")</span>
                                <span class="time">@j.CreatedAt.ToString("h:mm tt")</span>
                            </div>

                            <div class="obs-content">
                                <div class="title fw-semibold">@j.Title</div>
                                <div class="meta">@GetJournalGardenName(j.GardenId)</div>
                                <div class="snippet">@j.Entry</div>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>

    </div>

</div>

@code {
    private List<ObservationModel>? RecentObservations;
    private List<JournalEntryModel>? RecentJournals;
    private List<GardenModel>? GardenList;
    private List<PlantWithInfoDto>? PlantList;
    private List<LocationModel>? LocationList;

    private GardenModel? DefaultGarden;
    private int LocationCount = 0;
    private int PlantCount = 0;

    protected override async Task OnInitializedAsync()
    {
        if (Session.CurrentUserId == null)
            return;

        GardenList = await GardenService.GetByUserAsync(Session.CurrentUserId.Value);

        if (Session.CurrentGardenId != null)
        {
            DefaultGarden = await GardenService.GetAsync(Session.CurrentGardenId.Value);

            if (DefaultGarden == null)
            {
                await Session.ClearCurrentGardenAsync();
                return;
            }

            LocationList = await LocationService.GetByGardenAsync(DefaultGarden.GardenId);
            LocationCount = LocationList.Count;

            PlantList = await PlantService.GetByGardenAsync(DefaultGarden.GardenId);
            PlantCount = PlantList.Count;
        }

        RecentObservations = (await ObservationService.GetByUserAsync(Session.CurrentUserId.Value))?
            .OrderByDescending(o => o.ActiveObservation)
            .ThenByDescending(o => o.CreatedAt)
            .Take(4)
            .ToList();

        RecentJournals = (await JournalEntryService.GetByUserAsync(Session.CurrentUserId.Value))?
            .OrderByDescending(j => j.CreatedAt)
            .Take(4)
            .ToList();

        PlantList = await PlantService.GetAllAsync();
        LocationList = await LocationService.GetByGardenAsync(Session.CurrentGardenId ?? 0);
    }

    private async Task GoToObservationAsync(ObservationModel o)
    {
        var plant = PlantList?.FirstOrDefault(p => p.PlantId == o.PlantId);

        if (plant != null)
            await Session.SetGardenAsync(plant.GardenId);

        Nav.NavigateTo($"/observations?obsId={o.ObservationId}");
    }

    private string GetPlantName(int plantId) =>
        PlantList?.FirstOrDefault(p => p.PlantId == plantId)?.CommonName ?? "Unknown";

    private string GetGardenName(int plantId)
    {
        var plant = PlantList?.FirstOrDefault(p => p.PlantId == plantId);
        return GardenList?.FirstOrDefault(g => g.GardenId == plant?.GardenId)?.Name ?? "Unknown";
    }

    private string GetLocationName(int plantId)
    {
        var plant = PlantList?.FirstOrDefault(p => p.PlantId == plantId);
        var loc = LocationList?.FirstOrDefault(l => l.LocationId == plant?.LocationId);
        return loc?.Name ?? "Unknown";
    }

    private string GetJournalGardenName(int gardenId) =>
        GardenList?.FirstOrDefault(g => g.GardenId == gardenId)?.Name ?? "Unknown Garden";
}
