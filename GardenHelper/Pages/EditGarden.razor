@page "/gardens/edit/{id:int}"
@page "/gardens/edit/{id:int}/{*returnUrl}"

@inject GardenService GardenService
@inject UserService UserService
@inject UserSessionService Session
@inject NavigationManager Nav
@inject IJSRuntime JS


<h3>Edit Garden</h3>

@if (garden == null || users == null)
{
    <p>Loading...</p>
}
else
{
    @if (users == null || garden == null)
    {
        <p>Loading...</p>
    }
    else
    {
        <GardenForm Garden="garden"
                    Users="users"
                    SubmitLabel="Save Changes"
                    OnSubmitCallback="HandleSubmit"
                    OnCancelCallback="GoBack" />
        <button class="btn btn-danger mt-3"
                @onclick="ConfirmDelete">
            Delete Garden
        </button>

    }

}

@code {
    [Parameter] public int id { get; set; }
    [Parameter] public string? returnUrl { get; set; }

    GardenModel? garden;
    List<UserModel>? users;

    protected override async Task OnInitializedAsync()
    {
        garden = await GardenService.GetGarden(id);
        users = await UserService.GetUsers();
    }

    async Task HandleSubmit()
    {
        await GardenService.UpdateGarden(garden!);

        // Always go to the updated garden's profile
        Nav.NavigateTo($"/garden-profile/{garden!.GardenId}");
    }

    void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(returnUrl))
            Nav.NavigateTo(returnUrl);
        else
            Nav.NavigateTo($"/garden-profile/{garden!.GardenId}");
    }

    private async Task ConfirmDelete()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Are you sure you want to delete '{garden.Name}'? This cannot be undone.");

        if (!confirmed)
            return;

        await GardenService.DeleteGarden(garden.GardenId);

        // If this was the default garden, clear it
        await Session.ClearCurrentGarden();

        Nav.NavigateTo("/gardens");
    }


}
