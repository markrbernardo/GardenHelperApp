@page "/gardens/edit/{Id:int}"
@page "/gardens/edit/{Id:int}/{*ReturnUrl}"

@inject GardenService GardenService
@inject UserService UserService
@inject UserSessionService Session
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageHeader Title="Edit Garden" />

<div class="page-section">

    @if (Garden == null || Users == null)
    {
        <LoadingSpinner Message="Loading garden..." />
    }
    else
    {
        <GardenForm Garden="Garden"
                    Users="Users"
                    SubmitLabel="Save Changes"
                    OnSubmitCallback="HandleSubmitAsync"
                    OnCancelCallback="GoBack"
                    ShowDelete="false" />

        <button class="btn btn-danger mt-3"
                @onclick="ConfirmDeleteAsync">
            Delete Garden
        </button>
    }

</div>

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string? ReturnUrl { get; set; }

    private GardenModel? Garden;
    private List<UserModel>? Users;

    protected override async Task OnInitializedAsync()
    {
        Garden = await GardenService.GetAsync(Id);
        Users = await UserService.GetAllAsync();
    }

    private async Task HandleSubmitAsync()
    {
        await GardenService.UpdateAsync(Garden!);

        // Always redirect to the updated garden profile
        Nav.NavigateTo($"/garden-profile/{Garden!.GardenId}");
    }

    private void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
            Nav.NavigateTo(ReturnUrl);
        else
            Nav.NavigateTo($"/garden-profile/{Garden!.GardenId}");
    }

    private async Task ConfirmDeleteAsync()
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to delete '{Garden!.Name}'? This cannot be undone."
        );

        if (!confirmed)
            return;

        await GardenService.DeleteAsync(Garden!.GardenId);

        // If this was the current garden, clear it
        if (Session.CurrentGardenId == Garden.GardenId)
            await Session.ClearCurrentGardenAsync();

        Nav.NavigateTo("/gardens");
    }
}
