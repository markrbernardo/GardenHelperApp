@page "/gardens/edit/{id:int}"
@page "/gardens/edit/{id:int}/{*returnUrl}"

@inject GardenService GardenService
@inject UserService UserService
@inject NavigationManager Nav
@inject IJSRuntime JS


<h3>Edit Garden</h3>

@if (garden == null || users == null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="@garden" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <!-- USER -->
        <div class="mb-3">
            <label class="form-label">User</label>
            <select class="form-select" @bind="garden.UserId">
                @foreach (var u in users)
                {
                    <option value="@u.UserId">@u.Name</option>
                }
            </select>
        </div>

        <!-- NAME -->
        <div class="mb-3">
            <label class="form-label">Garden Name</label>
            <InputText class="form-control" @bind-Value="garden.Name" />
        </div>

        <!-- ZIP -->
        <div class="mb-3">
            <label class="form-label">Zip Code</label>
            <InputNumber class="form-control" @bind-Value="garden.ZipCode" />
        </div>

        <!-- NEW FIELDS -->
        <div class="mb-3">
            <label class="form-label">Hardiness Zone</label>
            <InputText class="form-control" @bind-Value="garden.HardinessZone" />
        </div>

        <div class="mb-3">
            <label class="form-label">Heat Zone</label>
            <InputText class="form-control" @bind-Value="garden.HeatZone" />
        </div>

        <div class="mb-3">
            <label class="form-label">Wind Orientation</label>
            <InputText class="form-control" @bind-Value="garden.WindOrientation" />
        </div>

        <div class="mb-3">
            <label class="form-label">Soil Type</label>
            <InputText class="form-control" @bind-Value="garden.SoilType" />
        </div>

        <div class="mb-3">
            <label class="form-label">Marine Influence</label>
            <InputText class="form-control" @bind-Value="garden.MarineInfluence" />
        </div>

        <!-- BUTTONS -->
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-success" type="submit">Save</button>
            <button class="btn btn-secondary" type="button" @onclick="GoBack">Cancel</button>

            <button class="btn btn-danger ms-auto" type="button" @onclick="ConfirmDelete">
                <i class="bi bi-trash"></i> Delete
            </button>
        </div>

    </EditForm>
}

@code {
    [Parameter] public int id { get; set; }
    [Parameter] public string? returnUrl { get; set; }

    GardenModel? garden;
    List<UserModel>? users;

    protected override async Task OnInitializedAsync()
    {
        garden = await GardenService.GetGarden(id);
        users = await UserService.GetUsers();
    }

    async Task HandleSubmit()
    {
        await GardenService.UpdateGarden(garden!);

        // Always go to the updated garden's profile
        Nav.NavigateTo($"/garden-profile/{garden!.GardenId}");
    }

    void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(returnUrl))
            Nav.NavigateTo(returnUrl);
        else
            Nav.NavigateTo($"/garden-profile/{garden!.GardenId}");
    }

    private async Task ConfirmDelete()
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Are you sure you want to delete the garden \"{garden!.Name}\"?");

        if (!confirmed)
            return;

        await GardenService.DeleteGarden(garden!.GardenId);

        // If returnUrl exists, go back there
        if (!string.IsNullOrWhiteSpace(returnUrl))
        {
            Nav.NavigateTo(returnUrl);
            return;
        }

        // Otherwise go to the gardens list for that user
        Nav.NavigateTo($"/gardens?userId={garden!.UserId}");
    }

}
