@page "/gardens/create/{UserId:int}"
@page "/gardens/create/{UserId:int}/{*ReturnUrl}"

@inject GardenService GardenService
@inject UserService UserService
@inject NavigationManager Nav

<PageHeader Title="Create Garden" />

<div class="page-section">

    @if (Users == null)
    {
        <LoadingSpinner Message="Loading users..." />
    }
    else
    {
        <GardenForm Garden="Garden"
                    Users="Users"
                    SubmitLabel="Create"
                    OnSubmitCallback="HandleSubmitAsync"
                    OnCancelCallback="GoBack" />
    }

</div>

@code {
    [Parameter] public int UserId { get; set; }
    [Parameter] public string? ReturnUrl { get; set; }

    private GardenModel Garden { get; set; } = new();
    private List<UserModel>? Users;

    protected override async Task OnInitializedAsync()
    {
        // ✔ Correct method name
        Users = await UserService.GetAllAsync();
        Garden.UserId = UserId;
    }

    private async Task HandleSubmitAsync()
    {
        var created = await GardenService.CreateAsync(Garden);

        if (created != null)
            Nav.NavigateTo($"/garden-profile/{created.GardenId}");
    }

    private void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
            Nav.NavigateTo(ReturnUrl);
        else
            Nav.NavigateTo($"/gardens?userId={Garden.UserId}");
    }
}
