@page "/gardens/create/{userId:int}"
@page "/gardens/create/{userId:int}/{*returnUrl}"

@inject GardenService GardenService
@inject UserService UserService
@inject NavigationManager Nav

<h3>Create Garden</h3>

@if (users == null)
{
    <p>Loading...</p>
}
else
{
    @if (users == null)
    {
        <p>Loading...</p>
    }
    else
    {
        <GardenForm Garden="garden"
                    Users="users"
                    SubmitLabel="Create"
                    OnSubmitCallback="HandleSubmit"
                    OnCancelCallback="GoBack" />
    }

}

@code {
    [Parameter] public int userId { get; set; }
    [Parameter] public string? returnUrl { get; set; }


    GardenModel garden = new();
    List<UserModel>? users;

    protected override async Task OnInitializedAsync()
    {
        users = await UserService.GetUsers();
        garden.UserId = userId;
    }

    async Task HandleSubmit()
    {
        var created = await GardenService.CreateGardenWithReturn(garden);
        Nav.NavigateTo($"/garden-profile/{created.GardenId}");
    }


    void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(returnUrl))
            Nav.NavigateTo(returnUrl);
        else
            Nav.NavigateTo($"/gardens?userId={garden.UserId}");
    }

}
