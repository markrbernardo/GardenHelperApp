@page "/users"

@inject UserService UserService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageHeader Title="Users">
    <Actions>
        <button class="btn btn-primary"
                @onclick="@(() => Nav.NavigateTo("/users/create"))">
            <i class="bi bi-plus-lg"></i> Create User
        </button>
    </Actions>
</PageHeader>

<div class="page-section">

    @if (UserList == null)
    {
        <LoadingSpinner Message="Loading users..." />
    }
    else if (UserList.Count == 0)
    {
        <EmptyState Message="No users found." />
    }
    else
    {
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>User ID</th>
                    <th>Name</th>
                    <th style="width: 160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in UserList)
                {
                    <tr>
                        <td>@user.UserId</td>
                        <td>@user.Name</td>
                        <td>
                            <div class="d-flex gap-2">
                                <button class="btn btn-primary btn-sm"
                                        @onclick="() => EditUser(user.UserId)">
                                    Edit
                                </button>

                                <button class="btn btn-danger btn-sm"
                                        @onclick="() => DeleteUserAsync(user.UserId)">
                                    Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

</div>

@code {
    private List<UserModel>? UserList;

    protected override async Task OnInitializedAsync()
    {
        UserList = await UserService.GetAllAsync();
    }

    private void EditUser(int id)
    {
        Nav.NavigateTo($"/users/edit/{id}");
    }

    private async Task DeleteUserAsync(int id)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this user?");
        if (!confirm)
            return;

        await UserService.DeleteAsync(id);
        UserList = await UserService.GetAllAsync();
    }
}
