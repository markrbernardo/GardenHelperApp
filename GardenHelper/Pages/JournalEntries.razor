@page "/journalentries"

@using Microsoft.AspNetCore.WebUtilities

@inject JournalEntryService JournalEntryService
@inject GardenService GardenService
@inject PlantService PlantService
@inject PlantInformationService PlantInformationService
@inject ObservationService ObservationService
@inject UserSessionService Session
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageHeader Title="Journal" Divider="false">
    <Actions>
        <button class="btn btn-primary" @onclick="CreateEntry">
            <i class="bi bi-plus-lg"></i> Create New Journal Entry
        </button>
    </Actions>
</PageHeader>

<div class="page-section">

    @if (Entries == null || GardenList == null || Observations == null || PlantList == null || PlantInfoList == null)
    {
        <LoadingSpinner Message="Loading journal entries..." />
    }
    else if (Entries.Count == 0)
    {
        <EmptyState Message="No journal entries found." />
    }
    else
    {
        <!-- MOBILE DROPDOWN -->
        <div class="d-md-none mb-3">
            <select class="form-select" @onchange="OnMobileDateChange">
                <option value="">Select a date...</option>
                @foreach (var group in GroupedEntries)
                {
                    var obsCount = ObservationCounts.TryGetValue(group.Key, out var c) ? c : 0;

                    <option value="@group.Key.ToString("yyyy-MM-dd")">
                        @group.Key.ToString("MMM dd, yyyy") (@group.Count() entries, @obsCount observations)
                    </option>
                }
            </select>
        </div>

        <!-- MOBILE DETAILS -->
        <div class="d-md-none mt-3">
            <JournalEntryDetailsTile SelectedDate="SelectedDate"
                                     Entries="FilteredEntries"
                                     Observations="Observations"
                                     Gardens="GardenList"
                                     Plants="PlantList"
                                     OnEdit="EditEntry" />
        </div>

        <!-- DESKTOP LAYOUT -->
        <div class="d-none d-md-block">
            <TwoColumnLayout>
                <Left>
                    <ScrollColumn>

                        @foreach (var group in GroupedEntries)
                        {
                            var obsCount = ObservationCounts.TryGetValue(group.Key, out var c) ? c : 0;

                            <DateTile Date="group.Key"
                                      Count="group.Count()"
                                      SecondaryCount="@obsCount"
                                      Label="entry"
                                      SecondaryLabel="observation"
                                      Selected="(SelectedDate == group.Key)"
                                      OnSelect="SelectDate" />
                        }
                    </ScrollColumn>
                </Left>

                <Right>
                    <ScrollColumn CssClass="pt-0">
                        <JournalEntryDetailsTile SelectedDate="SelectedDate"
                                                 Entries="FilteredEntries"
                                                 Observations="Observations"
                                                 Gardens="GardenList"
                                                 Plants="PlantList"
                                                 OnEdit="EditEntry" />
                    </ScrollColumn>
                </Right>
            </TwoColumnLayout>
        </div>
    }

</div>

@code {
    private List<JournalEntryModel>? Entries;
    private List<GardenModel>? GardenList;
    private List<ObservationModel>? Observations;

    private List<PlantWithInfoDto>? PlantList;
    private List<PlantInformationModel>? PlantInfoList;

    private Dictionary<DateTime, int> ObservationCounts = new();

    private List<IGrouping<DateTime, JournalEntryModel>> GroupedEntries = new();
    private List<JournalEntryModel> FilteredEntries = new();

    private DateTime? SelectedDate;

    protected override async Task OnInitializedAsync()
    {
        if (Session.CurrentUserId == null)
            return;

        Entries = await JournalEntryService.GetByUserAsync(Session.CurrentUserId.Value);
        GardenList = await GardenService.GetByUserAsync(Session.CurrentUserId.Value);
        Observations = await ObservationService.GetByUserAsync(Session.CurrentUserId.Value);

        PlantList = await PlantService.GetAllAsync();
        PlantInfoList = await PlantInformationService.GetAllAsync();

        // Group entries by date
        GroupedEntries = Entries
            .GroupBy(e => e.CreatedAt.Date)
            .OrderByDescending(g => g.Key)
            .ToList();

        // Group observations by date
        ObservationCounts = Observations
            .GroupBy(o => o.CreatedAt.Date)
            .ToDictionary(g => g.Key, g => g.Count());

        // Pre-select based on ?entryId=
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("entryId", out var val) && int.TryParse(val, out var entryId))
        {
            var entry = Entries.FirstOrDefault(e => e.JournalEntryId == entryId);
            if (entry != null)
                SelectedDate = entry.CreatedAt.Date;
        }

        if (SelectedDate == null && GroupedEntries.Any())
            SelectedDate = GroupedEntries.First().Key;

        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (SelectedDate == null)
        {
            FilteredEntries = new();
            return;
        }

        FilteredEntries = Entries
            .Where(e => e.CreatedAt.Date == SelectedDate.Value.Date)
            .OrderByDescending(e => e.CreatedAt)
            .ToList();
    }

    private void SelectDate(DateTime date)
    {
        SelectedDate = date;
        ApplyFilter();
    }

    private void OnMobileDateChange(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            SelectedDate = date;
            ApplyFilter();
        }
    }

    private void EditEntry(int id)
    {
        Nav.NavigateTo($"/journalentries/edit/{id}?returnUrl=/journalentries");
    }

    private void CreateEntry()
    {
        Nav.NavigateTo("/journalentries/create");
    }

    private async Task DeleteEntryAsync(int id)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "Delete this journal entry?");
        if (!confirm)
            return;

        await JournalEntryService.DeleteAsync(id);

        Entries = await JournalEntryService.GetByUserAsync(Session.CurrentUserId!.Value);

        GroupedEntries = Entries
            .GroupBy(e => e.CreatedAt.Date)
            .OrderByDescending(g => g.Key)
            .ToList();

        if (GroupedEntries.Any())
            SelectedDate = GroupedEntries.First().Key;

        ApplyFilter();
    }
}
