@page "/journalentries"
@using Microsoft.AspNetCore.WebUtilities
@inject JournalEntryService JournalEntryService
@inject GardenService GardenService
@inject UserSessionService Session
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageHeader Title="Journal" />

@if (entries == null || gardens == null)
{
    <p>Loading...</p>
}
else if (entries.Count == 0)
{
    <p>No journal entries found.</p>
}
else
{
    <!-- MOBILE DROPDOWN -->
    <div class="d-md-none mb-3">
        <select class="form-select" @onchange="OnMobileDateChange">
            <option value="">Select a date...</option>
            @foreach (var group in groupedEntries)
            {
                <option value="@group.Key.ToString("yyyy-MM-dd")">
                    @group.Key.ToString("MMM dd, yyyy") (@group.Count())
                </option>
            }
        </select>
    </div>

    <!-- MOBILE DETAILS -->
    <div class="d-md-none mt-3">
        <JournalEntryDetailsTile SelectedDate="selectedDate"
                             Entries="filteredEntries"
                             Gardens="gardens"
                             OnEdit="EditEntry" />
    </div>

    <!-- DESKTOP LAYOUT -->
    <div class="d-none d-md-block">
        <TwoColumnLayout>
            <Left>
                <ScrollColumn>
                    <h3 class="mb-3">Dates</h3>

                    @foreach (var group in groupedEntries)
                    {
                        <DateTile Date="group.Key"
                                  Count="group.Count()"
                                  Label="entry"
                                  Selected="(selectedDate == group.Key)"
                                  OnSelect="SelectDate" />

                    }
                </ScrollColumn>
            </Left>

            <Right>
                <ScrollColumn>
                    <h3 class="pb-2">Entry</h3>

                    <JournalEntryDetailsTile SelectedDate="selectedDate"
                                         Entries="filteredEntries"
                                         Gardens="gardens"
                                         OnEdit="EditEntry" />
                </ScrollColumn>
            </Right>
        </TwoColumnLayout>
    </div>
}


@code {
    List<JournalEntryModel>? entries;
    List<GardenModel>? gardens;

    List<IGrouping<DateTime, JournalEntryModel>> groupedEntries = new();
    List<JournalEntryModel> filteredEntries = new();

    DateTime? selectedDate;

    protected override async Task OnInitializedAsync()
    {
        entries = await JournalEntryService.GetByUser(Session.CurrentUserId!.Value);
        gardens = await GardenService.GetGardensByUser(Session.CurrentUserId.Value);

        groupedEntries = entries
            .GroupBy(e => e.CreatedAt.Date)
            .OrderByDescending(g => g.Key)
            .ToList();

        // check querystring for entryId to pre-select
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("entryId", out var val) && int.TryParse(val, out var entryId))
        {
            var entry = entries.FirstOrDefault(e => e.JournalEntryId == entryId);
            if (entry != null)
                selectedDate = entry.CreatedAt.Date;
        }

        if (selectedDate == null && groupedEntries.Any())
            selectedDate = groupedEntries.First().Key;

        ApplyFilter();
    }

    void ApplyFilter()
    {
        if (selectedDate == null)
        {
            filteredEntries = new();
            return;
        }

        filteredEntries = entries
            .Where(e => e.CreatedAt.Date == selectedDate.Value.Date)
            .ToList();
    }

    void SelectDate(DateTime date)
    {
        selectedDate = date;
        ApplyFilter();
    }

    void OnMobileDateChange(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            selectedDate = date;
            ApplyFilter();
        }
    }

    string GetGardenName(int gardenId)
    {
        return gardens?.FirstOrDefault(g => g.GardenId == gardenId)?.Name ?? "Unknown Garden";
    }

    void EditEntry(int id)
    {
        Nav.NavigateTo($"/journalentries/edit/{id}?returnUrl=/journalentries");
    }

    async Task DeleteEntry(int id)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "Delete this journal entry?");
        if (!confirm) return;

        await JournalEntryService.Delete(id);

        entries = await JournalEntryService.GetByUser(Session.CurrentUserId!.Value);

        groupedEntries = entries
            .GroupBy(e => e.CreatedAt.Date)
            .OrderByDescending(g => g.Key)
            .ToList();

        if (groupedEntries.Any())
            selectedDate = groupedEntries.First().Key;

        ApplyFilter();
    }
}
