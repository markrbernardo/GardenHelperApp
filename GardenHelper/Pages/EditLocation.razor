@page "/locations/edit/{Id:int}"

@inject LocationService LocationService
@inject NavigationManager Nav
@inject UserSessionService Session
@inject IJSRuntime JS

<PageHeader Title="Edit Location" />

<div class="page-section">

    @if (IsDeleted)
    {
        <LoadingSpinner Message="Deleting..." />
    }
    else if (Location == null)
    {
        <LoadingSpinner Message="Loading location..." />
    }
    else
    {
        <LocationForm Location="Location"
                      SubmitLabel="Save"
                      OnSubmitCallback="HandleSubmitAsync"
                      OnCancelCallback="GoBack"
                      OnDeleteCallback="DeleteLocationAsync"
                      ShowDelete="true"
                      IsDisabled="IsDeleted" />
    }

</div>

@code {
    [Parameter] public int Id { get; set; }

    private LocationModel? Location;
    private bool IsDeleted = false;

    protected override async Task OnInitializedAsync()
    {
        Location = await LocationService.GetAsync(Id);

        if (Location == null)
        {
            Nav.NavigateTo("/not-found");
            return;
        }
    }

    private async Task HandleSubmitAsync()
    {
        await LocationService.UpdateAsync(Location!);
        Nav.NavigateTo($"/location-profile/{Id}");
    }

    private void GoBack()
    {
        Nav.NavigateTo($"/location-profile/{Id}");
    }

    private async Task DeleteLocationAsync()
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to delete the location '{Location?.Name}'?"
        );

        if (!confirmed)
            return;

        await LocationService.DeleteAsync(Id);

        // Refresh session (NavMenu, etc.)
        await Session.InitializeAsync();

        IsDeleted = true;

        Nav.NavigateTo($"/garden-profile/{Location!.GardenId}", forceLoad: true);
    }
}
