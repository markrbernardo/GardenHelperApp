@page "/locations/edit/{id:int}"
@inject LocationService LocationService
@inject GardenService GardenService
@inject NavigationManager Nav
@inject UserSessionService UserSessionService
@inject IJSRuntime JS

<h3>Edit Location</h3>


@if (isDeleted)
{
    <p>Redirecting...</p>
    return;
}

@if (location == null || gardens == null)
{
    <p>Loading...</p>
}
else
{
    <LocationForm Location="location"
                  Gardens="gardens"
                  SubmitLabel="Save"
                  OnSubmitCallback="HandleSubmit"
                  OnCancelCallback="GoBack"
                  OnDeleteCallback="DeleteLocation"
                  ShowDelete="true"
                  IsDisabled="isDeleted" />


}
@if (isDeleted)
{
    <p>Deleting...</p>
    return;
}


@code {
    [Parameter] public int id { get; set; }
    [Parameter] public bool IsDisabled { get; set; }
    bool isDeleted = false;


    LocationModel? location;
    List<GardenModel>? gardens;

    protected override async Task OnInitializedAsync()
    {
        gardens = await GardenService.GetAllGardens();
        location = await LocationService.Get(id);

        if (location == null)
        {
            Nav.NavigateTo("/not-found");
            return;
        }
    }

    async Task HandleSubmit()
    {
        await LocationService.Update(location!);
        Nav.NavigateTo($"/location-profile/{id}");
    }

    void GoBack()
    {
        Nav.NavigateTo($"/location-profile/{id}");
    }

    async Task DeleteLocation()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Are you sure you want to delete the location '{location?.Name}'?");

        if (!confirmed)
            return;

        await LocationService.Delete(id);
        await UserSessionService.TriggerChange();

        isDeleted = true; // ← stop the form from rendering

        Nav.NavigateTo($"/garden-profile/{location.GardenId}", forceLoad: true);
    }



}
