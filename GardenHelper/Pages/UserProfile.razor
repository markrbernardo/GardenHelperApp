@page "/user-profile"

@inject UserSessionService Session
@inject GardenService GardenService
@inject NavigationManager Nav

<PageHeader Title="User Profile" />

<div class="page-section">

    @if (Session.CurrentUserId == null)
    {
        <EmptyState Message="You are not logged in." />
    }
    else
    {
        <div class="card p-4 shadow-sm">

            <h4 class="mb-3">User Information</h4>

            <div class="mb-3">
                <strong>Name:</strong> @Session.CurrentUserName
            </div>

            <h4 class="mt-4 mb-2">Default Garden</h4>

            @if (GardenList == null)
            {
                <LoadingSpinner Message="Loading gardens..." />
            }
            else if (GardenList.Count == 0)
            {
                <EmptyState Message="You have no gardens." />
            }
            else
            {
                <select class="form-select" @bind="SelectedDefaultGardenId">
                    @foreach (var g in GardenList)
                    {
                        <option value="@g.GardenId">@g.Name</option>
                    }
                </select>

                <button class="btn btn-primary mt-3" @onclick="SaveDefaultGardenAsync">
                    Save Default Garden
                </button>
            }
        </div>
    }

</div>

@code {
    private List<GardenModel>? GardenList;
    private int SelectedDefaultGardenId;

    protected override async Task OnInitializedAsync()
    {
        if (Session.CurrentUserId == null)
            return;

        GardenList = await GardenService.GetByUserAsync(Session.CurrentUserId.Value);

        if (GardenList.Any())
            SelectedDefaultGardenId = Session.DefaultGardenId ?? GardenList.First().GardenId;
    }

    private async Task SaveDefaultGardenAsync()
    {
        if (Session.CurrentUserId == null)
            return;

        await GardenService.SetDefaultGardenAsync(Session.CurrentUserId.Value, SelectedDefaultGardenId);
        await Session.SetDefaultGardenAsync(SelectedDefaultGardenId);
    }
}
