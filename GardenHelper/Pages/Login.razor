@layout EmptyLayout
@page "/login"

@inject UserService UserService
@inject UserSessionService Session
@inject NavigationManager Nav

<PageHeader Title="Select a User" Divider="false"/>

<div class="page-section">

    @if (UserList == null)
    {
        <LoadingSpinner Message="Loading users..." />
    }
    else if (UserList.Count == 0)
    {
        <EmptyState Message="No users found." />
    }
    else
    {
        <div class="user-grid">

            @foreach (var u in UserList)
            {
                <div class="user-tile" @onclick="@(() => SelectUserAsync(u))">
                    <div class="user-name">@u.Name</div>
                </div>
            }

            <div class="user-tile add-tile" @onclick="AddNewUser">
                <div class="add-symbol">+</div>
                <div>Add New User</div>
            </div>

        </div>
    }

</div>

@code {
    private List<UserModel>? UserList;

    protected override async Task OnInitializedAsync()
    {
        UserList = await UserService.GetAllAsync();
    }

    private async Task SelectUserAsync(UserModel user)
    {
        await Session.SetUserAsync(user.UserId, user.Name);
        Nav.NavigateTo("/home", replace: true);
    }

    private void AddNewUser()
    {
        Nav.NavigateTo("/users/create");
    }
}
