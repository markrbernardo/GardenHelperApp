@page "/garden-profile/{gardenId:int}"
@inject GardenService GardenService
@inject PlantService PlantService
@inject NavigationManager Nav

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0 border-bottom border-5 border-black">@garden?.Name</h1>

    @if (garden != null)
    {
        <button class="btn btn-outline-primary btn-sm"
            @onclick="@(() => Nav.NavigateTo($"/gardens/edit/{gardenId}?returnUrl=/garden-profile/{gardenId}"))">
            <i class="bi bi-pencil-square"></i> Edit Garden
        </button>
    }
</div>


@if (garden == null)
{
    <p>Loading garden...</p>
}
else
{
    <!-- GARDEN DETAILS -->
    <div class="px-3">
        <div class="row">

            <!-- LEFT COLUMN -->
            <div class="col-12 col-md-6">
                <p><strong>Zip Code:</strong> @garden.ZipCode</p>

                @if (!string.IsNullOrWhiteSpace(garden.HardinessZone))
                {
                    <p><strong>Hardiness Zone:</strong> @garden.HardinessZone</p>
                }

                @if (!string.IsNullOrWhiteSpace(garden.HeatZone))
                {
                    <p><strong>Heat Zone:</strong> @garden.HeatZone</p>
                }
            </div>

            <!-- RIGHT COLUMN -->
            <div class="col-12 col-md-6">
                @if (!string.IsNullOrWhiteSpace(garden.WindOrientation))
                {
                    <p><strong>Wind Orientation:</strong> @garden.WindOrientation</p>
                }

                @if (!string.IsNullOrWhiteSpace(garden.SoilType))
                {
                    <p><strong>Soil Type:</strong> @garden.SoilType</p>
                }

                @if (!string.IsNullOrWhiteSpace(garden.MarineInfluence))
                {
                    <p><strong>Marine Influence:</strong> @garden.MarineInfluence</p>
                }
            </div>

        </div>
    </div>


    <hr />

    <!-- LOCATIONS LIST (SCROLLABLE) -->
    <div class="gp-locations-container gp-locations-scroll">


        @if (locations == null)
        {
            <p>Loading locations...</p>
        }
        else if (locations.Count == 0)
        {
            <p>No locations yet.</p>
        }
        else
        {
            @foreach (var loc in locations)
            {
                <div class="gp-location-block card mb-3">

                    <div class="gp-location-header">
                        <div>
                            <h4 class="gp-location-title">@loc.Name</h4>
                            <div class="gp-location-sub">@loc.Lighting</div>
                        </div>

                        <button class="btn btn-sm btn-outline-success"
                                @onclick="@(() => Nav.NavigateTo($"/plants/create?locationId={loc.LocationId}&returnUrl=/garden-profile/{gardenId}"))">
                            <i class="bi bi-plus-lg"></i> Add Plant
                        </button>
                    </div>

                    @if (plants == null)
                    {
                        <p>Loading plants...</p>
                    }
                    else
                    {
                        var plantsInLoc = plants.Where(p => p.LocationId == loc.LocationId).ToList();

                        @if (plantsInLoc.Count == 0)
                        {
                            <p class="placeholder">No plants in this location.</p>
                        }
                        else
                        {
                            <div class="gp-plant-grid">
                                @foreach (var p in plantsInLoc)
                                {
                                    <PlantTile Plant="p"
                                               Selected="false"
                                               OnSelect="@(() => Nav.NavigateTo($"/plants?plantId={p.PlantId}"))" />
                                }
                            </div>
                        }
                    }

                </div>
            }

            <!-- ADD LOCATION TILE -->
            <div class="gp-location-block card mb-3 add-location-tile"
                 style="cursor:pointer;"
                 @onclick="@(() => Nav.NavigateTo($"/locations/create?gardenId={gardenId}&returnUrl=/garden-profile/{gardenId}"))">

                <div class="gp-location-header">
                    <div>
                        <h4 class="gp-location-title text-primary">
                            <i class="bi bi-plus-lg"></i> Add Location
                        </h4>
                        <div class="gp-location-sub">Create a new location</div>
                    </div>
                </div>

            </div>
        }
    </div>

}

@code {
    [Parameter] public int gardenId { get; set; }

    GardenModel? garden;
    List<LocationModel>? locations;
    List<PlantWithInfoDto>? plants;

    protected override async Task OnParametersSetAsync()
    {
        garden = await GardenService.GetGarden(gardenId);
        locations = await GardenService.GetLocationsByGarden(gardenId);
        plants = await PlantService.GetPlantsByGarden(gardenId);
    }
}
