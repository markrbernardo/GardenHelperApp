@page "/observations/edit/{Id:int}"

@using GardenHelperApp.Shared.Models
@using Microsoft.AspNetCore.WebUtilities

@inject ObservationService ObservationService
@inject PlantService PlantService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageHeader Title="Edit Observation" />

<div class="page-section">

    @if (Observation == null || Plants == null)
    {
        <LoadingSpinner Message="Loading observation..." />
    }
    else if (IsDeleted)
    {
        <LoadingSpinner Message="Deleting..." />
    }
    else
    {
        <ObservationForm Observation="Observation"
                         Plants="Plants"
                         SubmitLabel="Save"
                         OnSubmitCallback="HandleSubmitAsync"
                         OnCancelCallback="GoBack"
                         OnDeleteCallback="DeleteObservationAsync"
                         ShowDelete="true"
                         IsDisabled="IsDeleted" />
    }

</div>

@code {
    [Parameter] public int Id { get; set; }

    private ObservationModel? Observation;
    private List<PlantWithInfoDto>? Plants;
    private string? ReturnUrl;
    private bool IsDeleted = false;

    protected override async Task OnInitializedAsync()
    {
        // Load plants
        Plants = await PlantService.GetAllAsync();

        // Load observation
        Observation = await ObservationService.GetAsync(Id);

        if (Observation == null)
            return;

        // Ensure selected plant exists
        if (!Plants.Any(p => p.PlantId == Observation.PlantId))
            Observation.PlantId = Plants.First().PlantId;

        // Parse returnUrl
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("returnUrl", out var url))
            ReturnUrl = url!;
    }

    private async Task HandleSubmitAsync()
    {
        Observation!.UpdatedAt = DateTime.UtcNow;

        await ObservationService.UpdateAsync(Observation);

        if (!string.IsNullOrWhiteSpace(ReturnUrl))
            Nav.NavigateTo(ReturnUrl);
        else
            Nav.NavigateTo("/observations");
    }

    private void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
            Nav.NavigateTo(ReturnUrl);
        else
            Nav.NavigateTo("/observations");
    }

    private async Task DeleteObservationAsync()
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to delete this observation?"
        );

        if (!confirmed)
            return;

        await ObservationService.DeleteAsync(Observation!.ObservationId);

        IsDeleted = true;

        if (!string.IsNullOrWhiteSpace(ReturnUrl))
            Nav.NavigateTo(ReturnUrl, forceLoad: true);
        else
            Nav.NavigateTo("/observations", forceLoad: true);
    }
}
