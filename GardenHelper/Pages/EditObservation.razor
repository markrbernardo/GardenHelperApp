@page "/observations/edit/{id:int}"
@using GardenHelperApp.Shared.Models
@using Microsoft.AspNetCore.WebUtilities
@inject ObservationService ObservationService
@inject PlantService PlantService
@inject PlantInformationService PlantInfoService
@inject NavigationManager Nav

<h3>Edit Observation</h3>

@if (observation == null || plants == null || plantInfoList == null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="@observation" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Plant</label>
            <select class="form-select" @bind="observation.PlantId">
                @foreach (var p in plants)
                {
                    var info = plantInfoList.FirstOrDefault(pi => pi.PlantInformationId == p.PlantInformationId);

                    <option value="@p.PlantId">
                        @p.Name — @info?.CommonName (@info?.ScientificName)
                    </option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label>Observation</label>
            <InputTextArea class="form-control" @bind-Value="observation.Observation" rows="4" />
        </div>

        <button type="submit" class="btn btn-success">Save</button>
        <button type="button" class="btn btn-secondary" @onclick="GoBack">Cancel</button>
        <button type="button" class="btn btn-danger ms-2" @onclick="ShowDeleteConfirm">
            Delete
        </button>

        @if (showDeleteConfirm)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
                <div class="modal-dialog">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title">Delete Observation</h5>
                        </div>

                        <div class="modal-body">
                            <p>Are you sure you want to delete this observation?</p>
                        </div>

                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="HideDeleteConfirm">Cancel</button>
                            <button class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
                        </div>

                    </div>
                </div>
            </div>
        }

    </EditForm>
}

@code {
    [Parameter] public int id { get; set; }
    string? returnUrl;

    ObservationModel? observation;
    List<PlantModel>? plants;
    List<PlantInformationModel>? plantInfoList;


    bool showDeleteConfirm = false;

    void ShowDeleteConfirm() => showDeleteConfirm = true;
    void HideDeleteConfirm() => showDeleteConfirm = false;

    async Task ConfirmDelete()
    {
        await ObservationService.Delete(observation!.ObservationId);

        if (!string.IsNullOrWhiteSpace(returnUrl))
            Nav.NavigateTo(returnUrl!);
        else
            Nav.NavigateTo("/observations");
    }




    protected override async Task OnInitializedAsync()
    {
        plants = await PlantService.GetAllPlants();
        plantInfoList = await PlantInfoService.GetAll();

        observation = await ObservationService.Get(id);

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        // QueryHelpers returns StringValues; convert to string explicitly
        if (query.TryGetValue("returnUrl", out var urlValues))
            returnUrl = urlValues.ToString();
    }

    async Task HandleSubmit()
    {

        observation!.UpdatedAt = DateTime.UtcNow;

        await ObservationService.Update(observation);

        if (!string.IsNullOrWhiteSpace(returnUrl))
            Nav.NavigateTo(returnUrl!);
        else
            Nav.NavigateTo("/observations");
    }


    void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(returnUrl))
            Nav.NavigateTo(returnUrl!);
        else
            Nav.NavigateTo("/observations");
    }
}
