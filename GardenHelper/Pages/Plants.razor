@page "/plants"
@inject PlantService PlantService
@inject PlantInformationService PlantInfoService
@inject ObservationService ObservationService
@inject NavigationManager Nav

<h3>Plants</h3>

<!-- MOBILE DROPDOWN (visible only on small screens) -->
<div class="plant-dropdown d-md-none mb-3">
    @if (plants != null && plants.Count > 0)
    {
        <select class="form-select" @onchange="OnDropdownChange">
            <option value="">Select a plant...</option>
            @foreach (var p in plants)
            {
                <option value="@p.PlantId">@p.Name</option>
            }
        </select>
    }
</div>

<!-- DESKTOP LAYOUT (hidden on small screens) -->
<div class="plant-layout d-none d-md-grid">

    <!-- LEFT COLUMN: PLANT LIST -->
    <div class="plant-list">
        @if (plants == null)
        {
            <p>Loading plants...</p>
        }
        else if (plants.Count == 0)
        {
            <p>No plants found.</p>
        }
        else
        {
            @foreach (var p in plants)
            {
                <div class="plant-list-item @(selectedPlant?.PlantId == p.PlantId ? "selected" : "")"
                     @onclick="() => SelectPlant(p)">
                    @p.Name
                </div>
            }
        }
    </div>

    <!-- RIGHT COLUMN: PLANT DETAILS (DESKTOP ONLY) -->
    <div class="plant-details">
        @if (selectedPlant == null)
        {
            <p class="placeholder">Select a plant to view its profile.</p>
        }
        else
        {
            <h2>@selectedPlant.Name</h2>

            @if (plantInfo != null)
            {
                <details class="plant-info">
                    <summary>Plant Information</summary>
                    <p><strong>Common Name:</strong> @plantInfo.CommonName</p>
                    <p><strong>Scientific Name:</strong> @plantInfo.ScientificName</p>
                </details>
            }

            <h4 class="mt-4">Observations</h4>

            @if (observations == null)
            {
                <p>Loading observations...</p>
            }
            else if (observations.Count == 0)
            {
                <p>No observations yet.</p>
            }
            else
            {
                <ul>
                    @foreach (var o in observations)
                    {
                        <li>@o.Observation</li>
                    }
                </ul>
            }

            <button class="btn btn-primary mt-3" @onclick="AddObservation">
                Add Observation
            </button>
        }
    </div>

</div>

<!-- MOBILE DETAILS (visible only on small screens) -->
<div class="plant-details d-md-none mt-3">
    @if (selectedPlant == null)
    {
        <p class="placeholder">Select a plant to view its profile.</p>
    }
    else
    {
        <h2>@selectedPlant.Name</h2>

        @if (plantInfo != null)
        {
            <details class="plant-info">
                <summary>Plant Information</summary>
                <p><strong>Common Name:</strong> @plantInfo.CommonName</p>
                <p><strong>Scientific Name:</strong> @plantInfo.ScientificName</p>
            </details>
        }

        <h4 class="mt-4">Observations</h4>

        @if (observations == null)
        {
            <p>Loading observations...</p>
        }
        else if (observations.Count == 0)
        {
            <p>No observations yet.</p>
        }
        else
        {
            <ul>
                @foreach (var o in observations)
                {
                    <li>@o.Observation</li>
                }
            </ul>
        }

        <button class="btn btn-primary mt-3" @onclick="AddObservation">
            Add Observation
        </button>
    }
</div>

@code {
    List<PlantModel>? plants;
    PlantModel? selectedPlant;
    PlantInformationModel? plantInfo;
    List<ObservationModel>? observations;

    protected override async Task OnInitializedAsync()
    {
        plants = await PlantService.GetAll();
    }

    async Task SelectPlant(PlantModel plant)
    {
        selectedPlant = plant;

        plantInfo = await PlantInfoService.Get(plant.PlantInformationId);
        observations = await ObservationService.GetByPlant(plant.PlantId);
    }

    async Task OnDropdownChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int plantId))
        {
            var plant = plants?.FirstOrDefault(p => p.PlantId == plantId);
            if (plant != null)
                await SelectPlant(plant);
        }
    }

    void AddObservation()
    {
        Nav.NavigateTo($"/observations/create?plantId={selectedPlant.PlantId}");
    }
}
