@page "/plants"
@inject PlantService PlantService
@inject LocationService LocationService
@inject GardenService GardenService
@inject PlantInformationService PlantInfoService
@inject ObservationService ObservationService
@inject UserSessionService UserSession
@inject NavigationManager Nav

<h3>All Plants by Location</h3>

@if (groupedPlants == null)
{
    <p>Loading plants...</p>
}
else
{
    <!-- MOBILE DROPDOWN -->
    <div class="plant-dropdown d-md-none mb-3">
        <select class="form-select" @onchange="OnDropdownChange">
            <option value="">Select a plant...</option>
            @foreach (var loc in groupedPlants)
            {
                <optgroup label="@loc.Key">
                    @foreach (var p in loc.Value)
                    {
                        <option value="@p.PlantId">@p.Name</option>
                    }
                </optgroup>
            }
        </select>
    </div>

    <!-- DESKTOP LAYOUT -->
    <div class="plant-layout d-none d-md-grid">

        <!-- LEFT COLUMN -->
        <div class="plant-list">
            @foreach (var group in groupedPlants)
            {
                <h5 class="mt-3">@group.Key</h5>

                @foreach (var p in group.Value)
                {
                    <PlantTile Plant="p"
                               Selected="(selectedPlant?.PlantId == p.PlantId)"
                               OnSelect="SelectPlant" />
                }
            }

        </div>

        <!-- RIGHT COLUMN -->
        <div class="plant-details">
            <PlantDetails Plant="selectedPlant" />
        </div>

    </div>

    <!-- MOBILE DETAILS -->
    <div class="plant-details d-md-none mt-3">
        <PlantDetails Plant="selectedPlant" />
    </div>
}

@code {
    Dictionary<string, List<PlantModel>>? groupedPlants;

    PlantModel? selectedPlant;

    protected override async Task OnParametersSetAsync()
    {
        var userId = UserSession.CurrentUserId;

        if (userId == null)
        {
            Nav.NavigateTo("/login");
            return;
        }

        // Get the currently selected garden
        var gardenId = UserSession.CurrentGardenId;

        if (gardenId == null)
        {
            Nav.NavigateTo("/gardens");
            return;
        }

        // Load only locations for the selected garden
        var locations = await LocationService.GetByGarden(gardenId.Value);

        groupedPlants = new Dictionary<string, List<PlantModel>>();

        // Load plants only for those locations
        foreach (var loc in locations.OrderBy(l => l.Name))
        {
            var plants = await PlantService.GetPlantsByLocation(loc.LocationId);

            groupedPlants[loc.Name] = plants
                .OrderBy(p => p.Name)
                .ToList();
        }
    }

    async Task SelectPlant(PlantModel plant)
    {
        selectedPlant = plant;
    }

    async Task OnDropdownChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int plantId))
        {
            foreach (var group in groupedPlants.Values)
            {
                var plant = group.FirstOrDefault(p => p.PlantId == plantId);
                if (plant != null)
                {
                    await SelectPlant(plant);
                    break;
                }
            }
        }
    }
}
