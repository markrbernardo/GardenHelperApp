@page "/plants"

@inject PlantService PlantService
@inject LocationService LocationService
@inject GardenService GardenService
@inject PlantInformationService PlantInfoService
@inject ObservationService ObservationService
@inject UserSessionService UserSession
@inject NavigationManager Nav

<PageHeader Title=@($"{Garden?.Name ?? "Garden: "}: Plant Inventory") Divider="false">
    <Actions>
        <button class="btn btn-primary"
                @onclick="@(() => Nav.NavigateTo($"/plants/create?returnUrl=/plants"))">
            <i class="bi bi-plus-lg"></i> Add Plant
        </button>
    </Actions>
</PageHeader>

<div class="page-section">

    @if (GroupedPlants == null)
    {
        <LoadingSpinner Message="Loading plants..." />
    }
    else if (GroupedPlants.Count == 0)
    {
        <EmptyState Message="No plants found in this garden." />
    }
    else
    {
        <!-- MOBILE DROPDOWN -->
        <div class="plant-dropdown d-md-none mb-3">
            <select class="form-select" @onchange="OnDropdownChange">
                <option value="">Select a plant...</option>

                @foreach (var loc in GroupedPlants)
                {
                    <optgroup label="@loc.Key">
                        @foreach (var p in loc.Value)
                        {
                            <option value="@p.PlantId">
                                @p.CommonName (@p.ScientificName)
                            </option>
                        }
                    </optgroup>
                }
            </select>
        </div>

        <!-- DESKTOP LAYOUT -->
        <div class="d-none d-md-block">
            <TwoColumnLayout FullHeight="true">
                <Left>
                    <ScrollColumn HideScrollbar="true" Height="100%" CssClass="pt-0">
                        @foreach (var group in GroupedPlants)
                        {
                            <h5 class="mt-3">@group.Key</h5>

                            @foreach (var p in group.Value)
                            {
                                <PlantNametagTile Plant="p"
                                                  Selected="(SelectedPlant?.PlantId == p.PlantId)"
                                                  OnSelect="SelectPlantAsync" />
                            }
                        }
                    </ScrollColumn>
                </Left>

                <Right>
                    @if (SelectedPlant == null)
                    {
                        <p class="placeholder">Select a plant to view details.</p>
                    }
                    else
                    {
                        <ScrollColumn>
                            <PlantDetailsTile Plant="SelectedPlant"
                                              OnAddObservation="HandleAddObservation"
                                              OnEditObservation="HandleEditObservation"
                                              OnEditPlant="HandleEditPlant" />
                        </ScrollColumn>
                    }
                </Right>

            </TwoColumnLayout>
        </div>

        <!-- MOBILE DETAILS -->
        <div class="d-md-none mt-3">
            <PlantDetailsTile Plant="SelectedPlant"
                              OnAddObservation="HandleAddObservation"
                              OnEditObservation="HandleEditObservation"
                              OnEditPlant="HandleEditPlant" />
        </div>
    }

</div>

@code {
    private Dictionary<string, List<PlantWithInfoDto>>? GroupedPlants;
    private PlantWithInfoDto? SelectedPlant;
    private GardenModel? Garden;

    protected override async Task OnInitializedAsync()
    {
        var gardenId = UserSession.CurrentGardenId;
        if (gardenId == null)
        {
            Nav.NavigateTo("/gardens");
            return;
        }

        Garden = await GardenService.GetAsync(gardenId.Value);
    }


    protected override async Task OnParametersSetAsync()
    {
        var userId = UserSession.CurrentUserId;
        if (userId == null)
        {
            Nav.NavigateTo("/login");
            return;
        }

        var gardenId = UserSession.CurrentGardenId;
        if (gardenId == null)
        {
            Nav.NavigateTo("/gardens");
            return;
        }


        // Load locations for this garden
        var locations = await LocationService.GetByGardenAsync(gardenId.Value);

        GroupedPlants = new Dictionary<string, List<PlantWithInfoDto>>();

        foreach (var loc in locations.OrderBy(l => l.Name))
        {
            var plants = await PlantService.GetByLocationAsync(loc.LocationId);
            GroupedPlants[loc.Name] = plants;
        }

        // Preselect plant from querystring
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("plantId", out var pid) &&
            int.TryParse(pid, out int parsedId))
        {
            SelectedPlant = GroupedPlants
                .SelectMany(g => g.Value)
                .FirstOrDefault(p => p.PlantId == parsedId);
        }

        await UserSession.SetCurrentPlantAsync(SelectedPlant?.PlantId, persist: true);
    }

    private Task SelectPlantAsync(PlantWithInfoDto plant)
    {
        SelectedPlant = plant;
        return Task.CompletedTask;
    }

    private async Task OnDropdownChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int plantId))
        {
            SelectedPlant = GroupedPlants!
                .SelectMany(g => g.Value)
                .FirstOrDefault(p => p.PlantId == plantId);

            await Task.CompletedTask;
        }
    }

    private void HandleAddObservation(int plantId)
    {
        Nav.NavigateTo($"/observations/create?plantId={plantId}&returnUrl=/plants?plantId={plantId}");
    }

    private void HandleEditObservation(int obsId)
    {
        Nav.NavigateTo($"/observations/edit/{obsId}?returnUrl=/plants");
    }

    private void HandleEditPlant(int plantId)
    {
        Nav.NavigateTo($"/plants/edit/{plantId}?returnUrl=/plants?plantId={plantId}");
    }
}
