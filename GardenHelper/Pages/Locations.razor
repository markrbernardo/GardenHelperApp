@page "/locations"
@inject LocationService LocationService
@inject GardenService GardenService
@inject NavigationManager Nav
@inject IJSRuntime JS

<h3>Pick a Location...</h3>


@if (locations == null || gardens == null)
{
    <p>Loading...</p>
}
else if (locations.Count == 0)
{
    <p>No locations found.</p>
}
else
{
    <div class="location-tiles">
        @foreach (var l in locations)
        {
            <div class="location-tile" @onclick="() => GoToLocationPlants(l.LocationId)">
                <div class="location-title">@l.Name</div>
                <div class="location-sub">
                    @GetGardenName(l.GardenId)
                </div>
                <div class="location-details">
                    Lighting: @l.Lighting<br />
                    @(l.IsOutside == 1 ? "Outside" : "Inside")
                </div>
            </div>
        }

        <!-- Add Location tile -->
        <div class="location-tile add-tile" @onclick="CreateLocation">
            <div class="location-title">+ Add Location</div>
            <div class="location-sub">
                Create a new location in this garden
            </div>
        </div>
    </div>
}


@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int? GardenId { get; set; }


    void GoToLocationPlants(int locationId)
    {
        Nav.NavigateTo($"/plants?locationId={locationId}");
    }


    List<LocationModel>? locations;
    List<GardenModel>? gardens;

    protected override async Task OnParametersSetAsync()
    {
        gardens = await GardenService.GetAllGardens();

        if (GardenId != null)
        {
            locations = (await LocationService.GetAll())
                .Where(l => l.GardenId == GardenId.Value)
                .ToList();
        }
        else
        {
            locations = await LocationService.GetAll();
        }
    }


    string GetGardenName(int gardenId)
    {
        return gardens?.FirstOrDefault(g => g.GardenId == gardenId)?.Name ?? "Unknown";
    }

    void CreateLocation()
    {
        if (GardenId != null)
            Nav.NavigateTo($"/locations/create?gardenId={GardenId.Value}");
        else
            Nav.NavigateTo("/locations/create");
    }


    void EditLocation(int id)
    {
        Nav.NavigateTo($"/locations/edit/{id}");
    }

    async Task DeleteLocation(int id)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "Delete this location?");
        if (!confirm) return;

        await LocationService.Delete(id);
        locations = await LocationService.GetAll();
    }
}