@page "/plantinformation/edit/{Id:int}"

@inject PlantInformationService PlantInfoService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageHeader Title="Edit Plant Information" />

<div class="page-section">

    @if (IsLoading)
    {
        <LoadingSpinner Message="Loading plant information..." />
    }
    else if (LoadError != null)
    {
        <div class="alert alert-danger">@LoadError</div>
    }
    else if (PlantInfo != null)
    {
        @if (IsDeleted)
        {
            <LoadingSpinner Message="Deleting..." />
        }
        else
        {
            <PlantInfoForm PlantInfo="PlantInfo"
                           SubmitLabel="Save"
                           OnSubmitCallback="HandleSubmitAsync"
                           OnCancelCallback="GoBack"
                           OnDeleteCallback="DeleteEntryAsync"
                           ShowDelete="true"
                           IsDisabled="IsDeleted" />
        }
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger mt-3">@ErrorMessage</div>
    }

</div>

@code {
    [Parameter] public int Id { get; set; }

    private PlantInformationModel? PlantInfo;
    private bool IsLoading = true;
    private bool IsDeleted = false;

    private string? LoadError;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PlantInfo = await PlantInfoService.GetAsync(Id);

            if (PlantInfo == null)
                LoadError = "Plant information not found.";
        }
        catch (Exception ex)
        {
            LoadError = "Failed to load plant information.";
            Console.WriteLine("ERROR loading plant info: " + ex);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task HandleSubmitAsync()
    {
        try
        {
            ErrorMessage = null;

            await PlantInfoService.UpdateAsync(PlantInfo!);
            Nav.NavigateTo("/plantinformation");
        }
        catch (Exception ex)
        {
            ErrorMessage = "Failed to save changes.";
            Console.WriteLine("ERROR saving plant info: " + ex);
        }
    }

    private void GoBack()
    {
        if (PlantInfo != null)
            Nav.NavigateTo($"/plantinformation/{PlantInfo.PlantInformationId}");
        else
            Nav.NavigateTo("/plantinformation");
    }

    private async Task DeleteEntryAsync()
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to delete this plant information?"
        );

        if (!confirmed)
            return;

        try
        {
            await PlantInfoService.DeleteAsync(Id);
            IsDeleted = true;

            Nav.NavigateTo("/plantinformation", forceLoad: true);
        }
        catch (Exception ex)
        {
            ErrorMessage = "Failed to delete plant information.";
            Console.WriteLine("ERROR deleting plant info: " + ex);
        }
    }
}
