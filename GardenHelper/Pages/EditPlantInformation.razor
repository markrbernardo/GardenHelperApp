@page "/plantinformation/edit/{id:int}"
@inject PlantInformationService PlantInfoService
@inject NavigationManager Nav
@inject IJSRuntime JS


<h3>Edit Plant Information</h3>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (loadError != null)
{
    <div class="alert alert-danger">@loadError</div>
}
else if (plantInfo != null)
{
    <EditForm Model="@plantInfo" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <!-- BASIC INFO -->
        <div class="mb-3">
            <label class="form-label">Common Name</label>
            <InputText class="form-control" @bind-Value="plantInfo.CommonName" />
        </div>

        <div class="mb-3">
            <label class="form-label">Scientific Name</label>
            <InputText class="form-control" @bind-Value="plantInfo.ScientificName" />
        </div>

        <!-- PHOTO UPLOAD -->
        <div class="mb-3">
            <label class="form-label">Upload Photo</label>
            <InputFile OnChange="HandleFileSelected" accept="image/*" />
            <small class="text-muted">Choose an image to upload.</small>
        </div>

        @if (!string.IsNullOrEmpty(plantInfo.Photo))
        {
            <div class="mt-2">
                <img src="@($"data:{plantInfo.PhotoMimeType ?? "image/png"};base64,{plantInfo.Photo}")"
                     style="max-width:200px; border-radius:8px;" />

                <button class="btn btn-danger btn-sm mt-2" @onclick="RemovePhoto">
                    Remove Photo
                </button>
            </div>
        }

        <!-- DESCRIPTION -->
        <div class="mb-3">
            <label class="form-label">Description</label>
            <InputTextArea class="form-control" @bind-Value="plantInfo.Description" rows="3" />
        </div>

        <!-- CARE SECTIONS -->
        <h5 class="mt-4">Care Information</h5>

        <div class="mb-3">
            <label class="form-label">Seeds</label>
            <InputTextArea class="form-control" @bind-Value="plantInfo.Seeds" rows="2" />
        </div>

        <div class="mb-3">
            <label class="form-label">Light</label>
            <InputTextArea class="form-control" @bind-Value="plantInfo.Light" rows="2" />
        </div>

        <div class="mb-3">
            <label class="form-label">Water</label>
            <InputTextArea class="form-control" @bind-Value="plantInfo.Water" rows="2" />
        </div>

        <div class="mb-3">
            <label class="form-label">Air</label>
            <InputTextArea class="form-control" @bind-Value="plantInfo.Air" rows="2" />
        </div>

        <div class="mb-3">
            <label class="form-label">Soil</label>
            <InputTextArea class="form-control" @bind-Value="plantInfo.Soil" rows="2" />
        </div>

        <div class="mb-3">
            <label class="form-label">Container</label>
            <InputTextArea class="form-control" @bind-Value="plantInfo.Container" rows="2" />
        </div>

        <div class="mb-3">
            <label class="form-label">Fertilization</label>
            <InputTextArea class="form-control" @bind-Value="plantInfo.Fertilization" rows="2" />
        </div>

        <div class="mb-3">
            <label class="form-label">Pruning</label>
            <InputTextArea class="form-control" @bind-Value="plantInfo.Pruning" rows="2" />
        </div>

        <div class="mb-3">
            <label class="form-label">Propagation</label>
            <InputTextArea class="form-control" @bind-Value="plantInfo.Propagation" rows="2" />
        </div>

        <div class="mb-3">
            <label class="form-label">Health</label>
            <InputTextArea class="form-control" @bind-Value="plantInfo.Health" rows="2" />
        </div>

        <!-- BUTTONS -->
        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-success" disabled="@isSubmitting">Save</button>
            <button class="btn btn-secondary" @onclick="GoBack" disabled="@isSubmitting">Cancel</button>

            <button class="btn btn-danger ms-auto"
                    @onclick="ConfirmDelete"
                    disabled="@isSubmitting">
                Delete
            </button>
        </div>
    </EditForm>
}

@if (deleteConfirm)
{
    <div class="alert alert-warning mt-3">
        <strong>Are you sure?</strong> This will permanently delete this plant information.
        <div class="mt-2 d-flex gap-2">
            <button class="btn btn-danger" @onclick="Delete">Yes, Delete</button>
            <button class="btn btn-secondary" @onclick="() => deleteConfirm = false">Cancel</button>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}
else
{
    <p>Error: No plant information available.</p>
}


@code {
    [Parameter] public int id { get; set; }

    PlantInformationModel? plantInfo;
    bool isLoading = true;
    bool isSubmitting = false;
    bool deleteConfirm = false;

    string? loadError;
    string? errorMessage;

    async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null)
            return;

        // Read file into memory
        using var stream = file.OpenReadStream(maxAllowedSize: 10_000_000);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var bytes = ms.ToArray();

        // Convert to Base64
        var base64 = Convert.ToBase64String(bytes);
        var dataUrl = $"data:{file.ContentType};base64,{base64}";

        // Send Base64 to JS for resizing
        var resizedDataUrl = await JS.InvokeAsync<string>(
            "resizeImageFromBase64",
            dataUrl,
            800,
            800
        );

        // Split MIME + Base64
        var parts = resizedDataUrl.Split(',');
        plantInfo.PhotoMimeType = parts[0].Split(':')[1].Split(';')[0];
        plantInfo.Photo = parts[1];
    }




    protected override async Task OnInitializedAsync()
    {
        try
        {
            plantInfo = await PlantInfoService.Get(id);

            if (plantInfo == null)
                loadError = "Plant information not found.";
        }
        catch (Exception ex)
        {
            loadError = "Failed to load plant information.";
            Console.WriteLine("ERROR loading plant info: " + ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    async Task HandleSubmit()
    {
        try
        {
            isSubmitting = true;
            errorMessage = null;

            await PlantInfoService.Update(plantInfo!);
            Nav.NavigateTo("/plantinformation");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to save changes.";
            Console.WriteLine("ERROR saving plant info: " + ex);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    void GoBack()
    {
        if (plantInfo != null)
            Nav.NavigateTo($"/plantinformation/{plantInfo.PlantInformationId}");
        else
            Nav.NavigateTo("/plantinformation");
    }

    void ConfirmDelete()
    {
        deleteConfirm = true;
    }

    async Task Delete()
    {
        try
        {
            isSubmitting = true;
            errorMessage = null;

            await PlantInfoService.Delete(id);
            Nav.NavigateTo("/plantinformation");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to delete plant information.";
            Console.WriteLine("ERROR deleting plant info: " + ex);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    void RemovePhoto()
    {
        plantInfo.Photo = null;
        plantInfo.PhotoMimeType = null;
    }
}
