@page "/plantinformation/edit/{id:int}"
@inject PlantInformationService PlantInfoService
@inject NavigationManager Nav
@inject IJSRuntime JS

<h3>Edit Plant Information</h3>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (loadError != null)
{
    <div class="alert alert-danger">@loadError</div>
}
else if (plantInfo != null)
{
    @if (isDeleted)
    {
        <p>Redirecting...</p>
        return;
    }

    <PlantInfoForm PlantInfo="plantInfo"
                   SubmitLabel="Save"
                   OnSubmitCallback="HandleSubmit"
                   OnCancelCallback="GoBack"
                   OnDeleteCallback="DeleteEntry"
                   ShowDelete="true"
                   IsDisabled="isDeleted" />

}

@if (deleteConfirm)
{
    <div class="alert alert-warning mt-3">
        <strong>Are you sure?</strong> This will permanently delete this plant information.
        <div class="mt-2 d-flex gap-2">
            <button class="btn btn-danger" @onclick="Delete">Yes, Delete</button>
            <button class="btn btn-secondary" @onclick="() => deleteConfirm = false">Cancel</button>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

@code {
    [Parameter] public int id { get; set; }

    PlantInformationModel? plantInfo;
    bool isLoading = true;
    bool isSubmitting = false;
    bool deleteConfirm = false;

    string? loadError;
    string? errorMessage;

    async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null)
            return;

        using var stream = file.OpenReadStream(maxAllowedSize: 10_000_000);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var bytes = ms.ToArray();

        var base64 = Convert.ToBase64String(bytes);
        var dataUrl = $"data:{file.ContentType};base64,{base64}";

        var resizedDataUrl = await JS.InvokeAsync<string>(
            "resizeImageFromBase64",
            dataUrl,
            800,
            800
        );

        var parts = resizedDataUrl.Split(',');
        plantInfo.PhotoMimeType = parts[0].Split(':')[1].Split(';')[0];
        plantInfo.Photo = parts[1];
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            plantInfo = await PlantInfoService.Get(id);

            if (plantInfo == null)
                loadError = "Plant information not found.";
        }
        catch (Exception ex)
        {
            loadError = "Failed to load plant information.";
            Console.WriteLine("ERROR loading plant info: " + ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    async Task HandleSubmit()
    {
        try
        {
            isSubmitting = true;
            errorMessage = null;

            await PlantInfoService.Update(plantInfo!);
            Nav.NavigateTo("/plantinformation");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to save changes.";
            Console.WriteLine("ERROR saving plant info: " + ex);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    void GoBack()
    {
        if (plantInfo != null)
            Nav.NavigateTo($"/plantinformation/{plantInfo.PlantInformationId}");
        else
            Nav.NavigateTo("/plantinformation");
    }

    void ConfirmDelete()
    {
        deleteConfirm = true;
    }

    async Task Delete()
    {
        try
        {
            isSubmitting = true;
            errorMessage = null;

            await PlantInfoService.Delete(id);
            Nav.NavigateTo("/plantinformation");
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to delete plant information.";
            Console.WriteLine("ERROR deleting plant info: " + ex);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    void RemovePhoto()
    {
        plantInfo.Photo = null;
        plantInfo.PhotoMimeType = null;
    }

    bool isDeleted = false;
    async Task DeleteEntry()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "Are you sure you want to delete this plant information?");

        if (!confirmed)
            return;

        await PlantInfoService.Delete(id);

        isDeleted = true;

        Nav.NavigateTo("/plantinformation", forceLoad: true);
    }

}
