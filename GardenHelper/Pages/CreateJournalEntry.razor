@page "/journalentries/create"
@inject JournalEntryService JournalEntryService
@inject GardenService GardenService
@inject UserSessionService Session
@inject NavigationManager Nav

<h3>Create Journal Entry</h3>

@if (gardens == null)
{
    <p>Loading...</p>
}
else
{
    <JournalEntryForm Entry="entry"
                      Gardens="gardens"
                      SubmitLabel="Create"
                      OnSubmitCallback="HandleSubmit"
                      OnCancelCallback="GoBack"
                      ShowDelete="false" />

}

@code {
    JournalEntryModel entry = new();

    List<GardenModel>? gardens;
    string? returnUrl;

    protected override async Task OnInitializedAsync()
    {
        // ⭐ Assign the logged-in user
        entry.UserId = Session.CurrentUserId!.Value;

        // Load only this user's gardens
        gardens = await GardenService.GetGardensByUser(Session.CurrentUserId.Value);

        // Default to current garden if available
        if (Session.CurrentGardenId != null)
            entry.GardenId = Session.CurrentGardenId.Value;
        else if (gardens.Count > 0)
            entry.GardenId = gardens.First().GardenId;

        // Read returnUrl
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("returnUrl", out var url))
            returnUrl = url!;
    }

    async Task HandleSubmit()
    {
        // Safety: ensure UserId is always set
        entry.UserId = Session.CurrentUserId!.Value;
        entry.CreatedAt = DateTime.SpecifyKind(DateTime.Now, DateTimeKind.Local);


        await JournalEntryService.Create(entry);

        if (!string.IsNullOrWhiteSpace(returnUrl))
            Nav.NavigateTo(returnUrl!);
        else
            Nav.NavigateTo("/journalentries");
    }

    void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(returnUrl))
            Nav.NavigateTo(returnUrl!);
        else
            Nav.NavigateTo("/journalentries");
    }
}
