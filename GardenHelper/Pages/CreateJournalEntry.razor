@page "/journalentries/create"

@inject JournalEntryService JournalEntryService
@inject GardenService GardenService
@inject UserSessionService Session
@inject NavigationManager Nav

<PageHeader Title="Create Journal Entry" />

<div class="page-section">

    @if (Gardens == null)
    {
        <LoadingSpinner Message="Loading gardens..." />
    }
    else
    {
        <JournalEntryForm Entry="Entry"
                          Gardens="Gardens"
                          SubmitLabel="Create"
                          OnSubmitCallback="HandleSubmitAsync"
                          OnCancelCallback="GoBack"
                          ShowDelete="false" />
    }

</div>

@code {
    private JournalEntryModel Entry { get; set; } = new();
    private List<GardenModel>? Gardens;
    private string? ReturnUrl;

    protected override async Task OnInitializedAsync()
    {
        // Always assign the logged-in user
        Entry.UserId = Session.CurrentUserId!.Value;

        // Load only this user's gardens
        Gardens = await GardenService.GetByUserAsync(Session.CurrentUserId.Value);

        // Default to current garden if available
        if (Session.CurrentGardenId != null)
        {
            Entry.GardenId = Session.CurrentGardenId.Value;
        }
        else if (Gardens.Count > 0)
        {
            Entry.GardenId = Gardens.First().GardenId;
        }

        // Read returnUrl from query string
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("returnUrl", out var url))
            ReturnUrl = url!;
    }

    private async Task HandleSubmitAsync()
    {
        // Ensure UserId is always set
        Entry.UserId = Session.CurrentUserId!.Value;
        Entry.CreatedAt = DateTime.SpecifyKind(DateTime.Now, DateTimeKind.Local);

        await JournalEntryService.CreateAsync(Entry);

        if (!string.IsNullOrWhiteSpace(ReturnUrl))
            Nav.NavigateTo(ReturnUrl);
        else
            Nav.NavigateTo("/journalentries");
    }

    private void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
            Nav.NavigateTo(ReturnUrl);
        else
            Nav.NavigateTo("/journalentries");
    }
}
