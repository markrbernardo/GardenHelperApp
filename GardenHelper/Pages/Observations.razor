@page "/observations"
@inject ObservationService ObservationService
@inject PlantService PlantService
@inject PlantInformationService PlantInfoService
@inject NavigationManager Nav
@inject IJSRuntime JS

<h3>Observations</h3>

<button class="btn btn-primary mb-3" @onclick="CreateObservation">
    Create New Observation
</button>

@if (observations == null || plants == null || plantInfoList == null)
{
    <p>Loading...</p>
}
else if (observations.Count == 0)
{
    <p>No observations found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Plant Name</th>
                <th>Common Name</th>
                <th>Scientific Name</th>
                <th>Observation</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in observations)
            {
                <tr>
                    <td>@o.ObservationId</td>
                    <td>@GetPlantName(o.PlantId)</td>
                    <td>@GetCommonName(o.PlantId)</td>
                    <td>@GetScientificName(o.PlantId)</td>
                    <td>@o.Observation</td>
                    <td>
                        <button class="btn btn-primary btn-sm" @onclick="() => EditObservation(o.ObservationId)">Edit</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteObservation(o.ObservationId)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    List<ObservationModel>? observations;
    List<PlantModel>? plants;
    List<PlantInformationModel>? plantInfoList;

    protected override async Task OnInitializedAsync()
    {
        observations = await ObservationService.GetAll();
        plants = await PlantService.GetAllPlants();
        plantInfoList = await PlantInfoService.GetAll();
    }

    string GetPlantName(int plantId)
    {
        return plants?
            .FirstOrDefault(p => p.PlantId == plantId)?
            .Name ?? "Unknown";
    }

    string GetCommonName(int plantId)
    {
        var plant = plants?.FirstOrDefault(p => p.PlantId == plantId);
        if (plant == null) return "Unknown";

        return plantInfoList?
            .FirstOrDefault(pi => pi.PlantInformationId == plant.PlantInformationId)?
            .CommonName ?? "Unknown";
    }

    string GetScientificName(int plantId)
    {
        var plant = plants?.FirstOrDefault(p => p.PlantId == plantId);
        if (plant == null) return "Unknown";

        return plantInfoList?
            .FirstOrDefault(pi => pi.PlantInformationId == plant.PlantInformationId)?
            .ScientificName ?? "Unknown";
    }

    void CreateObservation()
    {
        Nav.NavigateTo("/observations/create");
    }

    void EditObservation(int id)
    {
        Nav.NavigateTo($"/observations/edit/{id}");
    }

    async Task DeleteObservation(int id)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "Delete this observation?");
        if (!confirm) return;

        await ObservationService.Delete(id);
        observations = await ObservationService.GetAll();
    }
}
