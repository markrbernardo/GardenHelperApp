@page "/observations"

@using GardenHelperApp.Shared.Models
@using Microsoft.AspNetCore.WebUtilities

@inject ObservationService ObservationService
@inject PlantService PlantService
@inject UserSessionService Session
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageHeader Title="Observations" Divider="false"/>

<div class="page-section">

    @if (ObservationsList == null || PlantList == null)
    {
        <LoadingSpinner Message="Loading observations..." />
    }
    else if (!FilteredObservations.Any())
    {
        <EmptyState Message="No observations found for this garden." />
    }
    else
    {
        <!-- MOBILE DROPDOWN -->
        <div class="d-md-none mb-3">
            <select class="form-select" @onchange="OnMobileDateChange">
                <option value="">Select a date...</option>
                @foreach (var group in GroupedObservations)
                {
                    <option value="@group.Key.ToString("yyyy-MM-dd")">
                        @group.Key.ToString("MMM dd, yyyy") (@group.Count())
                    </option>
                }
            </select>
        </div>

        <!-- MOBILE DETAILS -->
        <div class="d-md-none mt-3">
            <ObservationDetailsTile SelectedDate="SelectedDate"
                                    Observations="ObservationsList"
                                    Plants="PlantList"
                                    SelectedGardenId="SelectedGardenId"
                                    OnEdit="HandleEditObservation"
                                    OnRefresh="LoadObservationsAsync" />
        </div>

        <!-- DESKTOP LAYOUT -->
        <div class="d-none d-md-block">
            <TwoColumnLayout>
                <Left>
                    <ScrollColumn CssClass="pt-4">
                        @foreach (var group in GroupedObservations)
                        {
                            <DateTile Date="group.Key"
                                      Count="group.Count()"
                                      Label="observation"
                                      Selected="(SelectedDate == group.Key)"
                                      OnSelect="SelectDate" />
                        }
                    </ScrollColumn>
                </Left>

                <Right>
                    <ScrollColumn CssClass="pt-2">
                        <ObservationDetailsTile SelectedDate="SelectedDate"
                                                Observations="ObservationsList"
                                                Plants="PlantList"
                                                SelectedGardenId="SelectedGardenId"
                                                OnEdit="HandleEditObservation"
                                                OnRefresh="LoadObservationsAsync" />
                    </ScrollColumn>
                </Right>
            </TwoColumnLayout>
        </div>
    }

</div>

@code {
    private List<ObservationModel>? ObservationsList;
    private List<ObservationModel>? FilteredObservations;
    private List<PlantWithInfoDto>? PlantList;

    private List<IGrouping<DateTime, ObservationModel>> GroupedObservations = new();
    private DateTime? SelectedDate;
    private int? SelectedGardenId;

    protected override async Task OnInitializedAsync()
    {
        if (Session.CurrentUserId == null)
            return;

        ObservationsList = await ObservationService.GetByUserAsync(Session.CurrentUserId.Value);
        PlantList = await PlantService.GetAllAsync();

        SelectedGardenId = Session.CurrentGardenId;

        ApplyFilteringAndGrouping();

        // Querystring preselect
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("obsId", out var oid) && int.TryParse(oid, out var obsId))
        {
            var obs = ObservationsList.FirstOrDefault(o => o.ObservationId == obsId);
            if (obs != null)
                SelectedDate = obs.CreatedAt.Date;
        }
        else if (query.TryGetValue("date", out var ds) && DateTime.TryParse(ds, out var dt))
        {
            SelectedDate = dt.Date;
        }

        if (SelectedDate == null && GroupedObservations.Any())
            SelectedDate = GroupedObservations.First().Key;
    }

    private void ApplyFilteringAndGrouping()
    {
        if (ObservationsList == null || PlantList == null)
        {
            FilteredObservations = new();
            return;
        }

        FilteredObservations = ObservationsList
            .Where(o => PlantList.Any(p => p.PlantId == o.PlantId &&
                                           p.GardenId == SelectedGardenId))
            .ToList();

        GroupedObservations = FilteredObservations
            .GroupBy(o => o.CreatedAt.Date)
            .OrderByDescending(g => g.Key)
            .ToList();
    }

    private void SelectDate(DateTime date)
    {
        SelectedDate = date;
    }

    private void OnMobileDateChange(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
            SelectedDate = date;
    }

    private void HandleEditObservation(int id)
    {
        Nav.NavigateTo($"/observations/edit/{id}?returnUrl=/observations");
    }

    private async Task LoadObservationsAsync()
    {
        ObservationsList = await ObservationService.GetByUserAsync(Session.CurrentUserId!.Value);
        ApplyFilteringAndGrouping();
        StateHasChanged();
    }
}
