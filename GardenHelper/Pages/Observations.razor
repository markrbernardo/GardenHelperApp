@page "/observations"
@using GardenHelperApp.Shared.Models
@using Microsoft.AspNetCore.WebUtilities
@inject ObservationService ObservationService
@inject PlantService PlantService
@inject UserSessionService Session
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageHeader Title="Observations" />

@if (observations == null || plants == null)
{
    <p>Loading...</p>
}
else if (!filteredObservations.Any())
{
    <p>No observations found for this garden.</p>
}
else
{
    <!-- MOBILE DROPDOWN -->
    <div class="d-md-none mb-3">
        <select class="form-select" @onchange="OnMobileDateChange">
            <option value="">Select a date...</option>
            @foreach (var group in groupedObservations)
            {
                <option value="@group.Key.ToString("yyyy-MM-dd")">
                    @group.Key.ToString("MMM dd, yyyy") (@group.Count())
                </option>
            }
        </select>
    </div>

    <!-- MOBILE DETAILS -->
    <div class="d-md-none mt-3">
        <ObservationDetailsTile SelectedDate="selectedDate"
                                Observations="observations"
                                Plants="plants"
                                SelectedGardenId="selectedGardenId"
                                OnEdit="HandleEditObservation"
                                OnRefresh="LoadObservations" />

    </div>

    <!-- DESKTOP LAYOUT -->
    <div class="d-none d-md-block">
        <TwoColumnLayout>
            <Left>
                <ScrollColumn>
                    <h3 class="mb-3">Dates</h3>

                    @foreach (var group in groupedObservations)
                    {
                        <DateTile Date="group.Key"
                                  Count="group.Count()"
                                  Label="observation"
                                  Selected="(selectedDate == group.Key)"
                                  OnSelect="SelectDate" />

                    }
                </ScrollColumn>
            </Left>

            <Right>
                <ScrollColumn>
                    <ObservationDetailsTile SelectedDate="selectedDate"
                                            Observations="observations"
                                            Plants="plants"
                                            SelectedGardenId="selectedGardenId"
                                            OnEdit="HandleEditObservation"
                                            OnRefresh="LoadObservations" />

                </ScrollColumn>
            </Right>
        </TwoColumnLayout>
    </div>
}


@code {
    List<ObservationModel>? observations;
    List<ObservationModel>? filteredObservations;
    List<PlantWithInfoDto>? plants;

    List<IGrouping<DateTime, ObservationModel>> groupedObservations = new();
    DateTime? selectedDate;
    int? selectedGardenId;

    protected override async Task OnInitializedAsync()
    {
        observations = await ObservationService.GetByUser(Session.CurrentUserId!.Value);
        plants = await PlantService.GetAllPlants();

        selectedGardenId = Session.CurrentGardenId;

        ApplyFilteringAndGrouping();

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("obsId", out var oid) && int.TryParse(oid, out var obsId))
        {
            var obs = observations.FirstOrDefault(o => o.ObservationId == obsId);
            if (obs != null)
                selectedDate = obs.CreatedAt.Date;
        }
        else if (query.TryGetValue("date", out var ds) && DateTime.TryParse(ds, out var dt))
        {
            selectedDate = dt.Date;
        }

        if (selectedDate == null && groupedObservations.Any())
            selectedDate = groupedObservations.First().Key;
    }

    void ApplyFilteringAndGrouping()
    {
        filteredObservations = observations
            .Where(o => plants.Any(p => p.PlantId == o.PlantId &&
                                        p.GardenId == selectedGardenId))
            .ToList();

        groupedObservations = filteredObservations
            .GroupBy(o => o.CreatedAt.Date)
            .OrderByDescending(g => g.Key)
            .ToList();
    }

    void SelectDate(DateTime date)
    {
        selectedDate = date;
    }

    void OnMobileDateChange(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
            selectedDate = date;
    }

    void EditObservation(int obsId)
    {
        Nav.NavigateTo($"/observations/edit/{obsId}");
    }

    async Task RefreshObservations()
    {
        observations = await ObservationService.GetByUser(Session.CurrentUserId!.Value);
        ApplyFilteringAndGrouping();
        StateHasChanged();
    }

    bool DateHasActiveObservation(DateTime date)
    {
        return filteredObservations
            .Any(o => o.CreatedAt.Date == date.Date && o.ActiveObservation);
    }

    void HandleEditObservation(int id)
    {
        Nav.NavigateTo($"/observations/edit/{id}?returnUrl=/observations");
    }

    async Task LoadObservations()
    {
        observations = await ObservationService.GetByUser(Session.CurrentUserId!.Value);

        // Reapply filtering + grouping using the new method
        ApplyFilteringAndGrouping();

        StateHasChanged();
    }
}

