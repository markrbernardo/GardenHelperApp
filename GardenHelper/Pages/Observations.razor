@page "/observations"
@using GardenHelperApp.Shared.Models
@inject ObservationService ObservationService
@inject PlantService PlantService
@inject PlantInformationService PlantInfoService
@inject UserSessionService UserSessionService
@inject NavigationManager Nav
@inject IJSRuntime JS

<h1 class="border-bottom pb-2">Observations</h1>

@if (observations == null || plants == null || plantInfoList == null)
{
    <p>Loading...</p>
}
else if (!observations.Any(o => plants.Any(p => p.PlantId == o.PlantId && p.GardenId == selectedGardenId)))
{
    <p>No observations found for this garden.</p>
}
else
{
    <!-- MOBILE DROPDOWN -->
    <div class="plant-dropdown d-md-none mb-3">
        <select class="form-select" @onchange="OnMobileDateChange">
            <option value="">Select a date...</option>
            @foreach (var group in groupedObservations)
            {
                <option value="@group.Key.ToString("yyyy-MM-dd")">
                    @group.Key.ToString("MMM dd, yyyy") (@group.Count())
                </option>
            }
        </select>
    </div>

    <!-- MOBILE DETAILS -->
    <div class="plant-details d-md-none mt-3">
        <ObservationDetails SelectedDate="selectedDate"
                            Observations="filteredObservations"
                            Plants="plants"
                            PlantInfos="plantInfoList"
                            SelectedGardenId="selectedGardenId"
                            OnEdit="EditObservation"
                            OnRefresh="RefreshObservations" />
    </div>

    <!-- DESKTOP TWO-COLUMN LAYOUT -->
    <div class="plant-layout d-none d-md-grid">

        <!-- LEFT COLUMN -->
        <div class="plant-list">
            <h3 class="mb-3">Dates</h3>

            @foreach (var group in groupedObservations)
            {
                <div class="obs-date @(selectedDate == group.Key ? "selected" : "")"
                     @onclick="() => SelectDate(group.Key)">
                    <strong>@group.Key.ToString("MMM dd, yyyy")</strong><br />
                    <small>@group.Count() observation(s)</small>
                </div>
            }
        </div>

        <!-- RIGHT COLUMN -->
        <ObservationDetails SelectedDate="selectedDate"
                            Observations="filteredObservations"
                            Plants="plants"
                            PlantInfos="plantInfoList"
                            SelectedGardenId="selectedGardenId"
                            OnEdit="EditObservation"
                            OnRefresh="RefreshObservations" />
    </div>
}

@code {
    List<ObservationModel>? observations;
    List<ObservationModel>? filteredObservations;
    List<PlantModel>? plants;
    List<PlantInformationModel>? plantInfoList;

    List<IGrouping<DateTime, ObservationModel>> groupedObservations = new();
    DateTime? selectedDate;
    int? selectedGardenId;

    protected override async Task OnInitializedAsync()
    {
        observations = await ObservationService.GetAll();
        plants = await PlantService.GetAllPlants();
        plantInfoList = await PlantInfoService.GetAll();

        selectedGardenId = UserSessionService.CurrentGardenId;

        ApplyFilteringAndGrouping();
    }

    void ApplyFilteringAndGrouping()
    {
        filteredObservations = observations
            .Where(o => plants.Any(p => p.PlantId == o.PlantId &&
                                        p.GardenId == selectedGardenId))
            .ToList();

        groupedObservations = filteredObservations
            .GroupBy(o => o.CreatedAt.Date)
            .OrderByDescending(g => g.Key)
            .ToList();

        selectedDate ??= groupedObservations.FirstOrDefault()?.Key;
    }

    void SelectDate(DateTime date)
    {
        selectedDate = date;
    }

    void OnMobileDateChange(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
            selectedDate = date;
    }

    void EditObservation(int obsId)
    {
        Nav.NavigateTo($"/observations/edit/{obsId}");
    }

    async Task RefreshObservations()
    {
        observations = await ObservationService.GetAll();
        ApplyFilteringAndGrouping();
        StateHasChanged();
    }
}
