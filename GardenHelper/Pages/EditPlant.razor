@page "/plants/edit/{id:int}"
@inject PlantService PlantService
@inject LocationService LocationService
@inject PlantInformationService PlantInfoService
@inject NavigationManager Nav
@inject UserSessionService Session
@inject IJSRuntime JS


<h3>Edit Plant</h3>

@if (plant == null || locations == null || plantInfoList == null)
{
    <p>Loading...</p>
}
else
{
    <PlantForm Plant="plant"
               Locations="locations"
               PlantInfoList="plantInfoList"
               SubmitLabel="Save"
               OnSubmitCallback="HandleSubmit"
               OnCancelCallback="GoBack"
               OnDeleteCallback="DeletePlant"
               ShowDelete="true"
               IsDisabled="isDeleted" />

}

@code {
    [Parameter] public int id { get; set; }

    string? returnUrl;


    PlantModel? plant;
    List<LocationModel>? locations;
    List<PlantInformationModel>? plantInfoList;

    protected override async Task OnInitializedAsync()
    {
        // Load dropdown data
        locations = await LocationService.GetAll();
        plantInfoList = await PlantInfoService.GetAll();

        // Load the plant being edited
        plant = await PlantService.GetPlant(id);

        // Optional: ensure "Undecided" (LocationId = 1) appears first
        locations = locations.OrderBy(l => l.LocationId != 1).ToList();

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("returnUrl", out var url))
            returnUrl = url!;

    }

    async Task HandleSubmit()
    {
        await PlantService.Update(plant);

        if (!string.IsNullOrWhiteSpace(returnUrl))
            Nav.NavigateTo(returnUrl!);
        else
            Nav.NavigateTo("/plants");
    }

    void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(returnUrl))
            Nav.NavigateTo(returnUrl!);
        else
            Nav.NavigateTo("/plants");
    }

    bool isDeleted = false;

    async Task DeletePlant()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Are you sure you want to delete '{plant?.Name}'?");

        if (!confirmed)
            return;

        await PlantService.Delete(id);
        await Session.TriggerChange();

        isDeleted = true;

        Nav.NavigateTo($"/location-profile/{plant.LocationId}", forceLoad: true);
    }


}
