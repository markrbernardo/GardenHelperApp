@page "/plants/edit/{Id:int}"

@inject PlantService PlantService
@inject LocationService LocationService
@inject PlantInformationService PlantInfoService
@inject NavigationManager Nav
@inject UserSessionService Session
@inject IJSRuntime JS

<PageHeader Title="Edit Plant" />

<div class="page-section">

    @if (Plant == null || Locations == null || PlantInfoList == null)
    {
        <LoadingSpinner Message="Loading plant..." />
    }
    else if (IsDeleted)
    {
        <LoadingSpinner Message="Deleting..." />
    }
    else
    {
        <PlantForm Plant="Plant"
                   Locations="Locations"
                   PlantInfoList="PlantInfoList"
                   SubmitLabel="Save"
                   OnSubmitCallback="HandleSubmitAsync"
                   OnCancelCallback="GoBack"
                   OnDeleteCallback="DeletePlantAsync"
                   ShowDelete="true"
                   IsDisabled="IsDeleted" />
    }

</div>

@code {
    [Parameter] public int Id { get; set; }

    private PlantModel? Plant;
    private List<LocationModel>? Locations;
    private List<PlantInformationModel>? PlantInfoList;

    private string? ReturnUrl;
    private bool IsDeleted = false;

    protected override async Task OnInitializedAsync()
    {
        // Load plant
        Plant = await PlantService.GetAsync(Id);

        if (Plant == null)
        {
            Nav.NavigateTo("/not-found");
            return;
        }

        // Load locations for the plant's garden
        Locations = await LocationService.GetByGardenAsync(Plant.GardenId);

        // Load plant info list
        PlantInfoList = await PlantInfoService.GetAllAsync();

        // Parse returnUrl
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("returnUrl", out var url))
            ReturnUrl = url!;
    }

    private async Task HandleSubmitAsync()
    {
        await PlantService.UpdateAsync(Plant!);

        if (!string.IsNullOrWhiteSpace(ReturnUrl))
            Nav.NavigateTo(ReturnUrl);
        else
            Nav.NavigateTo("/plants");
    }

    private void GoBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
            Nav.NavigateTo(ReturnUrl);
        else
            Nav.NavigateTo("/plants");
    }

    private async Task DeletePlantAsync()
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to delete '{Plant?.Name}'?"
        );

        if (!confirmed)
            return;

        await PlantService.DeleteAsync(Id);

        // Refresh session (NavMenu, etc.)
        await Session.InitializeAsync();

        IsDeleted = true;

        Nav.NavigateTo($"/location-profile/{Plant!.LocationId}", forceLoad: true);
    }
}
